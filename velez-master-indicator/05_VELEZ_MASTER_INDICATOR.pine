// ═══════════════════════════════════════════════════════════════════════════════════════════════
//  VELEZ METHOD MASTER INDICATOR  ·  Unofficial study tool  ·  build velez-map/1.0.0
// ═══════════════════════════════════════════════════════════════════════════════════════════════
//
//  WHAT THIS IS
//  ------------
//  An INDICATOR (not a strategy) that renders a state -> position -> event workspace derived from
//  a third-party field manual titled "The Velez Method" (71 pages), which reorganises eight public
//  video lessons attributed to Oliver Velez.
//
//  WHAT THIS IS NOT
//  ----------------
//  * NOT official, endorsed by, affiliated with, or authorised by Oliver Velez or any related
//    entity. No proprietary logo, artwork or branding is used.
//  * NOT a strategy, backtest, broker simulator, order router or execution engine. There are no
//    fills, no size, no position and no P&L. What it draws is a VIRTUAL METHODOLOGY LIFECYCLE.
//  * NOT a claim of accuracy, profitability, win rate or performance. Every percentage in the
//    source manual is self-reported by its subject, unpublished, and carries no stated sample,
//    date range or instrument set. None are used as outputs, score weights or defaults.
//  * NOT a faithful mechanisation of the method. The source states its own definitions are
//    deliberately loose and instructs the reader to "eyeball it rather than measure". EVERY
//    numeric threshold here is an ADDITION by this implementation, marked "~" on the chart.
//  * NOT investment advice.
//
//  TRACEABILITY
//  ------------
//      [RULE-### | CON-### | SRC-### p.N | SOURCE-CLASS / IMPLEMENTATION-CLASS]
//  Source classes: DIRECT | IMPLIED | SUBJECTIVE | UNSUPPORTED
//  Impl classes:   EXACT_TRANSLATION | PROGRAMMABLE_APPROXIMATION | EXPERIMENTAL |
//                  PLATFORM_SAFEGUARD | DOCUMENTATION_ONLY | NOT_IMPLEMENTED
//
//  COMPANION DOCUMENTS — read before relying on anything here
//      01_MASTER_RULEBOOK.md         evidence ledger, page coverage, claims boundary
//      02_CONCEPT_TO_CODE_MAP.md     per-concept disposition + approximation worksheets W1..W23
//      03_VISUAL_DESIGN_SPEC.md      display modes, anti-clutter heuristic
//      04_INDICATOR_ARCHITECTURE.md  modules, repaint policy, same-bar policy, resource budget
//      06_RULE_COVERAGE_AUDIT.md     forward + reverse traceability
//      07_QA_REVIEW.md               QA passes, limitations, verification status
//
//  VERIFICATION STATUS: static review completed. TradingView compilation and live-chart
//  verification were NOT performed in the authoring environment. See 07_QA_REVIEW.md §5.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

//@version=6
indicator(
     title            = "Velez Method Master Indicator (Unofficial Study Tool)",
     shorttitle       = "VELEZ MAP",
     overlay          = true,
     max_labels_count = 500,
     max_lines_count  = 500,
     max_boxes_count  = 500,
     max_bars_back    = 5000)


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §00  CONSTANT FAMILIES AND USER-DEFINED TYPES
//      [RULE-001 | PLATFORM_SAFEGUARD PS-12]
//      Named int constants stand in for the `enum` keyword: no Pine compiler was available in the
//      authoring environment, and const-int families carry zero compile risk while giving the same
//      readability and the same exhaustive-switch discipline.
//      See 04_INDICATOR_ARCHITECTURE.md §3.1.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

const int ST_NARROW  = 0
const int ST_REGULAR = 1
const int ST_WIDE    = 2

const int NG_NONE = 0
const int NG_G1   = 1
const int NG_G2   = 2
const int NG_G3   = 3

const int DIR_NONE  =  0
const int DIR_LONG  =  1
const int DIR_SHORT = -1

const int EV_NONE     = 0
const int EV_TAKEOUT  = 1
const int EV_COLOUR   = 2
const int EV_TAIL     = 3
const int EV_ELEPHANT = 4
const int EV_COMBO    = 5

const int SM_NONE     = 0
const int SM_INITIAL  = 1
const int SM_PIVOT    = 2
const int SM_FATBAR   = 3
const int SM_COLOUR   = 4
const int SM_MA20     = 5
const int SM_MA8      = 6
const int SM_BARBYBAR = 7

const int LC_IDLE         = 0
const int LC_WATCHING     = 1
const int LC_DEVELOPING   = 2
const int LC_QUALIFIED    = 3
const int LC_LONG_ACTIVE  = 4
const int LC_SHORT_ACTIVE = 5
const int LC_EXIT_CONTEXT = 6
const int LC_INVALIDATED  = 7
const int LC_COMPLETED    = 8

const int FID_STRICT       = 0
const int FID_APPROX       = 1
const int FID_EXPERIMENTAL = 2

const int MODE_CLEAN    = 0
const int MODE_ANALYSIS = 1
const int MODE_FULL     = 2
const int MODE_DEBUG    = 3

// Blocker bitmask
const int BLK_NO_EVENT      = 1
const int BLK_INSIDE_STATE  = 2
const int BLK_PLUTO         = 4
const int BLK_AGAINST_20    = 8
const int BLK_DUMB_STOP     = 16
const int BLK_LADDER_SKIP   = 32
const int BLK_THREE_FINGERS = 64
const int BLK_LIFECYCLE     = 128
const int BLK_WARMUP        = 256
const int BLK_HTF_OPPOSED   = 512
const int BLK_CONFLICT      = 1024

// ── Named internal constants ──────────────────────────────────────────────────────────────────
// Every behavioural number in this script is either an input, a source-backed level, or one of
// the named constants below. There are no unexplained magic numbers in executable code; the
// remaining literals are rendering values (transparencies, table row indices) enumerated in
// 06_RULE_COVERAGE_AUDIT.md §3.

// Sentinels — chosen so a missing value fails CLOSED (the condition evaluates to false).
const float SENTINEL_BIG   = 99.0      // "not a reset": any value far above resetDrift's max (10)
const int   SENTINEL_BARS  = 999999    // "never occurred" for ta.barssince

// Snowman diagnostic (CON-033 | SRC-097 p.12). Debug-only; emits no signal, so these are
// deliberately fixed rather than exposed as inputs — they describe the source's counterexample
// ("MOST of the bar is body" + a visible wick), not a tunable detector.
const float SNOWMAN_MIN_BODY = 0.5     // body dominates the range
const float SNOWMAN_MIN_WICK = 0.15    // but a wick is visible enough to be mistaken for a tail

// Anti-clutter R5 (03_VISUAL_DESIGN_SPEC.md §6): alternating far-offset multiplier.
const float ALT_OFFSET_MULT = 1.8

// EXPERIMENTAL percentile buckets for CON-130. Symmetric quartile split; NOT from the source.
const float EXP_NARROW_PCT = 25.0
const float EXP_WIDE_PCT   = 75.0
const int   EXP_DENSITY_LEN = 20       // rolling window for the experimental density meter

// Retracement percentages — SOURCE-BACKED levels (SRC-216 p.46). The LEVELS are the source's;
// the hit rates it attaches to them are quoted, never asserted.
const float RET_25 = 0.25
const float RET_50 = 0.50
const float RET_75 = 0.75

// Drawing-object caps (04_INDICATOR_ARCHITECTURE.md §10.3)
const int CAP_EV_LABEL  = 120
const int CAP_EV_LINE   = 60
const int CAP_LC_LABEL  = 30
const int CAP_CTX_BOX   = 60
const int CAP_CTX_LINE  = 20
const int CAP_CTX_LABEL = 20

// Input-group labels
const string G_GEN   = "1 · GENERAL"
const string G_FID   = "2 · SOURCE FIDELITY"
const string G_MODE  = "3 · DISPLAY MODE"
const string G_MA    = "4 · MOVING AVERAGES"
const string G_STATE = "5 · MARKET STATE"
const string G_POS   = "6 · POSITION"
const string G_ELE   = "7 · ELEPHANT BARS"
const string G_TAIL  = "8 · TAIL BARS"
const string G_CC    = "9 · COLOUR CHANGES"
const string G_GAP   = "10 · GAPS"
const string G_SETUP = "11 · SPECIALISED SETUPS"
const string G_ENTRY = "12 · ENTRY SIGNALS"
const string G_TRADE = "13 · TRADE MANAGEMENT"
const string G_PROF  = "14 · PROFIT MANAGEMENT"
const string G_VIS   = "15 · VISUALS"
const string G_DASH  = "16 · DASHBOARD"
const string G_ALERT = "17 · ALERTS"
const string G_ADV   = "18 · ADVANCED"
const string G_DBG   = "19 · DEBUG"

// Tooltip provenance prefixes — every threshold input declares where its default came from.
const string TT_APPROX = "[APPROXIMATION — this number is ADDED by this implementation. The " +
     "source gives no value and explicitly instructs the reader to judge by eye rather than " +
     "measure. See 02_CONCEPT_TO_CODE_MAP.md §11.] "
const string TT_SRC  = "[SOURCE-BACKED — stated in the source. See 01_MASTER_RULEBOOK.md.] "
const string TT_PLAT = "[PLATFORM — a Pine/TradingView reliability decision, not methodology.] "
const string TT_EXP  = "[EXPERIMENTAL — NOT from the source. Exploration only. Off by default, " +
     "and inert unless the fidelity layer is set to 'Include experimental modules'.] "

// One qualified event candidate on one bar.  [RULE-064 | same-bar policy S5]
type EventCandidate
    int    rank     = 0
    int    dir      = 0
    float  refLevel = na
    string lbl      = ""
    bool   approx   = false

// The virtual methodology lifecycle. Never a real position.  [RULE-170 | CON-110]
type Lifecycle
    int    state       = 0
    int    dir         = 0
    int    entryBar    = 0
    float  entryRef    = na
    float  initStop    = na
    float  stop        = na
    int    stopMethod  = 0
    int    adds        = 0
    int    pushes      = 0
    int    entryState  = 1
    bool   isOpening   = false
    float  initPeak    = na
    bool   initDone    = false
    float  lastPushExt = na
    string exitReason  = ""


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §01  INPUTS
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// ── 1 · GENERAL ───────────────────────────────────────────────────────────────────────────────
useEmoji = input.bool(false, "Use symbol glyphs (off = ASCII only)", group = G_GEN,
     tooltip = TT_PLAT + "No meaning is ever carried by a glyph alone; ASCII fallbacks convey " +
     "the same information. The '~' approximation marker is always ASCII.")
cbSafe = input.bool(false, "Colour-blind-safe accents", group = G_GEN,
     tooltip = TT_PLAT + "Substitutes blue/orange for the INDICATOR's accents. Candle colours " +
     "are untouched, because the method reads bar colour directly (SRC-102).")
tickMult = input.int(1, "Tick multiplier for 'one penny' offsets", minval = 1, maxval = 100,
     group = G_GEN,
     tooltip = TT_PLAT + "The source says 'one penny' (SRC-106/132/155). That is an " +
     "instrument-specific increment; this script uses syminfo.mintick x this multiplier.")

// ── 2 · SOURCE FIDELITY ───────────────────────────────────────────────────────────────────────
fidSel = input.string("Source + documented approximations", "Fidelity layer",
     options = ["Strict source mechanics only", "Source + documented approximations",
                "Include experimental modules"], group = G_FID,
     tooltip = "STRICT: only events whose TRIGGER is fully specified by the source may open a " +
     "lifecycle (colour change, red/green bar takeout, strict tail bar, the opening-bell " +
     "sequence). State and position are computed and displayed but do NOT gate signals, because " +
     "gating requires a threshold the source refuses to supply. Consequence: noisier in raw " +
     "events, but free of invented gating.\n\n" +
     "SOURCE + APPROXIMATIONS (default): the full state->position->event funnel. Quieter and " +
     "closer to the method's intent, but depends on added thresholds.\n\n" +
     "EXPERIMENTAL: additionally enables the clearly non-source modules in group 18. " +
     "Those modules are individually off by default as well.")
showApproxMarks = input.bool(true, "Show '~' approximation marker", group = G_FID,
     tooltip = TT_PLAT + "Strongly recommended. Marks every value depending on a threshold this " +
     "implementation added rather than took from the source.")
enforce20Dir = input.bool(true, "Enforce: never trade against the 20's direction", group = G_FID,
     tooltip = TT_SRC + "SRC-224 p.43 (C7 / V5.4). The source calls this the single most " +
     "consequential rule in the material. Separating rising/declining from flat needs a slope " +
     "threshold, which is an approximation.")
enforceDumbStop = input.bool(true, "Enforce: the stop must sit outside the state", group = G_FID,
     tooltip = TT_SRC + "SRC-077 p.11,55 (C14 / V8.4) — 'the dumb stop'. The opening-bell method " +
     "is the source's own explicitly named exception (SRC-078 p.11) and bypasses this gate.")

// ── 3 · DISPLAY MODE ──────────────────────────────────────────────────────────────────────────
modeSel = input.string("Clean", "Display mode",
     options = ["Clean", "Analysis", "Full Velez", "Debug"], group = G_MODE,
     tooltip = "Display modes change VISIBILITY AND DENSITY ONLY. They never change which " +
     "signals exist, when they fire, or what the alerts do. Only the fidelity layer does that.")
historyCap = input.int(300, "Recent-history cap (bars)", minval = 50, maxval = 1000, group = G_MODE,
     tooltip = TT_PLAT + "Full Velez Mode renders events within this bounded window only. " +
     "Unbounded historical rendering is NOT possible: Pine caps labels, lines and boxes at 500 " +
     "each.")
minLabelGap = input.int(3, "Minimum bars between same-family labels", minval = 0, maxval = 50,
     group = G_MODE, tooltip = TT_PLAT + "Anti-clutter heuristic R3. Clean Mode forces 8.")
labelOffAtr = input.float(0.5, "Label offset (ATR units)", minval = 0.0, maxval = 5.0, step = 0.1,
     group = G_MODE,
     tooltip = TT_PLAT + "Offsets scale with volatility, not with zoom. NOTE: Pine has no access " +
     "to rendered pixel geometry, so non-overlapping labels CANNOT be guaranteed — only made rare.")

// ── 4 · MOVING AVERAGES ───────────────────────────────────────────────────────────────────────
len20 = input.int(20, "Short SMA length", minval = 2, maxval = 400, group = G_MA,
     tooltip = TT_SRC + "SRC-030/031 p.6 (C4). The source fixes this at 20, SIMPLE, on CLOSE. " +
     "Changing it departs from the method.")
len200 = input.int(200, "Long SMA length", minval = 20, maxval = 1000, group = G_MA,
     tooltip = TT_SRC + "SRC-030/031 p.6 (C4). Fixed at 200, simple, on close.")
len8 = input.int(8, "Situational trail SMA length", minval = 2, maxval = 100, group = G_MA,
     tooltip = TT_SRC + "SRC-033 p.6,29 (C4 / V2.2). The 8 is a TRAILING tool only, never an " +
     "entry tool, and appears only when price outruns the 20.")
bandMult = input.float(0.25, "MA band half-width (ATR units)", minval = 0.0, maxval = 3.0,
     step = 0.05, group = G_MA,
     tooltip = TT_APPROX + "The CONCEPT is source-backed and stated twice (SRC-042 p.7; SRC-003 " +
     "p.2): an average is a zone and a small penetration is 'a lean, not a break'. The WIDTH is " +
     "never given by anyone. Worksheet W3.")
showBands = input.bool(true, "Show MA bands", group = G_MA)
showMa8   = input.bool(true, "Show the 8 SMA while escalated", group = G_MA)

// ── 5 · MARKET STATE ──────────────────────────────────────────────────────────────────────────
stateBasisSel = input.string("ATR", "State / position measurement basis",
     options = ["ATR", "% of price"], group = G_STATE, tooltip = TT_APPROX + "Worksheet W1.")
narrowMult = input.float(1.0, "Narrow threshold (20/200 gap)", minval = 0.05, maxval = 20.0,
     step = 0.05, group = G_STATE,
     tooltip = TT_APPROX + "SRC-051 p.8,54: 'Are the 20 and the 200 relatively close together? " +
     "... an EYEBALL judgement' and 'Do not get a geometric tool out to measure the gap.' The " +
     "source does not merely omit a threshold — it instructs against creating one. W1.")
wideMult = input.float(3.0, "Wide threshold (20/200 gap)", minval = 0.1, maxval = 50.0, step = 0.1,
     group = G_STATE, tooltip = TT_APPROX + "SRC-060 p.9. Worksheet W1.")
mergeMult = input.float(0.5, "Merge threshold (20/200 pressed together)", minval = 0.01,
     maxval = 10.0, step = 0.05, group = G_STATE,
     tooltip = TT_APPROX + "SRC-198 p.39 (V4.6) — 'the 20 and the 200 converging tightly " +
     "together'. Tightness never quantified.")
slopeLen = input.int(10, "Slope / flatness lookback (bars)", minval = 2, maxval = 200,
     group = G_STATE, tooltip = TT_APPROX + "Worksheet W2.")
flatThresh = input.float(0.05, "Flat threshold (ATR per bar)", minval = 0.0, maxval = 2.0,
     step = 0.01, group = G_STATE,
     tooltip = TT_APPROX + "SRC-035/055. 'Flat' is never defined numerically. The source's one " +
     "quantitative hint — 'ideally near 45 degrees' — is a chart-RENDERING artefact, not a " +
     "property of the data, and is therefore deliberately NOT used here. Worksheet W2.")
sleepyBars = input.int(10, "Sleepy-state confirmation bars", minval = 2, maxval = 100,
     group = G_STATE,
     tooltip = TT_APPROX + "SRC-207 p.33 (V3.4) — 'All three items flat and sideways at the same " +
     "time ... NOT TWO OF THREE.' Duration never given.")

// ── 6 · POSITION ──────────────────────────────────────────────────────────────────────────────
posBasisSel = input.string("ATR", "Position band basis", options = ["ATR", "State width"],
     group = G_POS,
     tooltip = TT_APPROX + "Worksheet W4. 'State width' scales position with the state that " +
     "produced it, but degenerates in very tight states — the HIGHEST-quality states — where " +
     "position one would collapse to a sliver, inverting the source's intent.")
p1Max = input.float(1.0, "Position 1 outer edge (from the state edge)", minval = 0.05,
     maxval = 20.0, step = 0.05, group = G_POS,
     tooltip = TT_APPROX + "SRC-071 p.10. The ladder STRUCTURE is direct; the boundaries are only " +
     "ever 'immediately above', 'not close not far', 'wide'. Worksheet W4.")
p2Max = input.float(2.5, "Position 2 outer edge (from the state edge)", minval = 0.1, maxval = 50.0,
     step = 0.1, group = G_POS, tooltip = TT_APPROX + "Worksheet W4.")
boxGapMult = input.float(1.5, "Box: maximum 20/200 gap", minval = 0.05, maxval = 20.0, step = 0.05,
     group = G_POS, tooltip = TT_APPROX + "SRC-209 p.34-35 (V3.7).")
boxPriceMult = input.float(1.0, "Box: maximum price distance from the 20", minval = 0.05,
     maxval = 20.0, step = 0.05, group = G_POS, tooltip = TT_APPROX + "SRC-209 p.34-35 (V3.7).")
zoneBoxBars = input.int(30, "Position zone box width (bars)", minval = 5, maxval = 300,
     group = G_POS, tooltip = TT_PLAT + "Zone boxes are anchored at the right edge only.")

// ── 7 · ELEPHANT BARS ─────────────────────────────────────────────────────────────────────────
eleModelSel = input.string("Average multiple", "Elephant model",
     options = ["Average multiple", "Local maximum"], group = G_ELE,
     tooltip = TT_APPROX + "Worksheet W5. 'Local maximum' is the more literal reading of 'larger " +
     "than the bars around it' but has no absolute floor, so on its own it would label the " +
     "biggest bar of a dead range an institutional footprint — contradicting the source's own " +
     "rationale (SRC-093). A 1 x ATR floor is applied in that mode.")
eleLookback = input.int(10, "Elephant neighbourhood (bars)", minval = 2, maxval = 100, group = G_ELE,
     tooltip = TT_APPROX + "SRC-092 p.12 — 'the bars around it' gives no count.")
eleRangeMult = input.float(1.8, "Elephant range multiple", minval = 1.0, maxval = 10.0, step = 0.1,
     group = G_ELE,
     tooltip = TT_APPROX + "SRC-092 p.12 — 'A bar VISIBLY LARGER and taller than the bars around " +
     "it.' No ratio is given anywhere in the source. Worksheet W5.")
eleBodyFrac = input.float(0.5, "Elephant minimum body fraction", minval = 0.0, maxval = 1.0,
     step = 0.05, group = G_ELE,
     tooltip = TT_APPROX + "SEMI-ANCHORED: the source says 'large-bodied' (SRC-191 p.37) and its " +
     "diagram shows solid bodies (SRC-109 p.12). Without this, a wide-range doji — the opposite " +
     "of a conviction bar — would qualify.")
exhaustLegs = input.int(3, "Legs before an elephant reads as exhaustion", minval = 1, maxval = 10,
     group = G_ELE,
     tooltip = TT_APPROX + "ANCHORED to SRC-265 p.20 — 'the market tends to pause, rest or " +
     "reverse after THREE TO FIVE pushes ... three happens more often'. NOTE the source's own " +
     "illustration of an exhaustion elephant says 'five legs into the move' (p.26), so 3 is the " +
     "more conservative, earlier-warning choice. Worksheet W18.")
emergenceLb = input.int(20, "Emergence lookback for 'igniting' (bars)", minval = 2, maxval = 200,
     group = G_ELE, tooltip = TT_APPROX + "Worksheet W18.")

// ── 8 · TAIL BARS ─────────────────────────────────────────────────────────────────────────────
tailMinFrac = input.float(0.50, "Tail minimum fraction of range", minval = 0.2, maxval = 0.95,
     step = 0.01, group = G_TAIL,
     tooltip = TT_APPROX + "SEMI-ANCHORED: SRC-096 p.12 says 'MOST of the bar must be tail', " +
     "which carries a defensible literal reading of more than half. The exact ratio is not given. " +
     "Worksheet W6.")
tailBodyMax = input.float(0.35, "Tail maximum body fraction", minval = 0.05, maxval = 0.8,
     step = 0.01, group = G_TAIL,
     tooltip = TT_APPROX + "SRC-096 p.12 — 'The body is the SMALL part.' No ratio given. W6.")
tailDominance = input.bool(true, "Signal tail must exceed the opposite tail", group = G_TAIL,
     tooltip = TT_APPROX + "Without this a long-legged doji with two large tails qualifies. That " +
     "is a balance bar, not the rejection bar the source describes.")
showSnowman = input.bool(true, "Show snowman (not-a-tail) diagnostics in Debug", group = G_TAIL,
     tooltip = TT_SRC + "SRC-097 p.12 — the source names the counterfeit explicitly and says 'it " +
     "does not count'. Debug Mode only, so the boundary stays inspectable.")

// ── 9 · COLOUR CHANGES ────────────────────────────────────────────────────────────────────────
ccRefSel = input.string("Nearest opposite bar", "Colour-change reference",
     options = ["Nearest opposite bar", "Opposite-run extreme"], group = G_CC,
     tooltip = TT_APPROX + "SRC-104 p.13 says 'the first green bar that takes out A red high' " +
     "without saying WHICH red when several print. 'Nearest' is the level taken out first, so it " +
     "satisfies 'first' for the widest range of chart shapes; 'run extreme' is stricter. W17.")
ccRequireColour = input.bool(true, "Trigger bar must be the opposite colour", group = G_CC,
     tooltip = TT_SRC + "SRC-102 p.13 — 'GREEN trades above the high of a red bar'.")
showCcLine = input.bool(true, "Draw the colour-change reference line", group = G_CC,
     tooltip = TT_SRC + "SRC-105 p.13 — 'IGNORE THE TAILS. Use the BODY of the red bar when " +
     "marking the level.' The line shows the body extreme, which is the detail the source says " +
     "people get wrong.")

// ── 10 · GAPS ─────────────────────────────────────────────────────────────────────────────────
enableGapFill = input.bool(true, "Enable the gap-fill technique", group = G_GAP,
     tooltip = TT_SRC + "SRC-120 p.13,30 (C19 / V2.7). Requires session information; disables " +
     "itself automatically on symbols and timeframes without a regular session.")
gapMinAtr = input.float(0.25, "Minimum gap size (ATR units)", minval = 0.0, maxval = 10.0,
     step = 0.05, group = G_GAP, tooltip = TT_APPROX + "The source gives no minimum gap size.")

// ── 11 · SPECIALISED SETUPS ───────────────────────────────────────────────────────────────────
enSurge    = input.bool(true, "Surge off the 200 (V4)",                    group = G_SETUP)
enSwing    = input.bool(true, "Igniting / pullback swings (V3)",           group = G_SETUP)
enOpening  = input.bool(true, "Opening-bell sequence (V7)",                group = G_SETUP)
enHidden   = input.bool(true, "Hidden green / hidden red (V7, V8)",        group = G_SETUP)
enDual     = input.bool(true, "Dual space reversal (V6)",                  group = G_SETUP)
enRetrace  = input.bool(true, "Retracement ladder + scalp/trade (V6)",     group = G_SETUP)
enReversal = input.bool(true, "Deep drop / Market Law Four warnings (V1)", group = G_SETUP)
clearLb = input.int(20, "Clear-space lookback (bars)", minval = 3, maxval = 300, group = G_SETUP,
     tooltip = TT_APPROX + "SRC-192 p.37 — 'No significant price data IMMEDIATELY to the left ... " +
     "He acknowledges that going back far enough always finds something. He means THE RECENT " +
     "PAST.' TIMEFRAME-SENSITIVE: 20 bars on a monthly chart is 20 months. Worksheet W8.")
originTolBars = input.int(2, "Surge origin tolerance (bars from the 200)", minval = 0, maxval = 20,
     group = G_SETUP,
     tooltip = TT_SRC + "ANCHORED (W20): SRC-195 p.38 — 'The move can start A BAR OR TWO away from the " +
     "200 and still qualify.' One of the few counts the source actually supplies.")
resetBars = input.int(3, "Reset / pause length (bars)", minval = 2, maxval = 30, group = G_SETUP,
