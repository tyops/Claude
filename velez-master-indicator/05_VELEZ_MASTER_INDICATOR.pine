// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §02  RESOLVED SELECTORS
// ═══════════════════════════════════════════════════════════════════════════════════════════════

int fidelity = switch fidSel
    "Strict source mechanics only"       => FID_STRICT
    "Source + documented approximations" => FID_APPROX
    => FID_EXPERIMENTAL

int mode = switch modeSel
    "Clean"      => MODE_CLEAN
    "Analysis"   => MODE_ANALYSIS
    "Full Velez" => MODE_FULL
    => MODE_DEBUG

bool useAtrBasis  = stateBasisSel == "ATR"
bool useAtrPos    = posBasisSel   == "ATR"
bool eleAvgModel  = eleModelSel   == "Average multiple"
bool ccNearest    = ccRefSel      == "Nearest opposite bar"
bool near20Atr    = near20Sel     == "ATR distance"
bool alertConfirmedOnly = alertModeSel == "Confirmed (bar close)"

bool expOn    = fidelity == FID_EXPERIMENTAL
bool strictOn = fidelity == FID_STRICT

// Experimental modules are inert unless BOTH the fidelity layer and the module toggle are on.
bool expStateActive   = expOn and expStateOn
bool expDensityActive = expOn and expDensityOn
bool expHtfGateActive = expOn and expHtfGateOn and useHtf

// Anti-clutter spacing tightens in denser modes (03_VISUAL_DESIGN_SPEC.md §6 R3/R6).
int labelGap = mode == MODE_CLEAN ? math.max(minLabelGap, 8) : minLabelGap

bool modeClean    = mode == MODE_CLEAN
bool modeAnalysis = mode >= MODE_ANALYSIS
bool modeFull     = mode >= MODE_FULL
bool modeDebug    = mode == MODE_DEBUG


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §03  PURE HELPER FUNCTIONS
//      [RULE-002 | PLATFORM_SAFEGUARD] Declared before first use; Pine has no forward references.
//      None of these mutate global state — Pine functions cannot assign to globals.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Safe division: returns na rather than erroring or producing an infinity.
safeDiv(float n, float d) =>
    na(d) or d == 0 ? float(na) : n / d

// The approximation marker. ALWAYS ASCII — never an emoji, never colour-only.
aMark(bool isApprox) =>
    isApprox and showApproxMarks ? " ~" : ""

// Confirmed-later marker (pivot-derived objects).
cMark() =>
    useEmoji ? " ⌛" : " [c]"

// Virtual-lifecycle marker.
vMark() =>
    useEmoji ? " ⟨v⟩" : " (v)"

// Rising edge. Called only from unconditional global scope, so per-call-site history is stable.
rise(bool b) =>
    b and not b[1]

// Bit test on the blocker mask, using modulo (Pine integer division semantics are avoided).
hasBit(int mask, int bit) =>
    (mask % (bit * 2)) >= bit

// Rotate a protective stop and report which method produced it.
// Monotonic in the protective direction: the stop NEVER loosens.
// [RULE-140 | CON-088 | SRC-148 p.14,35 | DIRECT / EXACT_TRANSLATION]
applyStop(bool isLong, float cur, int curMethod, float cand, int candMethod) =>
    float outStop   = cur
    int   outMethod = curMethod
    if not na(cand) and (na(cur) or (isLong ? cand > cur : cand < cur))
        outStop   := cand
        outMethod := candMethod
    [outStop, outMethod]

stateName(int s) =>
    s == ST_NARROW ? "NARROW" : s == ST_REGULAR ? "REGULAR" : "WIDE"

gradeName(int g) =>
    g == NG_G1 ? "G1" : g == NG_G2 ? "G2" : g == NG_G3 ? "G3" : ""

stopMethodName(int m) =>
    switch m
        SM_INITIAL  => "INITIAL"
        SM_PIVOT    => "PIVOT"
        SM_FATBAR   => "FAT BAR"
        SM_COLOUR   => "COLOUR ADJUST"
        SM_MA20     => "20 MA"
        SM_MA8      => "8 MA"
        SM_BARBYBAR => "BAR-BY-BAR"
        => "-"

lcName(int s) =>
    switch s
        LC_IDLE         => "IDLE"
        LC_WATCHING     => "WATCHING"
        LC_DEVELOPING   => "DEVELOPING"
        LC_QUALIFIED    => "QUALIFIED"
        LC_LONG_ACTIVE  => "VIRTUAL LONG ACTIVE"
        LC_SHORT_ACTIVE => "VIRTUAL SHORT ACTIVE"
        LC_EXIT_CONTEXT => "EXIT CONTEXT"
        LC_INVALIDATED  => "INVALIDATED"
        => "COMPLETED"

// Confluence tier. [RULE-120 | CON-111 | IMPLEMENTATION-DEFINED — NOT a Velez taxonomy]
tierName(int s) =>
    s >= 13 ? "ELITE SETUP" : s >= 10 ? "HIGH QUALITY" : s >= 7 ? "SETUP" :
     s >= 4 ? "DEVELOPING" : s >= 1 ? "WATCH" : "-"

tierPips(int s) =>
    s >= 13 ? "·····" : s >= 10 ? "····" : s >= 7 ? "···" : s >= 4 ? "··" : s >= 1 ? "·" : ""

// Bounded ring-buffer trimming. Returns the number trimmed so the caller can accumulate it —
// Pine functions cannot assign to globals. [RULE-208 | CON-119 | PLATFORM_SAFEGUARD PS-09]
trimLabels(array<label> a, int cap) =>
    int n = 0
    if array.size(a) > cap
        for i = 0 to array.size(a) - cap - 1
            label.delete(array.shift(a))
            n += 1
    n

trimLines(array<line> a, int cap) =>
    int n = 0
    if array.size(a) > cap
        for i = 0 to array.size(a) - cap - 1
            line.delete(array.shift(a))
            n += 1
    n

trimBoxes(array<box> a, int cap) =>
    int n = 0
    if array.size(a) > cap
        for i = 0 to array.size(a) - cap - 1
            box.delete(array.shift(a))
            n += 1
    n


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §04  GUARDS AND BASE DATA
//      [RULE-003..008 | CON-116/117 | PLATFORM_SAFEGUARD]
//      Every guard produces a VISIBLE degraded state, never a silent one.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

float tick = syminfo.mintick * tickMult

// [RULE-003 | CON-116 | PLATFORM_SAFEGUARD PS-10]
// Heikin Ashi, Renko, Kagi, Point & Figure, Line Break and Range bars synthesise OHLC. Every
// event detector here reads real bar geometry (SRC-092, SRC-096, SRC-102), so synthetic bars
// distort them severely. Detection is NOT disabled — the user is informed and left in control.
bool nonStandardChart = not chart.is_standard

// [RULE-004] ATR is the normalisation unit for every distance in this script.
float atrUnit = ta.atr(atrLen)
float pctUnit = close * 0.01
float unitState = useAtrBasis ? atrUnit : pctUnit
bool  atrOk  = not na(atrUnit) and atrUnit > 0
bool  unitOk = not na(unitState) and unitState > 0

// [RULE-005 | CON-117 | PLATFORM_SAFEGUARD PS-08] Explicit, visible warm-up.
// The 200 SMA is the source's non-negotiable second average (SRC-030 p.6), so a chart with fewer
// than 200 bars cannot express the method at all. The dashboard says so rather than showing a
// half-formed picture.
int warmupNeeded = math.max(len200, slopeLen + 1, eleLookback + 1, atrLen + 1, clearLb + 1) + 2 +
     (expStateOn ? expStateLb : 0)
bool ready = bar_index >= warmupNeeded and atrOk and unitOk

// [RULE-006] Bar geometry. Every ratio below is guarded against a zero range (PS-07).
float rng    = high - low
float body   = math.abs(close - open)
float bodyHi = math.max(open, close)
float bodyLo = math.min(open, close)
float upTail = high - bodyHi
float dnTail = bodyLo - low
bool  rngOk  = rng > 0

// [RULE-007 | CON-034 | SRC-102 p.13 | DIRECT / EXACT_TRANSLATION]
// Two colours only. A doji is neither and is excluded as both a reference and a trigger — the
// source never addresses dojis, so this is a platform safeguard (PS-06).
bool isGreen = close > open
bool isRed   = close < open
bool isDoji  = close == open

// [RULE-008 | PLATFORM_SAFEGUARD] Session availability. Opening-bell and gap-fill modules
// disable themselves where no regular session exists (crypto/forex 24h, non-intraday charts).
bool sessionOk  = timeframe.isintraday
bool newSession = sessionOk and session.isfirstbar_regular


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §05  MOVING AVERAGES AND THE STATE ENVELOPE
//      [RULE-009..013 | CON-001/002/003/004 | SRC-030/031/033/042 p.6-7 | DIRECT]
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// [RULE-009 | CON-001/002 | SRC-031 p.6,45 | DIRECT / EXACT_TRANSLATION]
// "Both are simple moving averages calculated on closing prices." Length, type and input series
// are all stated by the source, so this is a complete translation with nothing added.
float sma20  = ta.sma(close, len20)
float sma200 = ta.sma(close, len200)

// [RULE-010 | CON-003 | SRC-033 p.6,29 | DIRECT / EXACT_TRANSLATION]
// The 8 is a situational TRAILING tool, never an entry tool.
float sma8 = ta.sma(close, len8)

// [RULE-011 | CON-004 | SRC-042 p.7 + SRC-003 p.2 | DIRECT concept / PROGRAMMABLE_APPROXIMATION]
// "A small penetration through either average is a lean, not a break ... he would shade a
// coloured band on each side of the line." Concept stated twice; width never given. W3.
float band    = bandMult * atrUnit
float ma20Hi  = sma20  + band
float ma20Lo  = sma20  - band
float ma200Hi = sma200 + band
float ma200Lo = sma200 - band

// [RULE-012] The state envelope: the union of both bands. Position is measured from its edges.
float stateTop = math.max(ma20Hi, ma200Hi)
float stateBot = math.min(ma20Lo, ma200Lo)

// [RULE-013 | CON-010 | SRC-023 p.5 | DIRECT concept / PROGRAMMABLE_APPROXIMATION]
float maGap = math.abs(sma20 - sma200)
float gapN  = nz(safeDiv(maGap, unitState), 0.0)


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §06  SLOPE, FLATNESS AND TREND
//      [RULE-014..017 | CON-005/006/074 | SRC-035/036/040/055/224/225]
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// [RULE-014 | CON-005 | SRC-035/036 p.6-7 | DIRECT concept / PROGRAMMABLE_APPROXIMATION]
// Per-bar slope normalised by the volatility unit. The source's only quantitative hint —
// "ideally near 45 degrees" — is a chart-rendering artefact, not a property of the data, and is
// deliberately NOT used to derive this threshold. Worksheet W2.
slopeN(float s) =>
    nz(safeDiv(s - s[slopeLen], slopeLen * unitState), 0.0)

float slope20  = slopeN(sma20)
float slope200 = slopeN(sma200)
bool  flat20   = math.abs(slope20)  <= flatThresh
bool  flat200  = math.abs(slope200) <= flatThresh

// [RULE-015 | CON-011 | SRC-055 p.9,53 | DIRECT concept / PROGRAMMABLE_APPROXIMATION]
// "the stock itself flat and SANDWICHED BETWEEN THEM" is a containment statement, not a slope
// statement, and is implemented as containment within the current state envelope.
bool priceSandwiched = ta.highest(close, slopeLen) <= stateTop and
                       ta.lowest(close,  slopeLen) >= stateBot

// [RULE-016 | CON-006 | SRC-040 p.7,45 (C7) + SRC-224 p.43 (V5.4) | DIRECT / APPROXIMATION]
// "If the 20 is declining, the trend is down no matter how many green bars print inside it."
int trendDir = slope20 > flatThresh ? DIR_LONG : slope20 < -flatThresh ? DIR_SHORT : DIR_NONE

// [RULE-017 | CON-074 | SRC-225 p.43 | DIRECT / EXACT_TRANSLATION]
// The screening method applied to the charted symbol: rising 20 = long only, declining 20 =
// short only, neither rising nor declining = DISCARD.
bool trendFlat = trendDir == DIR_NONE


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §07  SPACE (PRICE <-> THE 20)
//      [RULE-018..020 | CON-071/073 | SRC-220/221/322 p.41-43,60]
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// [RULE-018 | CON-071 | SRC-322 p.60 | DIRECT / EXACT_TRANSLATION]
// The glossary binds "space" explicitly to price <-> the 20, not price <-> the 200.
float spaceAbs = math.abs(close - sma20)
float spaceN   = nz(safeDiv(spaceAbs, unitState), 0.0)

// [RULE-019 | CON-073 | SRC-221 p.41 | DIRECT concept / PROGRAMMABLE_APPROXIMATION]
// The source judges space against the instrument's OWN history ("larger than any space produced
// in the previous ten years"). Lookback and percentile are additions. Worksheet W14.
float spaceRank    = ta.percentrank(spaceAbs, spaceLookback)
bool  spaceExtreme = not na(spaceRank) and spaceRank >= spacePct

// [RULE-020 | CON-041/044 | SRC-223 p.42 | DIRECT condition / PROGRAMMABLE_APPROXIMATION]
// "A little above, a little below, or right on it are all fine. HE DOES NOT CARE WHICH." W7.
bool near20 = near20Atr ? (spaceN <= near20Mult) : (close <= ma20Hi and close >= ma20Lo)


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §08  SWINGS: PIVOTS AND RESETS
//      [RULE-021..022 | CON-055 | SRC-144/201]
//      REPAINT CLASS: CONFIRMED-LATER. Objects derived from these are drawn ONLY on the
//      confirmation bar and are tagged "[c]". No pivot is ever backdated without that tag.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// [RULE-021 | CON-055 | SRC-144 p.14 | DIRECT concept / PROGRAMMABLE_APPROXIMATION]
// The manual never defines a swing; pivLen has NO source anchor. Worksheet W22.
float pivHiRaw = ta.pivothigh(high, pivLen, pivLen)
float pivLoRaw = ta.pivotlow(low,  pivLen, pivLen)
bool  pivHiConfirmed = not na(pivHiRaw)
bool  pivLoConfirmed = not na(pivLoRaw)

var float lastPivHi    = na
var float prevPivHi    = na
var float lastPivLo    = na
var float prevPivLo    = na
var int   lastPivHiBar = na
var int   lastPivLoBar = na

if pivHiConfirmed
    prevPivHi    := lastPivHi
    lastPivHi    := pivHiRaw
    lastPivHiBar := bar_index - pivLen
if pivLoConfirmed
    prevPivLo    := lastPivLo
    lastPivLo    := pivLoRaw
    lastPivLoBar := bar_index - pivLen

// [RULE-022 | CON-055 | SRC-201 p.38 | DIRECT concept / PROGRAMMABLE_APPROXIMATION]
// "A brief pause acts as a reset ... sideways OR a shallow drift down at roughly 45 degrees. He
// is explicit that BOTH FORMS accomplish the same thing." Net displacement captures both; a
// range test would reject the drifting form the source insists is equivalent. Worksheet W9.
float netDrift = math.abs(close - close[resetBars])
bool  isReset  = ready and nz(safeDiv(netDrift, unitState), SENTINEL_BIG) <= resetDrift


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §09  STATE CLASSIFICATION
//      [RULE-027..034 | CON-010..019 | SRC-050..064]
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// [RULE-027 | CON-010 | SRC-050/051/060 p.8-9 | DIRECT concept / PROGRAMMABLE_APPROXIMATION]
// SRC-051: "Velez is emphatic that this is an EYEBALL judgement and warns against measuring the
// gap with a tool." The source does not merely omit a threshold — it instructs against creating
// one. Every state value rendered therefore carries "~". Worksheet W1.
int stateDefault = not ready ? ST_REGULAR :
     gapN <= narrowMult ? ST_NARROW : gapN >= wideMult ? ST_WIDE : ST_REGULAR

// [RULE-103 | CON-130 | EXPERIMENTAL — NOT FROM THE SOURCE]
// Percentile-rank state model. Known artefact: it guarantees a fixed share of bars land in each
// bucket whether or not any genuinely do. That is exactly why it is experimental, not default.
// ta.* is called UNCONDITIONALLY: calling a series function inside a ternary can desynchronise
// its internal state. Only the USE of the result is gated. (PLATFORM_SAFEGUARD)
float expGapRank = ta.percentrank(gapN, expStateLb)
int   stateExp   = na(expGapRank) ? stateDefault :
     expGapRank <= EXP_NARROW_PCT ? ST_NARROW : expGapRank >= EXP_WIDE_PCT ? ST_WIDE : ST_REGULAR

int state = expStateActive ? stateExp : stateDefault

bool isNarrow  = state == ST_NARROW
bool isRegular = state == ST_REGULAR
bool isWide    = state == ST_WIDE

// [RULE-028 | CON-011/012/013 | SRC-055/056/057 p.9,53 | DIRECT / PROGRAMMABLE_APPROXIMATION]
// The three grades, ranked by the source. G1 requires ALL THREE items flat at once.
int narrowGrade = not isNarrow ? NG_NONE :
     (flat20 and flat200 and priceSandwiched) ? NG_G1 :
     (flat200 and not flat20)                 ? NG_G2 : NG_G3

// [RULE-029 | CON-016 | SRC-207 p.33 | DIRECT / PROGRAMMABLE_APPROXIMATION]
// "All three items flat and sideways at the same time ... NOT TWO OF THREE."
bool sleepyNow = narrowGrade == NG_G1
var int sleepyRun = 0
sleepyRun := sleepyNow ? nz(sleepyRun[1]) + 1 : 0
bool isSleepy = sleepyRun >= sleepyBars

// [RULE-030 | CON-017 | SRC-198 p.39 | DIRECT / PROGRAMMABLE_APPROXIMATION]
bool isMerge = ready and gapN <= mergeMult

// [RULE-031 | CON-010] State transition.
bool stateChanged = ready and state != state[1]

// [RULE-032 | CON-019 | SRC-064 p.48 | DIRECT / EXACT_TRANSLATION]
// "State ... narrow or wide. Location ... above or below." The source draws this distinction
// deliberately and warns the two are conflated. They are separate fields here and on the dashboard.
int location = close > stateTop ? DIR_LONG : close < stateBot ? DIR_SHORT : DIR_NONE

// [RULE-033 | CON-015 | SRC-061/063 p.9,28,54 | DIRECT / EXACT_TRANSLATION]
string modeByState = isNarrow ? "EMERGENCE" : isRegular ? "NEAR THE 20" : "REVERSION"

// [RULE-034 | CON-055] Leg counting, reset on a return to narrow.
var int legCount = 0
if stateChanged and isNarrow
    legCount := 0
if ready and isReset and not isReset[1] and legCount < 20
    legCount := legCount + 1


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §10  POSITION CLASSIFICATION
//      [RULE-035..042 | CON-020..029 | SRC-070..079]
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// [RULE-035 | CON-020 | SRC-070/071 p.10 | DIRECT structure / PROGRAMMABLE_APPROXIMATION]
// Seven positions: three above, three below, and the state itself. The ladder STRUCTURE is
// direct; the boundaries are only ever described in words. Worksheet W4.
float posUnit = useAtrPos ? atrUnit : math.max(maGap, atrUnit * 0.1)
float dUp = nz(safeDiv(close - stateTop, posUnit), 0.0)
float dDn = nz(safeDiv(stateBot - close, posUnit), 0.0)

int pos = not ready ? 0 :
     close > stateTop ? (dUp <= p1Max ? 1 : dUp <= p2Max ? 2 : 3) :
     close < stateBot ? (dDn <= p1Max ? -1 : dDn <= p2Max ? -2 : -3) : 0
int posAbs = math.abs(pos)

// [RULE-036 | CON-022 | SRC-075 p.10 | DIRECT / EXACT_TRANSLATION]
// "The state — Do not trade inside it. Wait for the emergence."
bool insideState = pos == 0

// [RULE-037 | CON-023/025 | SRC-079 p.11 + SRC-284 p.56 | DIRECT / PROGRAMMABLE_APPROXIMATION]
// Pluto land: "the zone far past position one where traders chase bars that have nothing to do
// with the state that produced them. The bar is not the signal. The bar PLUS THE LOCATION is."
bool plutoLand = posAbs == 3

// [RULE-038/039 | CON-026/027 | SRC-209/323 p.34-35,60 | DIRECT / PROGRAMMABLE_APPROXIMATION]
bool inBox        = ready and gapN <= boxGapMult and spaceN <= boxPriceMult
bool threeFingers = ready and gapN >  boxGapMult and spaceN >  boxPriceMult

// [RULE-041] Position path progression 1 -> 2 -> 3 (SRC-129 p.30,55).
var int posPathMax = 0
posPathMax := posAbs > nz(posPathMax[1]) ? posAbs : nz(posPathMax[1])

// [RULE-042 | CON-070 | SRC-239/325 p.25,61 | DIRECT concept / PROGRAMMABLE_APPROXIMATION]
bool ma20Halt = ready and near20 and near20[1] and near20[2] and rngOk and rng <= atrUnit


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §11  PRIMITIVE EVENT DETECTORS
//      [RULE-055..079 | CON-030..039 | SRC-090..109]
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// ── Elephant bar ────────────────────────────────────────────────────────────────────────────
// [RULE-055 | CON-030 | SRC-092 p.12 | DIRECT concept / PROGRAMMABLE_APPROXIMATION]
// "A bar visibly larger and taller than the bars around it, in either colour." No ratio, no
// neighbourhood size, and no separation of range from body is given anywhere. Worksheet W5.
float avgRng = ta.sma(rng, eleLookback)[1]
float maxRng = ta.highest(rng, eleLookback)[1]
bool  bodyOk = rngOk and nz(safeDiv(body, rng), 0.0) >= eleBodyFrac

bool eleSizeOk = eleAvgModel ?
     (not na(avgRng) and avgRng > 0 and rng >= eleRangeMult * avgRng) :
     (not na(maxRng) and rng > maxRng and rng >= atrUnit)

bool isElephant   = ready and rngOk and eleSizeOk and bodyOk
bool elephantBull = isElephant and isGreen
bool elephantBear = isElephant and isRed

// [RULE-056 | CON-031 | SRC-235 p.26 | DIRECT rule / PROGRAMMABLE_APPROXIMATION]
// "Nothing about the candle itself tells you which one you are looking at. Only its LOCATION in
// the trend does." The source's two illustrations differ on THREE dimensions at once — legs,
// what is overhead, and distance from the state — so a single-dimension test would misclassify
// the very examples the manual uses. UNCLASSIFIED is a deliberate, visible third outcome. W18.
bool narrowRecently = nz(ta.barssince(isNarrow), SENTINEL_BARS) <= emergenceLb
bool isExhaustion = isElephant and (legCount >= exhaustLegs or plutoLand or spaceExtreme)
bool isIgniting   = isElephant and not isExhaustion and legCount <= 1 and posAbs <= 2 and
                    narrowRecently

// ── Tail bars ───────────────────────────────────────────────────────────────────────────────
// [RULE-057 | CON-032 | SRC-096/098 p.12 | DIRECT / PROGRAMMABLE_APPROXIMATION on the ratio]
// "MOST of the bar must be tail. The body is the small part. A bar that is mostly body with a
// wick hanging off it is not a tail bar." Worksheet W6.
float tailUpFrac = nz(safeDiv(upTail, rng), 0.0)
float tailDnFrac = nz(safeDiv(dnTail, rng), 0.0)
float bodyFrac   = nz(safeDiv(body,   rng), 1.0)

bool bottomingTail = ready and rngOk and tailDnFrac >= tailMinFrac and bodyFrac <= tailBodyMax and
                     (not tailDominance or dnTail > upTail)
bool toppingTail   = ready and rngOk and tailUpFrac >= tailMinFrac and bodyFrac <= tailBodyMax and
                     (not tailDominance or upTail > dnTail)
bool isTail = bottomingTail or toppingTail

// [RULE-058 | CON-033 | SRC-097 p.12 | DIRECT / EXACT_TRANSLATION]
// The snowman: "a bar with a wick that people mistake for a tail bar. Most of the bar is body,
// so it does not qualify." Debug only — it makes the boundary inspectable rather than invisible.
bool isSnowman = ready and rngOk and bodyFrac > SNOWMAN_MIN_BODY and
                 math.max(tailUpFrac, tailDnFrac) >= SNOWMAN_MIN_WICK

// ── Colour change ───────────────────────────────────────────────────────────────────────────
// [RULE-059 | CON-034 | SRC-102/104/105/106 p.13 | DIRECT / EXACT_TRANSLATION]
// "One colour takes out the high of an opposite-coloured bar next to it ... It does not need to
// be back to back ... IGNORE THE TAILS. USE THE BODY of the red bar when marking the level ...
// The entry price is the takeout price, ONE TICK ABOVE the marked high."
// WHICH opposite bar supplies the level when several print is not stated — Worksheet W17.
var float ccRefHi    = na
var float ccRefLo    = na
var float ccRunHi    = na
var float ccRunLo    = na
var int   ccRefHiBar = na
var int   ccRefLoBar = na

if isRed
    ccRunHi    := (na(ccRunHi) or not isRed[1]) ? bodyHi : math.max(ccRunHi, bodyHi)
    ccRefHi    := ccNearest ? bodyHi : ccRunHi
    ccRefHiBar := bar_index
if isGreen
    ccRunLo    := (na(ccRunLo) or not isGreen[1]) ? bodyLo : math.min(ccRunLo, bodyLo)
    ccRefLo    := ccNearest ? bodyLo : ccRunLo
    ccRefLoBar := bar_index

// [SAME-BAR POLICY S10] The reference used on this bar is the one that existed at the PREVIOUS
// bar's close, so a bar can never take out its own reference.
float ccUseHi = ccRefHi[1]
float ccUseLo = ccRefLo[1]

bool ccBull = ready and not na(ccUseHi) and (not ccRequireColour or isGreen) and not isDoji and
              high >= ccUseHi + tick
bool ccBear = ready and not na(ccUseLo) and (not ccRequireColour or isRed) and not isDoji and
              low  <= ccUseLo - tick
bool isColourChange = ccBull or ccBear

float ccEntryLong  = na(ccUseHi) ? float(na) : ccUseHi + tick
float ccEntryShort = na(ccUseLo) ? float(na) : ccUseLo - tick

// [RULE-060 | CON-035 | SRC-107 p.13,29,55 | DIRECT / EXACT_TRANSLATION]
// "If a single bar is both an elephant bar and a colour change at once, Velez rates it MORE
// POWERFUL than either alone."
bool comboBull = elephantBull and ccBull
bool comboBear = elephantBear and ccBear

// ── Little red / green bar takeout ──────────────────────────────────────────────────────────
// [RULE-061 | CON-036 | SRC-132/133 p.50 | DIRECT / EXACT_TRANSLATION]
// "Watch the very first red bar after entry. If that red bar does not produce a second
// consecutive red, and a green bar then trades one penny above the red bar's high, that is the
// add." SRC-133 promotes it: "the little red bar takeout can be an ENTRY in its own right."
bool takeoutBull = ready and isRed[2]   and not isRed[1]   and isGreen and high >= high[2] + tick
bool takeoutBear = ready and isGreen[2] and not isGreen[1] and isRed   and low  <= low[2]  - tick
bool isTakeout   = takeoutBull or takeoutBear

// ── Gap fill ────────────────────────────────────────────────────────────────────────────────
// [RULE-062 | CON-037 | SRC-120 p.13,30 | DIRECT / EXACT_TRANSLATION]
// "When a stock gaps out of a narrow state, mentally fill the gap in as if price had traded
// through it continuously. That turns the gap itself into the elephant bar one, so the first
// real bar of continued green becomes your bar two trigger."
var bool gapArmedUp = false
var bool gapArmedDn = false
var int  gapBar     = na

float gapUpSize = open - high[1]
float gapDnSize = low[1] - open
bool gapUp = enableGapFill and newSession and ready and gapUpSize > 0 and
             nz(safeDiv(gapUpSize, unitState), 0.0) >= gapMinAtr
bool gapDn = enableGapFill and newSession and ready and gapDnSize > 0 and
             nz(safeDiv(gapDnSize, unitState), 0.0) >= gapMinAtr

// [RULE-063 | CON-038 | SRC-121 p.13,52 | DIRECT / EXACT_TRANSLATION]
// "if the gap is so large that you are already opening in a wide state, THE SETUP IS GONE."
bool gapTooLarge = (gapUp or gapDn) and isWide

if newSession
    gapArmedUp := gapUp and state[1] == ST_NARROW and not gapTooLarge
    gapArmedDn := gapDn and state[1] == ST_NARROW and not gapTooLarge
    gapBar     := bar_index

// The gap acts as "bar one"; the first subsequent bar continuing in the gap direction is the
// bar-two trigger.
bool gapTriggerUp = gapArmedUp and not newSession and isGreen
bool gapTriggerDn = gapArmedDn and not newSession and isRed
if gapTriggerUp
    gapArmedUp := false
if gapTriggerDn
    gapArmedDn := false

// ── Top event candidate for this bar (same-bar priority, policy S5) ──────────────────────────
// [RULE-064 | 03_VISUAL_DESIGN_SPEC.md §6 R2 | PLATFORM_SAFEGUARD]
EventCandidate ev = EventCandidate.new()

if comboBull
    ev := EventCandidate.new(EV_COMBO, DIR_LONG, ccEntryLong, "ELEPHANT + CHANGE", true)
else if comboBear
    ev := EventCandidate.new(EV_COMBO, DIR_SHORT, ccEntryShort, "ELEPHANT + CHANGE", true)
else if elephantBull
    ev := EventCandidate.new(EV_ELEPHANT, DIR_LONG, high + tick,
         isIgniting ? "IGNITING ELEPHANT" : isExhaustion ? "EXHAUSTION ELEPHANT" : "ELEPHANT", true)
else if elephantBear
    ev := EventCandidate.new(EV_ELEPHANT, DIR_SHORT, low - tick,
         isIgniting ? "IGNITING ELEPHANT" : isExhaustion ? "EXHAUSTION ELEPHANT" : "ELEPHANT", true)
else if bottomingTail
    ev := EventCandidate.new(EV_TAIL, DIR_LONG, high + tick, "BOTTOMING TAIL", true)
else if toppingTail
    ev := EventCandidate.new(EV_TAIL, DIR_SHORT, low - tick, "TOPPING TAIL", true)
else if ccBull
    ev := EventCandidate.new(EV_COLOUR, DIR_LONG, ccEntryLong, "COLOUR CHANGE", false)
else if ccBear
    ev := EventCandidate.new(EV_COLOUR, DIR_SHORT, ccEntryShort, "COLOUR CHANGE", false)
else if takeoutBull
    ev := EventCandidate.new(EV_TAKEOUT, DIR_LONG, high[2] + tick, "RED BAR TAKEOUT", false)
else if takeoutBear
    ev := EventCandidate.new(EV_TAKEOUT, DIR_SHORT, low[2] - tick, "GREEN BAR TAKEOUT", false)

bool anyEvent = ev.rank != EV_NONE
int  candDir  = ev.dir

// [RULE-065 | SAME-BAR POLICY S6] Conflicting long and short qualifying events on one bar.
bool conflictingEvents = (comboBull or elephantBull or bottomingTail or ccBull or takeoutBull) and
                         (comboBear or elephantBear or toppingTail or ccBear or takeoutBear)

// [RULE-066 | FIDELITY LAYER 1] In STRICT fidelity only events whose TRIGGER is fully specified
// by the source may open a lifecycle. The elephant detector needs an invented size multiple, so
// elephant-driven entries are excluded there; the bar is still drawn as context.
bool evEntryEligible = strictOn ?
     (ev.rank == EV_COLOUR or ev.rank == EV_TAKEOUT or ev.rank == EV_TAIL) : anyEvent


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §12  SPECIALISED SETUPS
//      [RULE-080..109 | CON-050..079 | SRC-190..239]
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// ── Clear blue skies to the left, and the purge ─────────────────────────────────────────────
// [RULE-080 | CON-051 | SRC-192/324 p.37,59 | DIRECT concept / PROGRAMMABLE_APPROXIMATION]
// "No significant price data immediately to the left of the surge, SO NOTHING FOR PRICE TO
// OVERCOME." The glossary's statement of purpose constrains the proxy. Worksheet W8.
float leftHigh = ta.highest(high, clearLb)[1]
float leftLow  = ta.lowest(low,   clearLb)[1]
bool clearLeftLong  = ready and not na(leftHigh) and close > leftHigh
bool clearLeftShort = ready and not na(leftLow)  and close < leftLow

// [RULE-081 | CON-052 | SRC-198 p.39 | DIRECT / PROGRAMMABLE_APPROXIMATION]
// "The purge. A move that clears out every nearby price to the left IN ONE MOTION."
bool purgeLong  = clearLeftLong  and low  <= leftHigh
bool purgeShort = clearLeftShort and high >= leftLow

// ── Surge off the 200 ───────────────────────────────────────────────────────────────────────
// [RULE-082 | CON-050 | SRC-190/191/195/196 p.37-38 | DIRECT / PROGRAMMABLE_APPROXIMATION]
// (1) a strong surge, often a large-bodied elephant bar, (2) originating at or very near a FLAT
// 200, (3) with clear blue skies to the left, and critically (4) "A surge is NOT ALWAYS an
// elephant bar ... A BOTTOMING TAIL BAR IS ALSO A SURGE" — the costume rule (SRC-196).
bool touched200    = low <= ma200Hi and high >= ma200Lo
bool originNear200 = nz(ta.barssince(touched200), SENTINEL_BARS) <= originTolBars

bool surgeBodyLong  = elephantBull or bottomingTail
bool surgeBodyShort = elephantBear or toppingTail

bool surgeLong  = enSurge and ready and flat200 and surgeBodyLong  and originNear200 and
                  clearLeftLong  and trendDir != DIR_SHORT
bool surgeShort = enSurge and ready and flat200 and surgeBodyShort and originNear200 and
                  clearLeftShort and trendDir != DIR_LONG
bool isSurge = surgeLong or surgeShort

// [RULE-083 | CON-053 | SRC-199 p.39 | DIRECT / EXACT_TRANSLATION]
// "All three together is the strongest version of the setup." merge + purge + surge.
bool mergePurgeSurge = isSurge and isMerge and (surgeLong ? purgeLong : purgeShort)

// ── The stop ladder on the trigger bar ──────────────────────────────────────────────────────
// [RULE-084 | CON-054 | SRC-151/197 p.38 | DIRECT / EXACT_TRANSLATION]
// "Ideally under the entire move, under the low of the origin ... If it does [exceed max loss],
// move the stop up, but IT MUST STAY IN THE BOTTOM THIRD of the triggering bar. Higher than that
// and it is not your trade." THERE IS NO FOURTH OPTION.
float thirdLong     = low  + rng / 3.0
float thirdShort    = high - rng / 3.0
float baseStopLong  = low  - tick
float baseStopShort = high + tick
float ladderEntryL  = high + tick
float ladderEntryS  = low  - tick

bool lossSet = maxLossPerUnit > 0
int ladderRungLong = not lossSet ? 1 :
     (ladderEntryL - baseStopLong) <= maxLossPerUnit ? 1 :
     (ladderEntryL - thirdLong)    <= maxLossPerUnit ? 2 : 3
int ladderRungShort = not lossSet ? 1 :
     (baseStopShort - ladderEntryS) <= maxLossPerUnit ? 1 :
     (thirdShort    - ladderEntryS) <= maxLossPerUnit ? 2 : 3

// ── Swing setups ────────────────────────────────────────────────────────────────────────────
// [RULE-085 | CON-057 | SRC-205/207 p.33 | DIRECT / PROGRAMMABLE_APPROXIMATION]
// "An explosive move out of a sleepy state. Can ignite off either the 20 or the 200." The source
// "prefers an elephant-sized bar rather than a regular bar to confirm you are genuinely out of it".
bool sleepyPrev  = isSleepy[1]
bool igniteLong  = enSwing and ready and sleepyPrev and elephantBull and close > stateTop
bool igniteShort = enSwing and ready and sleepyPrev and elephantBear and close < stateBot
bool isIgnite    = igniteLong or igniteShort

var int lastIgniteBar = na
if isIgnite
    lastIgniteBar := bar_index

// [RULE-086 | CON-058 | SRC-206/208 p.33 | DIRECT / PROGRAMMABLE_APPROXIMATION]
// "A colour change at or near the 20 ... The best combination: a pullback that occurs AFTER an
// igniting move. Igniting first, pullback second, is the highest-quality pairing."
bool pullbackLong  = enSwing and ready and ccBull and near20
bool pullbackShort = enSwing and ready and ccBear and near20
bool isPullback    = pullbackLong or pullbackShort

// [RULE-087 | CON-045 | SRC-127 p.34 | DIRECT rule / PROGRAMMABLE_APPROXIMATION]
// "If the pullback happens CLOSE TO the igniting move, take both and treat the second as an ADD,
// labelled 1A and 1B. If they are FAR APART, treat them as trade one and trade two." W19.
bool pullbackFollowsIgnite = isPullback and not na(lastIgniteBar) and
                             (bar_index - lastIgniteBar) <= abProximity

// ── Opening-bell sequence ───────────────────────────────────────────────────────────────────
// [RULE-088..092 | CON-059 | SRC-210 p.49 | DIRECT / EXACT_TRANSLATION]
// (4) Let the first bar complete — NO ACTION during bar one. (5) Mark one penny above bar one's
// high. (6) Enter the instant price crosses that mark — if bar two does not cross it, whichever
// later bar does gets the entry. (7) Stop one penny below bar one's low.
var float bar1Hi      = na
var float bar1Lo      = na
var int   bar1Bar     = na
var bool  obArmedL    = false
var bool  obArmedS    = false
var bool  obTriggered = false

// Bar one must open OUTSIDE a narrow state with a qualifying power bar (SRC-210 step 2).
bool obQualLong  = enOpening and newSession and ready and state[1] == ST_NARROW and
                   open > stateTop and (elephantBull or bottomingTail)
bool obQualShort = enOpening and newSession and ready and state[1] == ST_NARROW and
                   open < stateBot and (elephantBear or toppingTail)

if newSession
    bar1Hi      := high
    bar1Lo      := low
    bar1Bar     := bar_index
    obArmedL    := obQualLong  and not gapTooLarge
    obArmedS    := obQualShort and not gapTooLarge
    obTriggered := false

int  obBarsIn     = na(bar1Bar) ? 0 : bar_index - bar1Bar
bool obWindowOpen = obBarsIn >= 1 and obBarsIn <= openWindowBars

float obMarkLong  = na(bar1Hi) ? float(na) : bar1Hi + tick
float obMarkShort = na(bar1Lo) ? float(na) : bar1Lo - tick
bool  obEntryLong  = obArmedL and not obTriggered and obWindowOpen and high >= obMarkLong
bool  obEntryShort = obArmedS and not obTriggered and obWindowOpen and low  <= obMarkShort
if obEntryLong or obEntryShort
    obTriggered := true

// [RULE-091 | CON-090/077 | SRC-155/327 p.49,60 | DIRECT / EXACT_TRANSLATION]
// "Stop goes one penny below the low of bar one." The professional loss: one bar of adverse
// movement. This is the source's explicitly named exception (SRC-078 p.11) to C14.
float obStopLong  = na(bar1Lo) ? float(na) : bar1Lo - tick
float obStopShort = na(bar1Hi) ? float(na) : bar1Hi + tick

// ── Hidden green / hidden red ───────────────────────────────────────────────────────────────
// [RULE-093 | CON-060 | SRC-213 p.51 | DIRECT concept / PROGRAMMABLE_APPROXIMATION]
// "the first bar of the day opens BELOW a narrow state and starts printing GREEN, which is the
// WRONG COLOUR for the location ... mark the low of that green ... The moment that green is
// fully erased by red, WHETHER INSIDE THE SAME BAR OR ON A LATER BAR, that erasure point becomes
// the entry."
// LIMITATION, STATED RATHER THAN HIDDEN: the intrabar erasure instant is unobservable at bar
// close and any intrabar proxy would repaint. Only the BAR-CLOSE form is implemented. The
// implemented trigger is therefore A DIFFERENT EVENT from the one the source teaches, and will
// usually sit at a worse reference. Worksheet W21.
var bool  hgArmed   = false
var bool  hrArmed   = false
var float hgRefLow  = na
var float hrRefHigh = na

if newSession
    hgArmed   := enHidden and ready and state[1] == ST_NARROW and open < stateBot and isGreen
    hrArmed   := enHidden and ready and state[1] == ST_NARROW and open > stateTop and isRed
    hgRefLow  := hgArmed ? low  : float(na)
    hrRefHigh := hrArmed ? high : float(na)

bool hiddenGreenShort = hgArmed and not newSession and isRed   and close < hgRefLow
bool hiddenRedLong    = hrArmed and not newSession and isGreen and close > hrRefHigh
if hiddenGreenShort
    hgArmed := false
if hiddenRedLong
    hrArmed := false

// ── Dual space reversal ─────────────────────────────────────────────────────────────────────
// [RULE-094 | CON-061 | SRC-228 p.45 | DIRECT / PROGRAMMABLE_APPROXIMATION]
// "price, the 20 and the 200 were all separated from each other. Two layers of space at once ...
// The trade: short once green gets eliminated by red, stop above the recent green, TARGET THE
// GAP CLOSING BACK TO THE 20."
bool dualSpaceArmed = enDual and ready and spaceN >= dualSpaceMult and gapN >= wideMult
bool dualShort = dualSpaceArmed and close > sma20 and ccBear
bool dualLong  = dualSpaceArmed and close < sma20 and ccBull
bool isDual    = dualShort or dualLong

// ── Retracement ladder and the scalp/trade decision ─────────────────────────────────────────
// [RULE-095..098 | CON-062/063/064/065 | SRC-216/218/269/271 p.46]
// REPAINT CLASS: CONFIRMED-LATER (pivot-derived legs).
var float legHi     = na
var float legLo     = na
var bool  legIsDown = false

if (pivHiConfirmed or pivLoConfirmed) and not na(lastPivHi) and not na(lastPivLo)
    legHi     := lastPivHi
    legLo     := lastPivLo
    legIsDown := lastPivHiBar < lastPivLoBar

float legSize   = (na(legHi) or na(legLo)) ? float(na) : legHi - legLo
bool  legStrong = enRetrace and not na(legSize) and legSize > 0 and
                  nz(safeDiv(legSize, unitState), 0.0) >= strongMoveAtr

// The LEVELS are computable from the source's own percentages. The hit rates the source attaches
// to them are its own self-reported claims and are never asserted by this indicator.
float ret25  = na(legSize) ? float(na) :
     legIsDown ? legLo + RET_25 * legSize : legHi - RET_25 * legSize
float ret50  = na(legSize) ? float(na) :
     legIsDown ? legLo + RET_50 * legSize : legHi - RET_50 * legSize
float ret75  = na(legSize) ? float(na) :
     legIsDown ? legLo + RET_75 * legSize : legHi - RET_75 * legSize
float ret100 = na(legSize) ? float(na) : legIsDown ? legHi : legLo

// [RULE-098 | CON-064 | SRC-218/269 p.46 | DIRECT / EXACT_TRANSLATION]
// "Failed to clear the 50% mark -> the odds strongly favour a new low. Treat it as continuation
// ... Cleared 50% by a significant margin, toward 65 or 70% -> the next pullback becomes a
// higher-conviction TRADE rather than a scalp."
float bouncePct = (na(legSize) or legSize <= 0) ? float(na) :
     legIsDown ? nz(safeDiv(high - legLo, legSize), 0.0) * 100.0 :
                 nz(safeDiv(legHi - low,  legSize), 0.0) * 100.0
string scalpVerdict = na(bouncePct) ? "-" :
     bouncePct >= scalpTradePct ? "THIS IS A TRADE" :
     bouncePct <  50.0          ? "EXPECT CONTINUATION" : "AMBIGUOUS"

// ── Reversal warnings (Lesson 1) ────────────────────────────────────────────────────────────
// [RULE-099 | CON-066 | SRC-232 p.24 | DIRECT level / PROGRAMMABLE_APPROXIMATION on severity]
// "Take the up-move and split it in half. If the pullback SEVERELY BREAKS that halfway point, it
// is a deep drop." The 50% level is exact; "severely" is not quantified in Lesson 1. W15.
bool deepDropLong = enReversal and not na(legSize) and legSize > 0 and not legIsDown and
                    nz(safeDiv(legHi - low, legSize), 0.0) * 100.0 >= deepDropPct
bool deepDropShort = enReversal and not na(legSize) and legSize > 0 and legIsDown and
                     nz(safeDiv(high - legLo, legSize), 0.0) * 100.0 >= deepDropPct
bool isDeepDrop = (deepDropLong or deepDropShort) and (pivLoConfirmed or pivHiConfirmed)

// [RULE-100 | CON-068 | SRC-233 p.25 | DIRECT concept / PROGRAMMABLE_APPROXIMATION]
// Market Law Four: "a head and shoulders WITHOUT the head. Price makes a high, pulls back,
// rallies again but fails to make a SIGNIFICANT new high, then breaks down."
bool lowerTop = enReversal and pivHiConfirmed and not na(prevPivHi) and
                lastPivHi < prevPivHi - mlfSignifMult * atrUnit
bool higherBottom = enReversal and pivLoConfirmed and not na(prevPivLo) and
                    lastPivLo > prevPivLo + mlfSignifMult * atrUnit

// [RULE-101 | CON-067 | SRC-231 p.23 | DIRECT concept / PROGRAMMABLE_APPROXIMATION]
// "The first decline noticeably LARGER OR SHARPER THAN ANY PULLBACK BEFORE IT. This is the
// signal Velez most wants you to train on."
var float maxPriorPullback = 0.0
var float lastPullback     = 0.0
bool firstWarningDrop = false
if pivLoConfirmed and not na(lastPivHi)
    lastPullback := lastPivHi - lastPivLo
    firstWarningDrop := enReversal and maxPriorPullback > 0 and lastPullback > maxPriorPullback
    maxPriorPullback := math.max(maxPriorPullback, lastPullback)
if stateChanged and isNarrow
    maxPriorPullback := 0.0

// NOT IMPLEMENTED, DELIBERATELY: the full six-stage head-and-shoulders with a neckline
// (CON-069 | SRC-230/234/236 p.23-26). The source supplies no tolerance for shoulder equality,
// no bar window and no neckline slope allowance, and explicitly warns against mechanising it:
// "Treating it as a mechanical checklist ... the shoulders do not have to be equal, usually but
// not always. The pattern is probabilistic. A slanted right shoulder still counts" (SRC-237
// p.27). Building a detector would require inventing every one of those tolerances against a
// direct instruction not to. The three components the source DOES define comparably — the 50%
// deep-drop test, the first-warning-drop comparison and the lower-high structure — are
// implemented above instead. See 02_CONCEPT_TO_CODE_MAP.md §8.


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §13  HIGHER-TIMEFRAME CONTEXT (optional, OFF by default)
//      [RULE-102 | CON-115 | SRC-248 p.66 | DIRECT / PROGRAMMABLE_APPROXIMATION]
//      Requests only CLOSED higher-timeframe values, with lookahead EXPLICITLY off.
//      barstate.isconfirmed is deliberately NOT used inside the request — that is a well-known
//      anti-pattern which does not deliver higher-timeframe confirmation.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

[htfA, htfB] = request.security(syminfo.tickerid, htfTf,
     [ta.sma(close, len20)[1], ta.sma(close, len20)[2]], lookahead = barmerge.lookahead_off)

int htfDir = (not useHtf or na(htfA) or na(htfB)) ? DIR_NONE :
     htfA > htfB ? DIR_LONG : htfA < htfB ? DIR_SHORT : DIR_NONE

// [RULE-105 | CON-132 | EXPERIMENTAL] Higher-timeframe direction as a HARD GATE. The source
// supports NOTING the higher-timeframe 20 direction (SRC-248); it does not support gating on it.
bool expHtfBlocksLong  = expHtfGateActive and htfDir == DIR_SHORT
bool expHtfBlocksShort = expHtfGateActive and htfDir == DIR_LONG

// [RULE-104 | CON-131 | EXPERIMENTAL] Confluence density: a rolling count of supported events.
float expDensity = expDensityActive ? math.sum(anyEvent ? 1.0 : 0.0, EXP_DENSITY_LEN) : 0.0


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §14  INITIAL STOP SELECTION  (computed BEFORE the gates so the dumb-stop rule can gate)
//      [RULE-174 | CON-080/090/091/092 | SRC-077/153/154/155 | DIRECT / EXACT_TRANSLATION]
//      "The stop belongs BEYOND THE STATE ITSELF, not merely beyond your entry bar."
// ═══════════════════════════════════════════════════════════════════════════════════════════════

float sleepyLowRef  = ta.lowest(low,   math.max(sleepyBars, 2))
float sleepyHighRef = ta.highest(high, math.max(sleepyBars, 2))

float initStopLong = obEntryLong ? obStopLong :
     igniteLong ? (swingStopSel == "Whole sleepy base" ?
          math.min(sleepyLowRef, stateBot) - tick : low - tick) :
     pullbackLong ? (pullbackStopSel == "Pivot" and not na(lastPivLo) ?
          lastPivLo - tick : low - tick) :
     (isSurge and surgeLong) ? (ladderRungLong == 1 ? baseStopLong : thirdLong) :
     stateBot - tick

float initStopShort = obEntryShort ? obStopShort :
     igniteShort ? (swingStopSel == "Whole sleepy base" ?
          math.max(sleepyHighRef, stateTop) + tick : high + tick) :
     pullbackShort ? (pullbackStopSel == "Pivot" and not na(lastPivHi) ?
          lastPivHi + tick : high + tick) :
     (isSurge and surgeShort) ? (ladderRungShort == 1 ? baseStopShort : thirdShort) :
     stateTop + tick

// [RULE-175 | CON-028/081 | SRC-077 p.11,55 | DIRECT / EXACT_TRANSLATION]
// "NEVER PUT THE STOP INSIDE POSITION ONE ... A stop placed inside position one will be taken out
// by the ordinary noise the setup is built on." The opening-bell method bypasses this by the
// source's own explicit exception (SRC-078 p.11).
bool stopValidLong  = obEntryLong  or not enforceDumbStop or initStopLong  < stateBot
bool stopValidShort = obEntryShort or not enforceDumbStop or initStopShort > stateTop


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §15  HARD GATES, BLOCKERS AND THE CONFLUENCE LAYER
//      [RULE-110..129 | CON-111/112 | 04_INDICATOR_ARCHITECTURE.md §8]
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// [RULE-110 | FIDELITY LAYER] In STRICT fidelity, state and position do NOT gate — because
// gating requires a threshold the source refuses to supply. They are still computed and shown.
bool gateWithFunnel = fidelity != FID_STRICT

int blockers = 0
if not ready
    blockers := blockers + BLK_WARMUP
if gateWithFunnel and insideState
    blockers := blockers + BLK_INSIDE_STATE                    // SRC-075 p.10
if not evEntryEligible
    blockers := blockers + BLK_NO_EVENT                        // SRC-025 p.5
if enforce20Dir and candDir != DIR_NONE and trendDir != DIR_NONE and candDir != trendDir
    blockers := blockers + BLK_AGAINST_20                      // SRC-224 p.43
else if enforce20Dir and gateWithFunnel and trendFlat and candDir != DIR_NONE
    blockers := blockers + BLK_AGAINST_20                      // SRC-225 p.43 "discard these"
if gateWithFunnel and plutoLand and candDir != DIR_NONE and candDir == trendDir
    blockers := blockers + BLK_PLUTO                           // SRC-079 p.11, SRC-284 p.56
if gateWithFunnel and enSwing and threeFingers and (isIgnite or isPullback)
    blockers := blockers + BLK_THREE_FINGERS                   // SRC-292 p.36
if (candDir == DIR_LONG and not stopValidLong) or (candDir == DIR_SHORT and not stopValidShort)
    blockers := blockers + BLK_DUMB_STOP                       // SRC-077 p.11
if isSurge and ((surgeLong and ladderRungLong == 3) or (surgeShort and ladderRungShort == 3))
    blockers := blockers + BLK_LADDER_SKIP                     // SRC-197 p.38 "skip the trade"
if conflictingEvents
    blockers := blockers + BLK_CONFLICT                        // same-bar policy S6
if (expHtfBlocksLong and candDir == DIR_LONG) or (expHtfBlocksShort and candDir == DIR_SHORT)
    blockers := blockers + BLK_HTF_OPPOSED                     // experimental

bool gatesPass = blockers == 0

// [RULE-120..129 | CON-111 | IMPLEMENTATION-DEFINED CONFLUENCE LAYER]
// NOT a Velez taxonomy — Velez never scores a setup numerically. A transparent additive model
// built only from source-supported dimensions, with published weights reproduced in Debug Mode.
// THE SCORE NEVER GATES; it only ranks what the source's own gates have already allowed.
int qScore = 0
if narrowGrade == NG_G1
    qScore := qScore + 3                                       // SRC-055
else if narrowGrade == NG_G2
    qScore := qScore + 2                                       // SRC-056
else if narrowGrade == NG_G3
    qScore := qScore + 1                                       // SRC-057
else if isRegular and near20
    qScore := qScore + 1                                       // SRC-059/061
if posAbs == 1
    qScore := qScore + 3                                       // SRC-072
else if posAbs == 2
    qScore := qScore + 1                                       // SRC-074
qScore := qScore + (ev.rank == EV_COMBO    ? 3 :               // SRC-107
                    ev.rank == EV_ELEPHANT ? 2 :               // SRC-092
                    ev.rank == EV_TAIL     ? 2 :               // SRC-096
                    ev.rank == EV_COLOUR   ? 1 :               // SRC-102
                    ev.rank == EV_TAKEOUT  ? 1 : 0)            // SRC-133
if candDir != DIR_NONE and candDir == trendDir
    qScore := qScore + 2                                       // SRC-224
if isSurge
    qScore := qScore + 2                                       // SRC-190
if (candDir == DIR_LONG and clearLeftLong) or (candDir == DIR_SHORT and clearLeftShort)
    qScore := qScore + 1                                       // SRC-192
if mergePurgeSurge
    qScore := qScore + 2                                       // SRC-199
if pullbackFollowsIgnite
    qScore := qScore + 1                                       // SRC-208
if legCount <= 1
    qScore := qScore + 1                                       // SRC-202
if not gatesPass
    qScore := 0

string qTier = tierName(qScore)


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §16  TRAILING-STOP REFERENCE CANDIDATES
//      [RULE-130..139 | CON-082..089 | SRC-142..148]
//      This section produces CANDIDATE LEVELS only; the rotation is applied in §17.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// [RULE-130 | CON-089 | SRC-147 p.29 | DIRECT / PROGRAMMABLE_APPROXIMATION]
// "The selection rule is DISTANCE FROM THE 20. Close to it, use big bars. Away from it, use bar
// by bar. Accelerating hard, use the 8." The fat-bar reference carries no distance condition in
// the five-methods table (SRC-142), so the selection rule is expressed through the bar-by-bar
// and acceleration gates below.
bool eligBarByBar = spaceN >= barByBarSpace                    // SRC-146 "dangling in mid-air"

// [RULE-131 | CON-086 | SRC-145 p.14,29 | DIRECT rule / PROGRAMMABLE_APPROXIMATION] W12.
float dPrice = close - close[accelLen]
float dMa20  = sma20 - sma20[accelLen]
bool accelLong  = dPrice > 0 and dMa20 > 0 and dPrice > accelMult * dMa20
bool accelShort = dPrice < 0 and dMa20 < 0 and math.abs(dPrice) > accelMult * math.abs(dMa20)

// [RULE-132 | CON-082 | SRC-142 p.14 | DIRECT / PROGRAMMABLE_APPROXIMATION on bar size]
// "Every time a large, solid bar prints, move the stop under it. Healthy stocks do not take out
// their own fat bars."
var float fatBarStopLong  = na
var float fatBarStopShort = na
if isElephant
    fatBarStopLong  := low  - tick
    fatBarStopShort := high + tick

// [RULE-133 | CON-083 | SRC-143 p.14,51 | DIRECT / EXACT_TRANSLATION]
// "one counter-colour bar followed by two bars in your direction ... move the stop just beyond
// that isolated counter-colour bar. LONG: RED, THEN GREEN-GREEN. SHORT: GREEN, THEN RED-RED."
// SOURCE INCONSISTENCY (SRC-152): the p.15 diagram labels an isolated group "GREEN, RED, RED"
// while illustrating a RISING (long-side) sequence — that label is the SHORT-side pattern. The
// textual rule is stated twice, in both directions, on pp.14 and 51, and is what is implemented.
// The inconsistency is documented in 01_MASTER_RULEBOOK.md §10.3 T4 rather than smoothed over.
bool colourAdjLong  = isRed[2]   and isGreen[1] and isGreen
bool colourAdjShort = isGreen[2] and isRed[1]   and isRed
var float colourStopLong  = na
var float colourStopShort = na
if colourAdjLong
    colourStopLong  := low[2]  - tick
if colourAdjShort
    colourStopShort := high[2] + tick

// [RULE-134 | CON-084 | SRC-144/320 p.14,60 | DIRECT rule / PROGRAMMABLE_APPROXIMATION]
// "When a new swing low forms and price moves away from it, put the stop under it. HOLD THERE
// UNTIL THE 20 CLIMBS PAST THAT LEVEL, then go back to trailing the 20."
// REPAINT CLASS: CONFIRMED-LATER — adopted on the confirmation bar only.
var float pivotStopLong  = na
var float pivotStopShort = na
if pivLoConfirmed
    pivotStopLong  := lastPivLo - tick
if pivHiConfirmed
    pivotStopShort := lastPivHi + tick
bool pivotHandedBackLong  = not na(pivotStopLong)  and sma20 > pivotStopLong
bool pivotHandedBackShort = not na(pivotStopShort) and sma20 < pivotStopShort

// [RULE-135..137] The remaining references.
float ma20StopLong  = ma20Lo
float ma20StopShort = ma20Hi
float ma8StopLong   = sma8 - band
float ma8StopShort  = sma8 + band
float barByBarLong  = low[1]  - tick
float barByBarShort = high[1] + tick

// [RULE-138 | CON-094 | SRC-150 p.14 | PLATFORM_SAFEGUARD PS-04]
bool setAll     = stopSetSel == "All eligible"
bool setSwing   = stopSetSel == "Swing (pivot, big bar, MA)"
bool setOpening = stopSetSel == "Opening bell (fat bar, colour adjust)"
bool usePivot  = setAll or setSwing
bool useFat    = setAll or setSwing or setOpening
bool useColour = setAll or setOpening
bool useMa     = setAll or setSwing
bool useBarBar = setAll


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §17  VIRTUAL LIFECYCLE STATE MACHINE
//      [RULE-170..189 | CON-110 | 04_INDICATOR_ARCHITECTURE.md §6]
//      A VIRTUAL METHODOLOGY LIFECYCLE. No fills, no size, no P&L, no broker.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

var Lifecycle lc = Lifecycle.new()

// [RULE-170a] Reset a terminal lifecycle at the START of the next bar. Reading lc at the top of
// the bar gives the previous bar's closing state, so no UDT history access is needed (Pine does
// not support the [1] operator on UDT fields).
if lc.state == LC_COMPLETED or lc.state == LC_INVALIDATED
    lc.state       := LC_IDLE
    lc.dir         := DIR_NONE
    lc.stop        := na
    lc.stopMethod  := SM_NONE
    lc.adds        := 0
    lc.pushes      := 0
    lc.initPeak    := na
    lc.initDone    := false
    lc.lastPushExt := na
    lc.exitReason  := ""

bool lcActive = lc.state == LC_LONG_ACTIVE or lc.state == LC_SHORT_ACTIVE or
                lc.state == LC_EXIT_CONTEXT

// ── Entry candidates ────────────────────────────────────────────────────────────────────────
// [RULE-171 | CON-040 | SRC-054/061/072 | DIRECT / EXACT_TRANSLATION]
bool narrowEntryLong  = gateWithFunnel ?
     (isNarrow and pos ==  1 and evEntryEligible and candDir == DIR_LONG) :
     (evEntryEligible and candDir == DIR_LONG)
bool narrowEntryShort = gateWithFunnel ?
     (isNarrow and pos == -1 and evEntryEligible and candDir == DIR_SHORT) :
     (evEntryEligible and candDir == DIR_SHORT)

// [RULE-172 | CON-041 | SRC-059/061/099/108 | DIRECT / PROGRAMMABLE_APPROXIMATION]
bool regEntryLong  = gateWithFunnel and isRegular and near20 and evEntryEligible and
                     candDir == DIR_LONG
bool regEntryShort = gateWithFunnel and isRegular and near20 and evEntryEligible and
                     candDir == DIR_SHORT

// [RULE-173 | CON-042 | SRC-060/063/074 | DIRECT / EXACT_TRANSLATION]
// "In a wide state you flip your bias and look for power in the OPPOSITE direction, because the
// market is heading back toward narrow."
bool revEntryLong  = gateWithFunnel and isWide and pos == -3 and evEntryEligible and
                     candDir == DIR_LONG
bool revEntryShort = gateWithFunnel and isWide and pos ==  3 and evEntryEligible and
                     candDir == DIR_SHORT

bool entryLongRaw  = gatesPass and (narrowEntryLong or regEntryLong or revEntryLong or
                     obEntryLong or hiddenRedLong or dualLong)
bool entryShortRaw = gatesPass and (narrowEntryShort or regEntryShort or revEntryShort or
                     obEntryShort or hiddenGreenShort or dualShort)

// [SAME-BAR POLICY S3/S6] Never enter on a bar carrying conflicting evidence.
bool anyEntryLong  = entryLongRaw  and not entryShortRaw
bool anyEntryShort = entryShortRaw and not entryLongRaw

// ── FSM: pre-entry phases ───────────────────────────────────────────────────────────────────
if ready and not lcActive
    bool stateSupports = isNarrow or isWide or (isRegular and near20)
    bool posSupports   = posAbs == 1 or (isWide and posAbs == 3) or not gateWithFunnel
    lc.state := not stateSupports and gateWithFunnel ? LC_IDLE :
                not posSupports ? LC_WATCHING :
                (evEntryEligible and gatesPass) ? LC_QUALIFIED : LC_DEVELOPING

// ── FSM: entry ──────────────────────────────────────────────────────────────────────────────
// [RULE-176 | PLATFORM_SAFEGUARD PS-01] One lifecycle at a time unless reversal is allowed.
bool canOpen = not lcActive or allowReversal
if ready and canOpen and (anyEntryLong or anyEntryShort)
    lc.dir         := anyEntryLong ? DIR_LONG : DIR_SHORT
    lc.state       := anyEntryLong ? LC_LONG_ACTIVE : LC_SHORT_ACTIVE
    lc.entryBar    := bar_index
    lc.entryRef    := anyEntryLong ? (obEntryLong  ? obMarkLong  : nz(ev.refLevel, close))
                                   : (obEntryShort ? obMarkShort : nz(ev.refLevel, close))
    lc.initStop    := anyEntryLong ? initStopLong : initStopShort
    lc.stop        := lc.initStop
    lc.stopMethod  := SM_INITIAL
    lc.adds        := 0
    lc.pushes      := 0
    lc.entryState  := state
    lc.isOpening   := anyEntryLong ? obEntryLong : obEntryShort
    lc.initPeak    := na
    lc.initDone    := false
    lc.lastPushExt := na
    lc.exitReason  := ""

lcActive := lc.state == LC_LONG_ACTIVE or lc.state == LC_SHORT_ACTIVE or
            lc.state == LC_EXIT_CONTEXT
bool lcLong = lc.dir == DIR_LONG

// ── FSM: adds ───────────────────────────────────────────────────────────────────────────────
// [RULE-177 | CON-043/044 | SRC-123/126 p.13,30 | DIRECT / EXACT_TRANSLATION]
// "ADD ON THE FIRST COLOUR CHANGE AFTER ENTRY ... described as MANDATORY rather than optional."
// Continued adds are permitted on subsequent qualifying events at or near the 20 (SRC-126).
bool addTrigger = false
if lcActive and bar_index > lc.entryBar and lc.adds < maxAdds
    bool ccInDir      = lcLong ? ccBull : ccBear
    bool takeoutInDir = lcLong ? takeoutBull : takeoutBear
    bool contEvent    = ccInDir or (lcLong ? bottomingTail : toppingTail) or
                        (lcLong ? elephantBull : elephantBear)
    addTrigger := lc.adds == 0 ? (ccInDir or takeoutInDir) : (contEvent and near20)
    if addTrigger
        lc.adds := lc.adds + 1

// ── FSM: stop rotation ──────────────────────────────────────────────────────────────────────
// [RULE-178 | CON-088 | SRC-140/148 p.14 | DIRECT / EXACT_TRANSLATION]
// "You apply whichever one currently gives the HIGHEST PROTECTIVE LEVEL, and you re-check every
// time a new bar qualifies." Monotonic: the stop never loosens (CON-095 / SRC-095).
// The initial stop holds on the entry bar itself.
bool rotOk = lcActive and bar_index > lc.entryBar

float candPivot = rotOk and usePivot ?
     (lcLong ? (pivotHandedBackLong  ? float(na) : pivotStopLong)
             : (pivotHandedBackShort ? float(na) : pivotStopShort)) : float(na)
float candFat = rotOk and useFat ?
     (lcLong ? fatBarStopLong : fatBarStopShort) : float(na)
float candColour = rotOk and useColour ?
     (lcLong ? colourStopLong : colourStopShort) : float(na)
float candMa20 = rotOk and useMa ?
     (lcLong ? ma20StopLong : ma20StopShort) : float(na)
float candMa8 = rotOk and useMa and (lcLong ? accelLong : accelShort) ?
     (lcLong ? ma8StopLong : ma8StopShort) : float(na)
float candBbb = rotOk and useBarBar and eligBarByBar ?
     (lcLong ? barByBarLong : barByBarShort) : float(na)

[rs1, rm1] = applyStop(lcLong, lc.stop, lc.stopMethod, candPivot,  SM_PIVOT)
[rs2, rm2] = applyStop(lcLong, rs1,     rm1,           candFat,    SM_FATBAR)
[rs3, rm3] = applyStop(lcLong, rs2,     rm2,           candColour, SM_COLOUR)
[rs4, rm4] = applyStop(lcLong, rs3,     rm3,           candMa20,   SM_MA20)
[rs5, rm5] = applyStop(lcLong, rs4,     rm4,           candMa8,    SM_MA8)
[rs6, rm6] = applyStop(lcLong, rs5,     rm5,           candBbb,    SM_BARBYBAR)

bool stopMoved = rotOk and not na(rs6) and rs6 != lc.stop
if rotOk
    lc.stop       := rs6
    lc.stopMethod := rm6

// ── FSM: pushes ─────────────────────────────────────────────────────────────────────────────
// [RULE-179 | CON-100 | SRC-170 p.16 | DIRECT rule / PROGRAMMABLE_APPROXIMATION]
// A push is NEVER mechanically defined anywhere in the 71 pages. Implemented as a confirmed
// higher-pivot count so ONE notion of "swing" governs the whole chart. Worksheet W10.
// REPAINT CLASS: CONFIRMED-LATER.
// pushIncrement is tracked as a plain bool because Pine does not support the [1] history
// operator on user-defined-type fields — lc.pushes[1] is not a legal expression.
bool pushIncrement = false
if lcActive
    if lcLong and pivHiConfirmed and lastPivHiBar > lc.entryBar and
       (na(lc.lastPushExt) or lastPivHi > lc.lastPushExt)
        lc.lastPushExt := lastPivHi
        lc.pushes      := lc.pushes + 1
        pushIncrement  := true
    if not lcLong and pivLoConfirmed and lastPivLoBar > lc.entryBar and
       (na(lc.lastPushExt) or lastPivLo < lc.lastPushExt)
        lc.lastPushExt := lastPivLo
        lc.pushes      := lc.pushes + 1
        pushIncrement  := true

// [RULE-180 | CON-103 | SRC-173 p.16 | DIRECT rule / PROGRAMMABLE_APPROXIMATION]
// "Once price makes a fresh peak BEYOND THE INITIAL MOVE ... you have EARNED THE RIGHT to take
// money off the table ... this is a RIGHT AND NOT AN OBLIGATION." The initial move runs from
// entry to the first confirmed counter-pivot. Worksheet W11.
if lcActive and not lc.initDone
    lc.initPeak := na(lc.initPeak) ? (lcLong ? high : low) :
         (lcLong ? math.max(lc.initPeak, high) : math.min(lc.initPeak, low))
    if (lcLong and pivLoConfirmed and lastPivLoBar > lc.entryBar) or
       (not lcLong and pivHiConfirmed and lastPivHiBar > lc.entryBar)
        lc.initDone := true

bool newHighRight = lcActive and lc.initDone and not na(lc.initPeak) and
                    (lcLong ? high > lc.initPeak : low < lc.initPeak)

// ── FSM: exit contexts ──────────────────────────────────────────────────────────────────────
bool exitThirdPush    = lcActive and lc.pushes >= 3                       // SRC-170
bool exitNarrowToWide = lcActive and lc.entryState == ST_NARROW and isWide // SRC-062/180
bool push2Right = lcActive and lc.pushes == 2 and not na(lc.lastPushExt) and
     not na(lc.entryRef) and
     math.abs(lc.lastPushExt - lc.entryRef) >= push2Large * math.max(atrUnit, tick)  // SRC-171
bool obWindowExpired = lcActive and lc.isOpening and (bar_index - lc.entryBar) > openWindowBars

string exitReason = exitNarrowToWide ? "NARROW->WIDE" :
                    exitThirdPush    ? "3RD PUSH" :
                    newHighRight     ? "NEW HIGH RIGHT" :
                    obWindowExpired  ? "WINDOW ELAPSED" : ""
bool anyExitContext = exitReason != ""

// ── FSM: terminal transitions ───────────────────────────────────────────────────────────────
// [RULE-185 | SAME-BAR POLICY S2/S7/S11] The stop is evaluated BEFORE any favourable roll can
// rescue the bar, and a gap through the reference records the gap open — never a level price
// never traded.
bool stopBroken = lcActive and not na(lc.stop) and (lcLong ? low <= lc.stop : high >= lc.stop)
bool gapThrough = stopBroken and (lcLong ? open < lc.stop : open > lc.stop)

// [RULE-186 | SAME-BAR POLICY S1] Entry and stop on the same bar -> treat as stopped.
bool sameBarAmbiguity = lcActive and lc.entryBar == bar_index and stopBroken

bool lcCompleted   = false
bool lcInvalidated = false

if lcActive
    if sameBarAmbiguity
        lc.state      := LC_INVALIDATED
        lc.exitReason := "SAME-BAR AMBIGUITY"
        lcInvalidated := true
    else if stopBroken
        lc.state      := LC_COMPLETED
        lc.exitReason := gapThrough ? "STOP-OUT (GAP-THROUGH)" : "STOP-OUT"
        lcCompleted   := true
    else if anyExitContext
        lc.state      := LC_EXIT_CONTEXT
        lc.exitReason := exitReason
    else
        lc.state      := lcLong ? LC_LONG_ACTIVE : LC_SHORT_ACTIVE
        lc.exitReason := ""

lcActive := lc.state == LC_LONG_ACTIVE or lc.state == LC_SHORT_ACTIVE or
            lc.state == LC_EXIT_CONTEXT

// Plain bool mirrors of the lifecycle state, so rising-edge detection operates on an ordinary
// series rather than on a user-defined-type field (Pine has no [1] operator for UDT fields).
bool lcLongActive  = lc.state == LC_LONG_ACTIVE
bool lcShortActive = lc.state == LC_SHORT_ACTIVE


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §18  VISIBILITY RESOLVER
//      [RULE-190..199 | 03_VISUAL_DESIGN_SPEC.md §5-§6]
//      Modes change VISIBILITY ONLY. Nothing here alters detection.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

bool inWindow = bar_index > last_bar_index - historyCap

showEventMarker(int rank, int score) =>
    bool base = showEvents and inWindow and ready
    bool byMode = modeFull ? true :
                  modeAnalysis ? rank >= EV_TAKEOUT :
                  (rank == EV_COMBO or (rank == EV_ELEPHANT and score >= 10) or score >= 7)
    base and byMode

var int lastEventLabelBar = na
canPlaceEventLabel() =>
    na(lastEventLabelBar) or (bar_index - lastEventLabelBar) >= labelGap

var int altToggle = 0
offsetFor(bool above) =>
    float mult = altToggle % 2 == 0 ? 1.0 : ALT_OFFSET_MULT
    float off  = labelOffAtr * atrUnit * mult
    above ? high + off : low - off


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §19  COLOURS
// ═══════════════════════════════════════════════════════════════════════════════════════════════

color colBull = cbSafe ? #1F6FB2 : colBullIn
color colBear = cbSafe ? #C4661A : colBearIn
color colNeut = colNeutIn
color colDeep = colDeepIn
color colWarn = colWarnIn
color colMute = color.new(colNeutIn, 55)
color stateColor = isNarrow ? colBull : isWide ? colBear : colNeut


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §20  PLOTS (global scope — Pine requires it; visibility is series-driven, never conditional)
//      [RULE-200..207]
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// [RULE-200 | CON-001/002 | SRC-030/031] The two permanent fixtures.
// The source's own diagram convention (p.2): thin line = the 20, thick line = the 200.
plot(ready ? sma20  : na, "20 SMA",  color = colNeut, linewidth = 1)
plot(ready ? sma200 : na, "200 SMA", color = colDeep, linewidth = 2)

// [RULE-201 | CON-003 | SRC-033] The 8 appears only while escalated — it is situational.
bool ma8Visible = showMa8 and lcActive and lc.stopMethod == SM_MA8
plot(ma8Visible ? sma8 : na, "8 SMA (trail only)", color = color.new(colNeut, 20), linewidth = 1,
     style = plot.style_linebr)

// [RULE-202 | CON-004 | SRC-042/003] Zones, not lines.
p20Hi  = plot(ready and showBands ? ma20Hi  : na, "20 band +",  color = color.new(colNeut, 100))
p20Lo  = plot(ready and showBands ? ma20Lo  : na, "20 band -",  color = color.new(colNeut, 100))
p200Hi = plot(ready and showBands ? ma200Hi : na, "200 band +", color = color.new(colDeep, 100))
p200Lo = plot(ready and showBands ? ma200Lo : na, "200 band -", color = color.new(colDeep, 100))
fill(p20Hi,  p20Lo,  color = color.new(colNeut, 92), title = "20 zone")
fill(p200Hi, p200Lo, color = color.new(colDeep, 92), title = "200 zone")

// [RULE-203 | CON-088] The active virtual stop — the single most operationally important object,
// and the one thing a reader cannot reconstruct by eye. Visible in EVERY mode, including Clean.
plot(showLifecycle and lcActive and inWindow ? lc.stop : na, "Virtual stop (v)",
     color = lcLong ? colBull : colBear, linewidth = 2, style = plot.style_linebr)

// [RULE-203b] Entry reference and the FROZEN initial stop. Both are plots rather than line
// objects so they cost no drawing budget and extend automatically for the lifecycle's life.
// The initial stop is hidden in Clean Mode (03_VISUAL_DESIGN_SPEC.md §10.1).
plot(showLifecycle and lcActive and inWindow ? lc.entryRef : na, "Virtual entry ref (v)",
     color = color.new(colNeut, 30), linewidth = 1, style = plot.style_linebr)
plot(showLifecycle and lcActive and inWindow and modeAnalysis ? lc.initStop : na,
     "Virtual initial stop (v)", color = color.new(colWarn, 45), linewidth = 1,
     style = plot.style_linebr)

// [RULE-204 | 03_VISUAL_DESIGN_SPEC.md §6 R8] The Data Window pressure valve: detail that does
// not earn chart space.
plot(qScore,     "Confluence score [impl]", display = display.data_window)
plot(spaceRank,  "Space percentile",        display = display.data_window)
plot(pos,        "Position (+3..-3)",       display = display.data_window)
plot(gapN,       "20/200 gap (units)",      display = display.data_window)
plot(lc.pushes,  "Virtual pushes [c]",      display = display.data_window)
plot(legCount,   "Leg count",               display = display.data_window)
plot(expDensity, "Confluence density [exp]", display = display.data_window)

// [RULE-205] Compact event shapes. plotshape costs no label budget, which is what lets Full
// Velez Mode show every supported event inside the bounded window.
bool sComboB = showEventMarker(EV_COMBO,    qScore) and comboBull
bool sComboS = showEventMarker(EV_COMBO,    qScore) and comboBear
bool sEleB   = showEventMarker(EV_ELEPHANT, qScore) and elephantBull and not comboBull
bool sEleS   = showEventMarker(EV_ELEPHANT, qScore) and elephantBear and not comboBear
bool sTailB  = showEventMarker(EV_TAIL,     qScore) and bottomingTail
bool sTailS  = showEventMarker(EV_TAIL,     qScore) and toppingTail
bool sCcB    = showEventMarker(EV_COLOUR,   qScore) and ccBull and not comboBull
bool sCcS    = showEventMarker(EV_COLOUR,   qScore) and ccBear and not comboBear
bool sTkB    = showEventMarker(EV_TAKEOUT,  qScore) and takeoutBull
bool sTkS    = showEventMarker(EV_TAKEOUT,  qScore) and takeoutBear

plotshape(sComboB, title = "Elephant + change (bull)", style = shape.diamond,
     location = location.belowbar, color = colBull, size = size.tiny)
plotshape(sComboS, title = "Elephant + change (bear)", style = shape.diamond,
     location = location.abovebar, color = colBear, size = size.tiny)
// Exhaustion elephants are drawn MORE QUIETLY than igniting ones, because the source's point is
// that they are a reason NOT to act (SRC-235, SRC-287).
plotshape(sEleB, title = "Elephant (bull)", style = shape.triangleup,
     location = location.belowbar, color = isExhaustion ? color.new(colBull, 55) : colBull,
     size = size.tiny)
plotshape(sEleS, title = "Elephant (bear)", style = shape.triangledown,
     location = location.abovebar, color = isExhaustion ? color.new(colBear, 55) : colBear,
     size = size.tiny)
plotshape(sTailB, title = "Bottoming tail", style = shape.circle, location = location.belowbar,
     color = colBull, size = size.tiny)
plotshape(sTailS, title = "Topping tail", style = shape.circle, location = location.abovebar,
     color = colBear, size = size.tiny)
plotshape(sCcB, title = "Colour change (bull)", style = shape.xcross,
     location = location.belowbar, color = color.new(colBull, 25), size = size.tiny)
plotshape(sCcS, title = "Colour change (bear)", style = shape.xcross,
     location = location.abovebar, color = color.new(colBear, 25), size = size.tiny)
plotshape(sTkB, title = "Red bar takeout", style = shape.arrowup, location = location.belowbar,
     color = color.new(colBull, 35), size = size.tiny)
plotshape(sTkS, title = "Green bar takeout", style = shape.arrowdown,
     location = location.abovebar, color = color.new(colBear, 35), size = size.tiny)

// [RULE-206] Lifecycle transition shapes. Entry/add/stop-out use location.absolute with an
// explicit price series (a bool series with location.absolute would plot at 0/1).
plotshape(showLifecycle and inWindow and rise(lcLongActive),
     title = "Virtual entry (long)", style = shape.labelup, location = location.belowbar,
     color = colBull, size = size.small, text = "ENTRY", textcolor = color.white)
plotshape(showLifecycle and inWindow and rise(lcShortActive),
     title = "Virtual entry (short)", style = shape.labeldown, location = location.abovebar,
     color = colBear, size = size.small, text = "ENTRY", textcolor = color.white)
plotshape(showLifecycle and inWindow and addTrigger ?
     (lcLong ? low - labelOffAtr * atrUnit : high + labelOffAtr * atrUnit) : na,
     title = "Virtual add", style = shape.cross, location = location.absolute, color = colNeut,
     size = size.tiny)
plotshape(showLifecycle and inWindow and lcCompleted ? lc.stop : na,
     title = "Virtual stop-out", style = shape.xcross, location = location.absolute,
     color = colWarn, size = size.small)
plotshape(showPushes and inWindow and pushIncrement ? (lcLong ? high : low) : na,
     title = "Push [c]", style = shape.flag, location = location.absolute,
     color = color.new(colNeut, 30), size = size.tiny)

// [RULE-207 | CON-010 | PLATFORM_SAFEGUARD] Ambient state indication — never both at once.
// PINE LIMITATION, stated rather than glossed: Pine cannot anchor a fixed-height strip to the
// top of the price pane, because the visible price range is not exposed to the script. The
// "state ribbon" of 03_VISUAL_DESIGN_SPEC.md §8 is therefore realised as a very light pane-wide
// wash (6% opacity) rather than a 3px strip. The heavier "background tint" option is a separate,
// opt-in control with its own opacity cap.
bgcolor(showBg and ready ? color.new(stateColor, bgOpacity) : na, title = "State background")
bgcolor(showRibbon and not showBg and ready ? color.new(stateColor, 94) : na,
     title = "State wash (ribbon)")


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §21  DRAWING-OBJECT MANAGEMENT (bounded ring buffers)
//      [RULE-208..209 | CON-118/119 | PLATFORM_SAFEGUARD PS-09]
// ═══════════════════════════════════════════════════════════════════════════════════════════════

var array<label> evLabels  = array.new<label>()
var array<line>  evLines   = array.new<line>()
var array<label> lcLabels  = array.new<label>()
var array<box>   ctxBoxes  = array.new<box>()
var array<line>  ctxLines  = array.new<line>()
var array<label> ctxLabels = array.new<label>()
var int trimmedCount = 0

// [RULE-208 | R1/R2] One aggregated label per bar, highest priority only, spacing-limited.
if anyEvent and showEventMarker(ev.rank, qScore) and canPlaceEventLabel() and not modeClean
    bool above = ev.dir == DIR_SHORT
    string txt = ev.lbl + aMark(ev.approx)
    if qScore > 0
        txt := txt + "\n" + qTier + " " + tierPips(qScore) + " [impl]"
    label l = label.new(bar_index, offsetFor(above), txt,
         style     = above ? label.style_label_down : label.style_label_up,
         color     = color.new(ev.dir == DIR_LONG ? colBull : colBear, 12),
         textcolor = color.white,
         size      = modeFull ? size.tiny : size.small,
         tooltip   = "Traceability: see 02_CONCEPT_TO_CODE_MAP.md. '~' marks a value that " +
                     "depends on a threshold ADDED by this implementation, not taken from the " +
                     "source. '[impl]' marks the confluence layer, which is not a Velez taxonomy.")
    array.push(evLabels, l)
    lastEventLabelBar := bar_index
    altToggle := altToggle + 1
trimmedCount := trimmedCount + trimLabels(evLabels, CAP_EV_LABEL)

// [RULE-209 | CON-034 | SRC-105 p.13] The colour-change reference line at the BODY extreme —
// the single most useful event visual, because body-not-tail is the detail the source says
// people get wrong.
if showCcLine and isColourChange and modeAnalysis and inWindow
    float lvl    = ccBull ? ccUseHi : ccUseLo
    int   srcBar = math.max(ccBull ? nz(ccRefHiBar[1], bar_index - 1)
                                   : nz(ccRefLoBar[1], bar_index - 1), 0)
    if not na(lvl)
        line ln = line.new(srcBar, lvl, bar_index, lvl, color = color.new(colNeut, 35),
             style = line.style_dashed, width = 1)
        array.push(evLines, ln)
trimmedCount := trimmedCount + trimLines(evLines, CAP_EV_LINE)

// Lifecycle: stop-method change ticks (Analysis+).
if showLifecycle and lcActive and modeAnalysis and inWindow and stopMoved
    label sl = label.new(bar_index, lc.stop, stopMethodName(lc.stopMethod) + vMark(),
         style = lcLong ? label.style_label_up : label.style_label_down,
         color = color.new(colNeut, 20), textcolor = color.white, size = size.tiny)
    array.push(lcLabels, sl)
trimmedCount := trimmedCount + trimLabels(lcLabels, CAP_LC_LABEL)

// Context: position zone boxes, anchored at the right edge only (Analysis+).
if showZones and modeAnalysis and barstate.islast and ready
    int zoneLeft = math.max(bar_index - zoneBoxBars, 0)
    box b1 = box.new(zoneLeft, stateTop + p1Max * posUnit, bar_index + 3, stateTop,
         border_color = color.new(colBull, 70), bgcolor = color.new(colBull, 94),
         text = "POSITION 1" + aMark(true), text_size = size.tiny,
         text_color = color.new(colBull, 20), text_halign = text.align_right)
    box b2 = box.new(zoneLeft, stateBot, bar_index + 3, stateBot - p1Max * posUnit,
         border_color = color.new(colBear, 70), bgcolor = color.new(colBear, 94),
         text = "POSITION -1" + aMark(true), text_size = size.tiny,
         text_color = color.new(colBear, 20), text_halign = text.align_right)
    array.push(ctxBoxes, b1)
    array.push(ctxBoxes, b2)
trimmedCount := trimmedCount + trimBoxes(ctxBoxes, CAP_CTX_BOX)

// Context: the retracement ladder (Full+), with the source's claims explicitly attributed.
if showOdds and enRetrace and modeFull and barstate.islast and legStrong
    array<float>  lvls = array.from(ret25, ret50, ret75, ret100)
    array<string> txts = array.from(
         "25% - the source claims 9 of 10 (V6, self-reported)",
         "50% - the source claims 6 of 10 (V6, self-reported)",
         "75% - the source claims 2 of 10 (V6, self-reported)",
         "100% - the source claims 1 of 10 (V6, self-reported)")
    int retLeft = math.max(bar_index - 40, 0)
    for i = 0 to 3
        float v = array.get(lvls, i)
        if not na(v)
            line rl = line.new(retLeft, v, bar_index + 5, v,
                 color = color.new(colNeut, 55), style = line.style_dotted)
            array.push(ctxLines, rl)
            label rlb = label.new(bar_index + 5, v, array.get(txts, i) + cMark(),
                 style = label.style_label_left, color = color.new(colNeut, 88),
                 textcolor = colNeut, size = size.tiny,
                 tooltip = "These hit rates are the SOURCE'S OWN SELF-REPORTED CLAIMS " +
                 "(SRC-216/258, p.19,46). They are unpublished, carry no sample size, date " +
                 "range or instrument set, and are NOT outputs of this indicator. The LEVELS " +
                 "are computed; the odds are quoted, not asserted.")
            array.push(ctxLabels, rlb)
trimmedCount := trimmedCount + trimLines(ctxLines, CAP_CTX_LINE)
trimmedCount := trimmedCount + trimLabels(ctxLabels, CAP_CTX_LABEL)

// One-time non-standard chart warning. Cannot be dismissed by a display mode.
if nonStandardChart and barstate.islast
    label.new(bar_index, high, "CHART TYPE: NON-STANDARD\nBar-pattern logic (elephant, tail, " +
         "colour change) reads real OHLC and is DISTORTED on synthetic bars.",
         style = label.style_label_down, color = color.new(colWarn, 10),
         textcolor = color.white, size = size.small)


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §22  DASHBOARD
//      [RULE-210..219 | CON-113 | 03_VISUAL_DESIGN_SPEC.md §11]
//      ONE var table, created once, written only on the last bar.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

dashPos() =>
    switch dashPosSel
        "Top left"      => position.top_left
        "Top center"    => position.top_center
        "Top right"     => position.top_right
        "Middle left"   => position.middle_left
        "Middle right"  => position.middle_right
        "Bottom left"   => position.bottom_left
        "Bottom center" => position.bottom_center
        => position.bottom_right

dashSize() =>
    dashSizeSel == "Tiny" ? size.tiny : dashSizeSel == "Small" ? size.small : size.normal

var table dash = table.new(dashPos(), 2, 22, border_width = 1,
     frame_color = color.new(color.gray, 70), frame_width = 1,
     border_color = color.new(color.gray, 85))

row(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_size = dashSize(), text_halign = text.align_left,
         text_color = color.new(color.gray, 20), text_font_family = font.family_monospace)
    table.cell(dash, 1, r, v, text_size = dashSize(), text_halign = text.align_right,
         text_color = vc, text_font_family = font.family_monospace)

// Count of approximations contributing to the current picture (named in Debug Mode).
int approxCount = (gateWithFunnel ? 2 : 0) + 1 + (isElephant ? 1 : 0) + (isTail ? 1 : 0) +
     (isSurge ? 1 : 0) + (near20 ? 1 : 0) + (spaceExtreme ? 1 : 0) + 1

// [RULE-218 | CON-114 | SRC-240 p.21 | DIRECT / EXACT_TRANSLATION]
// Which lesson runs on which chart. ADVISORY ONLY — it never blocks, because C3/SRC-022 states
// the framework itself is timeframe-agnostic.
tfLesson() =>
    string tf = timeframe.period
    tf == "M"   ? "monthly -> V5" :
     tf == "240" ? "4-hour -> V3" :
     tf == "60"  ? "1-hour -> V3" :
     (tf == "D" or tf == "W") ? "daily/weekly -> V1" :
     tf == "5" ? "5-min -> V2 V6" :
     tf == "2" ? "2-min -> V2 V4 V6 V7" : tf + " -> not mapped in the source"

if barstate.islast and not showDash
    table.clear(dash, 0, 0, 1, 21)

if showDash and barstate.islast
    string aM    = showApproxMarks ? " ~" : ""
    string sName = stateName(state) + (narrowGrade != NG_NONE ? " " + gradeName(narrowGrade) : "")

    row(0, "VELEZ MARKET MAP", syminfo.ticker + " " + timeframe.period + vMark(), colNeut)
    row(1, "STATE", not ready ? "WARMING UP " + str.tostring(bar_index) + "/" +
         str.tostring(warmupNeeded) : sName + aM + "  gap " + str.tostring(gapN, "#.##"),
         stateColor)
    row(2, "POSITION", not ready ? "-" : (pos > 0 ? "+" : "") + str.tostring(pos) + aM +
         (posAbs == 1 ? "  (POSITION 1)" : plutoLand ? "  (PLUTO LAND)" :
          insideState ? "  (IN THE STATE)" : ""),
         posAbs == 1 ? colBull : plutoLand ? colWarn : colNeut)
    row(3, "TREND", (trendDir == DIR_LONG ? "20 up" : trendDir == DIR_SHORT ? "20 down" :
         "20 flat") + aM + "   200 " + (flat200 ? "flat" : "sloping"),
         trendDir == DIR_LONG ? colBull : trendDir == DIR_SHORT ? colBear : colNeut)
    row(4, "LOCATION", location == DIR_LONG ? "ABOVE" : location == DIR_SHORT ? "BELOW" :
         "INSIDE", colNeut)
    row(5, "MODE BY STATE", modeByState, colNeut)
    row(6, "EVENT", anyEvent ? ev.lbl + aMark(ev.approx) : "-",
         candDir == DIR_LONG ? colBull : candDir == DIR_SHORT ? colBear : colNeut)
    row(7, "LEG / PUSH", "LEG " + str.tostring(legCount + 1) +
         (lcActive ? "  PUSH " + str.tostring(lc.pushes) + cMark() : ""), colNeut)
    row(8, "SETUP", isSurge ? "SURGE OFF 200" + aM : isIgnite ? "IGNITE" + aM :
         isPullback ? "PULLBACK" + aM : (obEntryLong or obEntryShort) ? "OPENING BELL" :
         (hiddenGreenShort or hiddenRedLong) ? "HIDDEN" + aM : isDual ? "DUAL SPACE" + aM : "-",
         colNeut)
    row(9, "CONFLUENCE", qScore > 0 ? qTier + " " + tierPips(qScore) + " [impl]" : "-",
         qScore >= 10 ? colBull : colNeut)
    row(10, "EXTENSION", "space p" + str.tostring(nz(spaceRank, 0), "#") +
         (spaceExtreme ? "  EXTREME" + aM : "") + (threeFingers ? "  3 FINGERS" + aM : ""),
         (spaceExtreme or threeFingers) ? colWarn : colNeut)
    row(11, "VIRTUAL LIFECYCLE", lcName(lc.state) + vMark(),
         lc.state == LC_LONG_ACTIVE ? colBull : lc.state == LC_SHORT_ACTIVE ? colBear : colNeut)
    row(12, "ACTIVE STOP", (lcActive and not na(lc.stop)) ?
         str.tostring(lc.stop, format.mintick) + "  " + stopMethodName(lc.stopMethod) : "-",
         colNeut)
    row(13, "ADD", not lcActive ? "-" : lc.adds == 0 ? "DUE - first colour change" :
         str.tostring(lc.adds) + " of " + str.tostring(maxAdds), colNeut)
    row(14, "EXIT CONTEXT", lc.exitReason != "" ? lc.exitReason :
         anyExitContext ? exitReason : "-",
         (lc.exitReason != "" or anyExitContext) ? colWarn : colNeut)
    row(15, "SCALP / TRADE", enRetrace ? scalpVerdict : "-", colNeut)
    row(16, "FIDELITY", strictOn ? "STRICT SOURCE ONLY" : expOn ? "+ EXPERIMENTAL" :
         "SOURCE + APPROXIMATIONS", colNeut)
    row(17, "APPROX ACTIVE", str.tostring(approxCount) + "  (named in Debug)", colWarn)
    row(18, "TF LESSON", tfLesson(), colNeut)
    row(19, "HISTORY", "last " + str.tostring(historyCap) + " bars  trimmed " +
         str.tostring(trimmedCount), colNeut)
    row(20, "HTF 20", useHtf ? (htfDir == DIR_LONG ? "up" : htfDir == DIR_SHORT ? "down" :
         "flat") + " (" + htfTf + ")" + cMark() : "off", colNeut)
    row(21, "CHART TYPE", nonStandardChart ? "NON-STANDARD - distorted" : "standard",
         nonStandardChart ? colWarn : colNeut)


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §23  DEBUG PANEL
//      [RULE-230..239 | CON-112/113/121 | 03_VISUAL_DESIGN_SPEC.md §12]
// ═══════════════════════════════════════════════════════════════════════════════════════════════

var table dbg = table.new(position.bottom_left, 1, 14, border_width = 1,
     frame_color = color.new(color.gray, 70), frame_width = 1,
     border_color = color.new(color.gray, 88))

blockerText(int m) =>
    m == 0 ? "none" :
     (hasBit(m, BLK_NO_EVENT)      ? "NO EVENT (SRC-025) · "          : "") +
     (hasBit(m, BLK_INSIDE_STATE)  ? "INSIDE THE STATE (SRC-075) · "  : "") +
     (hasBit(m, BLK_PLUTO)         ? "PLUTO LAND (SRC-079) · "        : "") +
     (hasBit(m, BLK_AGAINST_20)    ? "AGAINST THE 20 (SRC-224) · "    : "") +
     (hasBit(m, BLK_DUMB_STOP)     ? "DUMB STOP (SRC-077) · "         : "") +
     (hasBit(m, BLK_LADDER_SKIP)   ? "STOP LADDER RUNG 3 (SRC-197) · ": "") +
     (hasBit(m, BLK_THREE_FINGERS) ? "THREE FINGERS (SRC-292) · "     : "") +
     (hasBit(m, BLK_LIFECYCLE)     ? "LIFECYCLE ACTIVE (platform) · " : "") +
     (hasBit(m, BLK_WARMUP)        ? "WARMING UP (platform) · "       : "") +
     (hasBit(m, BLK_HTF_OPPOSED)   ? "HTF OPPOSED [exp] · "           : "") +
     (hasBit(m, BLK_CONFLICT)      ? "CONFLICTING SETUPS (S6) · "     : "")

dbgRow(int r, string t, color c) =>
    table.cell(dbg, 0, r, t, text_size = size.tiny, text_halign = text.align_left,
         text_color = c, text_font_family = font.family_monospace)

if barstate.islast and not modeDebug
    table.clear(dbg, 0, 0, 0, 13)

if modeDebug and barstate.islast
    dbgRow(0, "FUNNEL TRACE · bar -" + str.tostring(dbgOffset) + " · build velez-map/1.0.0",
         colNeut)
    dbgRow(1, "1 STATE     " + stateName(state) + " " + gradeName(narrowGrade) + "   gap " +
         str.tostring(gapN, "#.##") + " vs narrow<=" + str.tostring(narrowMult) + " wide>=" +
         str.tostring(wideMult) + "   [CON-010 / SRC-051 p.8]", isNarrow ? colBull : colNeut)
    dbgRow(2, "2 POSITION  " + (pos > 0 ? "+" : "") + str.tostring(pos) + "   dUp " +
         str.tostring(dUp, "#.##") + " dDn " + str.tostring(dDn, "#.##") + "  p1<=" +
         str.tostring(p1Max) + " p2<=" + str.tostring(p2Max) + "   [CON-020 / SRC-071 p.10]",
         posAbs == 1 ? colBull : colNeut)
    dbgRow(3, "3 EVENT     " + (anyEvent ? ev.lbl : "none") + "   rng x" +
         str.tostring(nz(safeDiv(rng, avgRng), 0), "#.##") + " vs " + str.tostring(eleRangeMult) +
         "   tailDn " + str.tostring(tailDnFrac, "#.##") + "/" + str.tostring(tailMinFrac) +
         "   [CON-030/032/034]", anyEvent ? colBull : colMute)
    dbgRow(4, "GATES       " + (gatesPass ? "ALL PASS" : "BLOCKED") +
         (strictOn ? "   (STRICT: state/position do NOT gate)" : ""),
         gatesPass ? colBull : colWarn)
    dbgRow(5, showBlockers ? "BLOCKERS    " + blockerText(blockers) : "", colWarn)
    dbgRow(6, "QUALITY     " + str.tostring(qScore) + " -> " + qTier + "   [impl layer - NOT a " +
         "Velez taxonomy; full weight table in 02_CONCEPT_TO_CODE_MAP.md W23]", colNeut)
    dbgRow(7, "CONFIRM     event=CONFIRMED(bar close) · pivots=CONFIRMED-LATER" + cMark() +
         " (pivLen " + str.tostring(pivLen) + ")" +
         (allowProvisional ? " · PROVISIONAL PREVIEW ON (may repaint)" : ""), colNeut)
    dbgRow(8, "MODELS      state=" + stateBasisSel + " · pos=" + posBasisSel + " · elephant=" +
         eleModelSel + " · cc=" + ccRefSel + " · near20=" + near20Sel +
         (expOn ? " · EXPERIMENTAL ON" : ""), colNeut)
    dbgRow(9, "APPROX (~)  state · position · MA band · flatness · elephant size · tail ratio · " +
         "near-20 · clear-left · reset · push · space rank · deep-drop severity", colWarn)
    dbgRow(10, showCheck ? "CHECKLIST   " +
         ((isNarrow or isWide) ? "[x]" : "[ ]") + " state  " +
         ((posAbs == 1 or posAbs == 2) ? "[x]" : "[ ]") + " position  " +
         (anyEvent ? "[x]" : "[ ]") + " event  " +
         (isTail ? "[x]" : "[-]") + " tail valid  " +
         ((candDir == trendDir and candDir != DIR_NONE) ? "[x]" : "[ ]") + " with the 20  " +
         (lossSet ? "[x]" : "[ ] UNSET") + " max loss   [SRC-028 p.66]" : "", colNeut)
    dbgRow(11, showCount ? "RESOURCES   labels " +
         str.tostring(array.size(evLabels) + array.size(lcLabels) + array.size(ctxLabels)) +
         "/500 · lines " + str.tostring(array.size(evLines) + array.size(ctxLines)) +
         "/500 · boxes " + str.tostring(array.size(ctxBoxes)) + "/500 · trimmed " +
         str.tostring(trimmedCount) : "", colNeut)
    dbgRow(12, (showSnowman and isSnowman) ? "DIAGNOSTIC  SNOWMAN (NOT A TAIL BAR) - body " +
         str.tostring(bodyFrac, "#.##") + " of range. The source names this counterfeit " +
         "explicitly and says it does not count (SRC-097 p.12)." : "", colWarn)
    dbgRow(13, showClaims ? "SOURCE CLAIMS (attributed, NOT outputs): 87% open-above-narrow · " +
         "85% state weighting · 85% of losses against the 20 · 80% elephant follow-through · " +
         "8/10 opening bell · 2-3/10 swing failures · 9/6/2/1 of 10 retracement. All " +
         "self-reported, unpublished, no stated sample. SRC-004 p.2 / SRC-273 p.20." : "", colMute)


// ═══════════════════════════════════════════════════════════════════════════════════════════════
// §24  ALERTS
//      [RULE-220..229 | CON-120 | 04_INDICATOR_ARCHITECTURE.md §9]
//      Transitions only, never persistent states. Confirmed-bar by default.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

bool gateA = ready and (alertConfirmedOnly ? barstate.isconfirmed : true)

var int lastEvAlert = na
var int lastSuAlert = na
var int lastLcAlert = na
var int lastCxAlert = na

coolOk(int last) =>
    alertCooldown == 0 or na(last) or (bar_index - last) >= alertCooldown

bool aEvent = alEvents and gateA and anyEvent and coolOk(lastEvAlert)
if aEvent
    lastEvAlert := bar_index
bool aSetup = alSetups and gateA and (isSurge or isIgnite or isPullback or isDual or obEntryLong or
     obEntryShort or hiddenGreenShort or hiddenRedLong or gapTriggerUp or gapTriggerDn) and
     coolOk(lastSuAlert)
if aSetup
    lastSuAlert := bar_index
bool aLife = alLifecycle and gateA and (rise(lcActive) or addTrigger or stopMoved or lcCompleted or
     lcInvalidated) and coolOk(lastLcAlert)
if aLife
    lastLcAlert := bar_index
bool aCtx = alContext and gateA and (stateChanged or rise(anyExitContext) or rise(spaceExtreme)) and
     coolOk(lastCxAlert)
if aCtx
    lastCxAlert := bar_index

// ── Static alert conditions (messages must be const strings) ──────────────────────────────────
alertcondition(alEvents and gateA and rise(comboBull or comboBear), "Elephant + colour change",
     "VELEZ MAP: elephant bar AND colour change on one bar. Study tool - not a recommendation.")
alertcondition(alEvents and gateA and rise(isElephant), "Elephant bar",
     "VELEZ MAP: elephant bar (~approximate size threshold). Study tool - not a recommendation.")
alertcondition(alEvents and gateA and rise(isTail), "Tail bar",
     "VELEZ MAP: tail bar (bottoming or topping). Study tool - not a recommendation.")
alertcondition(alEvents and gateA and rise(isColourChange), "Colour change",
     "VELEZ MAP: colour change - one colour took out the BODY extreme of an opposite-coloured " +
     "bar. Study tool - not a recommendation.")
alertcondition(alEvents and gateA and rise(isTakeout), "Red / green bar takeout",
     "VELEZ MAP: little red/green bar takeout. Study tool - not a recommendation.")
alertcondition(alContext and gateA and stateChanged, "State change",
     "VELEZ MAP: market state changed (~approximate thresholds). Study tool.")
alertcondition(alContext and gateA and rise(narrowGrade == NG_G1), "Narrow grade 1 formed",
     "VELEZ MAP: grade-1 narrow state - all three items flat (~approximate flatness). Study tool.")
alertcondition(alSetups and gateA and rise(isSurge), "Surge off the 200",
     "VELEZ MAP: surge off a flat 200 with clear space to the left (~approximate). Study tool.")
alertcondition(alSetups and gateA and rise(isIgnite), "Igniting swing",
     "VELEZ MAP: igniting move out of a sleepy state (~approximate). Study tool.")
alertcondition(alSetups and gateA and rise(isPullback), "Pullback swing",
     "VELEZ MAP: pullback colour change at or near the 20 (~approximate). Study tool.")
alertcondition(alSetups and gateA and rise(obEntryLong or obEntryShort), "Opening-bell entry",
     "VELEZ MAP: opening-bell mark crossed. Every price was defined before the open. Study tool.")
alertcondition(alSetups and gateA and rise(hiddenGreenShort or hiddenRedLong), "Hidden green/red",
     "VELEZ MAP: hidden green/red erasure - BAR-CLOSE FORM ONLY. The source's intrabar erasure " +
     "instant is not observable at bar close. Study tool.")
alertcondition(alSetups and gateA and rise(isDual), "Dual space reversal",
     "VELEZ MAP: dual space reversal setup (~approximate). Study tool.")
alertcondition(alSetups and gateA and rise(gapTriggerUp or gapTriggerDn), "Gap-fill bar-two",
     "VELEZ MAP: gap-fill bar-two trigger. Study tool - not a recommendation.")
alertcondition(alSetups and gateA and rise(isDeepDrop), "Deep drop",
     "VELEZ MAP: deep drop past the halfway point (~approximate severity; confirmed later). " +
     "Study tool.")
alertcondition(alSetups and gateA and rise(lowerTop or higherBottom), "Market Law Four candidate",
     "VELEZ MAP: lower top / higher bottom (~approximate; confirmed later). Study tool.")
alertcondition(alSetups and gateA and rise(firstWarningDrop), "First warning drop",
     "VELEZ MAP: pullback deeper than any before it in this sequence (~approximate; confirmed " +
     "later). Study tool.")
alertcondition(alLifecycle and gateA and rise(lcActive), "Virtual entry",
     "VELEZ MAP: VIRTUAL methodology lifecycle opened. No order, no fill, no position. Study tool.")
alertcondition(alLifecycle and gateA and addTrigger, "Virtual add",
     "VELEZ MAP: VIRTUAL add - first colour change after entry (the source calls adding " +
     "mandatory). No order, no fill. Study tool.")
alertcondition(alLifecycle and gateA and stopMoved, "Virtual stop moved",
     "VELEZ MAP: VIRTUAL trailing reference rolled to a more protective level. Study tool.")
alertcondition(alLifecycle and gateA and lcCompleted, "Virtual stop-out",
     "VELEZ MAP: VIRTUAL lifecycle reached its stop reference. No fill is implied. Study tool.")
alertcondition(alContext and gateA and rise(exitThirdPush), "Exit context: third push",
     "VELEZ MAP: third push counted (~approximate; confirmed later). Study tool.")
alertcondition(alContext and gateA and rise(exitNarrowToWide), "Exit context: narrow to wide",
     "VELEZ MAP: state went narrow -> wide. The source calls this an exit signal by itself. " +
     "Study tool.")
alertcondition(alContext and gateA and rise(spaceExtreme), "Space extreme (pare context)",
     "VELEZ MAP: price-to-20 space at a historical extreme (~approximate). Study tool.")
alertcondition(alContext and gateA and rise(qScore >= 10), "Confluence: high quality or better",
     "VELEZ MAP: implementation-defined confluence reached HIGH QUALITY or better. This is NOT " +
     "a Velez taxonomy. Study tool - not a recommendation.")
alertcondition(alBlocked and gateA and anyEvent and not gatesPass, "Blocked candidate",
     "VELEZ MAP: a qualifying event was blocked by a gate. See Debug Mode for the reason. " +
     "Study tool.")

// ── Dynamic payload alert ─────────────────────────────────────────────────────────────────────
// Requires a TradingView alert created on "Any alert() function call".
if (aEvent or aSetup or aLife) and (anyEvent or lcCompleted or addTrigger)
    string msg = "VELEZ MAP | " + syminfo.ticker + " " + timeframe.period + " | " +
         (anyEvent ? ev.lbl : lc.exitReason) + " | dir=" +
         (candDir == DIR_LONG ? "L" : candDir == DIR_SHORT ? "S" : "-") + " | px=" +
         str.tostring(close, format.mintick) +
         "\nstate=" + stateName(state) + " " + gradeName(narrowGrade) + aMark(true) +
         " pos=" + str.tostring(pos) + aMark(true) + " trend=" +
         (trendDir == DIR_LONG ? "20 up" : trendDir == DIR_SHORT ? "20 down" : "20 flat") +
         "\nsetup=" + (isSurge ? "SURGE OFF 200" : isIgnite ? "IGNITE" :
              isPullback ? "PULLBACK" : "-") + " quality=" + qTier + " [impl]" +
         "\nstop=" + ((lcActive and not na(lc.stop)) ?
              str.tostring(lc.stop, format.mintick) + " " + stopMethodName(lc.stopMethod) : "-") +
         " fidelity=" + (strictOn ? "STRICT" : expOn ? "+EXPERIMENTAL" : "SOURCE+APPROX") +
         " confirm=" + (alertConfirmedOnly ? "CONFIRMED" : "PROVISIONAL") +
         "\nNOT A RECOMMENDATION - study tool. No order, no fill, no position, no performance " +
         "claim, no endorsement."
    alert(msg, alert.freq_once_per_bar_close)


