// ═══════════════════════════════════════════════════════════════════════════════
//  Trade Daddy — URANIUM BAND
//  Hunts for balance zones: price chopping around a centre point with enough
//  movement to matter. When the conditions line up it prints the window's high
//  and low as white rails over a dark green panel, extends the zone forward
//  while price stays in balance, and stops only after a confirmed break.
//    Inside the zone = chop. Fade the edges, smaller size, quicker profits.
//    Confirmed break = N closes outside; price tends to surge that way after.
//
//  While the zone is live the rails track the true high and low of the balance
//  region, so a wick or a single close outside widens the zone instead of
//  leaving a rail that no longer contains price. The moment a bar closes
//  outside, the rails lock and the break clock starts.
//
//  The panel is drawn BEHIND the chart (behind_chart = true) so it reads as a
//  solid background block with the candles sitting on top of it, not as a wash
//  over price. If your build ever rejects that argument, delete it — nothing
//  else depends on it.
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("Trade Daddy — Uranium Band", "Uranium Band", overlay = true,
     max_lines_count = 500, max_boxes_count = 200, behind_chart = true)

// ── Balance detection ────────────────────────────────────────────────────────
gBal     = "Balance detection"
winLen   = input.int(20, "Balance window (bars)", minval = 3, group = gBal)
persist  = input.int(8, "Bars balance must hold first", minval = 1, group = gBal,
     tooltip = "The window has to stay in balance this many bars in a row before the zone is drawn. This is the main control for how many zones you get — raise it if the chart is busy, lower it if it misses one.")
minRange = input.float(3.0,  "Min window range %", minval = 0.1, step = 0.1, group = gBal,
     tooltip = "Movement floor — the window has to actually travel to count as balance rather than a dead tape.")
maxRange = input.float(15.0, "Max window range %", minval = 0.5, step = 0.5, group = gBal,
     tooltip = "Movement ceiling — above this the window is a trend leg, not balance. A real consolidation on a liquid daily chart runs about 8-12 percent, so 15 keeps the tall ranges out.")
minTaps  = input.int(5, "Min centre crossings", minval = 1, group = gBal,
     tooltip = "How many times price has to cross the window's midpoint before it counts as chopping around a centre.")
atrLen   = input.int(14, "ATR length", minval = 1, group = gBal)
minAtr   = input.float(0.10, "Min bar range vs zone height", minval = 0, step = 0.01, group = gBal,
     tooltip = "Average bar range as a fraction of the zone's height. Filters out flat, dead windows that are technically 'in range' but have no movement in them.")
trackHL  = input.bool(true, "Rails track the zone's true high and low", group = gBal,
     tooltip = "On: while price stays in balance the rails widen to hold every wick, so they always mark the real edges of the range. Off: the rails stay frozen at the levels they were born with.")

// ── Spacing ──────────────────────────────────────────────────────────────────
gSpc     = "Spacing"
cooldown = input.int(30, "Cooldown bars after a zone ends", minval = 0, group = gSpc,
     tooltip = "Stops a fresh zone forming the moment the last one breaks.")
maxOver  = input.float(30, "Max overlap with the last zone %", minval = 0, maxval = 100, step = 5, group = gSpc,
     tooltip = "A new zone has to cover genuinely different prices than the one before it. Lower = stricter.")
keepOld  = input.int(25, "Historical zones kept", minval = 0, maxval = 150, group = gSpc,
     tooltip = "Older zones are deleted past this count.")

// ── Break confirmation ───────────────────────────────────────────────────────
gBrk     = "Break confirmation"
brkBars  = input.int(2, "Closes outside required", minval = 1, group = gBrk)
brkBuf   = input.float(0.0, "Break buffer % of zone", minval = 0, step = 0.1, group = gBrk)
extAfter = input.bool(false, "Keep projecting the rails after a break", group = gBrk,
     tooltip = "Off follows the rules — the zone stops where the break was confirmed. On leaves the rails running to the right as reference levels.")

// ── Style ────────────────────────────────────────────────────────────────────
gSty     = "Style"
edgeCol  = input.color(#FFFFFF, "Rails",  group = gSty, inline = "c1")
edgeWid  = input.int(2, "Width", minval = 1, maxval = 4, group = gSty, inline = "c1")
fillCol  = input.color(#0E3020, "Panel",  group = gSty, inline = "c2")
fillT    = input.int(0, "Transparency", minval = 0, maxval = 100, group = gSty, inline = "c2",
     tooltip = "0 is solid, which is how it should look — the panel sits behind the candles, so it fills in as a background block rather than shading price.")
showMid  = input.bool(false, "Show centre line", group = gSty)
recolour = input.bool(false, "Recolour the rails after a confirmed break", group = gSty,
     tooltip = "Off matches the reference charts — the rails stay white whichever way price leaves them.")
upCol    = input.color(#1B7F4B, "Broken up",   group = gSty, inline = "c3")
dnCol    = input.color(#8E2A3B, "Broken down", group = gSty, inline = "c3")

// ═════════════════════════════════════════════════════════════════════════════
//  WINDOW STATS
// ═════════════════════════════════════════════════════════════════════════════
atr       = ta.atr(atrLen)
winHi     = ta.highest(high, winLen)
winLo     = ta.lowest(low,   winLen)
winMid    = math.avg(winHi, winLo)
rangePct  = winMid != 0 ? (winHi - winLo) / winMid * 100 : 0.0
winH      = winHi - winLo
atrOk     = winH > 0 and atr / winH >= minAtr

// how many times price crossed the window midpoint inside the window
crossUp   = close > winMid and close[1] <= winMid
crossDn   = close < winMid and close[1] >= winMid
taps      = math.sum(crossUp ? 1 : 0, winLen) + math.sum(crossDn ? 1 : 0, winLen)

inBalance = rangePct >= minRange and rangePct <= maxRange and taps >= minTaps and atrOk

// balance has to hold for a few bars before it earns a zone
var int balRun = 0
balRun   := inBalance ? balRun + 1 : 0
isBalance = balRun >= persist

// ═════════════════════════════════════════════════════════════════════════════
//  ZONE STATE MACHINE — green panel, white rails top and bottom, no side borders
// ═════════════════════════════════════════════════════════════════════════════
var box   panel   = na
var line  railTop = na
var line  railBot = na
var line  railMid = na
var float bandHi  = na
var float bandLo  = na
var float prevHi  = na
var float prevLo  = na
var bool  active  = false
var int   outUp   = 0
var int   outDn   = 0
var int   lastEnd = -99999
var array<box>  oldPanels = array.new<box>()
var array<line> oldRails  = array.new<line>()

f_park(_l) =>
    if not na(_l)
        array.push(oldRails, _l)

f_trim() =>
    while array.size(oldRails) > keepOld * 3
        line.delete(array.shift(oldRails))
    while array.size(oldPanels) > keepOld
        box.delete(array.shift(oldPanels))

//  break test runs against the rails as they stand coming into this bar
buf       = na(bandHi) ? 0.0 : (bandHi - bandLo) * brkBuf / 100.0
brokeUp   = active and close > bandHi + buf
brokeDn   = active and close < bandLo - buf
outUp    := brokeUp ? outUp + 1 : 0
outDn    := brokeDn ? outDn + 1 : 0
confirmUp = active and outUp >= brkBars
confirmDn = active and outDn >= brkBars

if active
    if confirmUp or confirmDn
        // the zone stops where the break was confirmed
        if recolour
            brkCol = confirmUp ? upCol : dnCol
            line.set_color(railTop, brkCol)
            line.set_color(railBot, brkCol)
            if not na(railMid)
                line.set_color(railMid, color.new(brkCol, 35))
        if extAfter
            line.set_extend(railTop, extend.right)
            line.set_extend(railBot, extend.right)
        array.push(oldPanels, panel)
        f_park(railTop)
        f_park(railBot)
        f_park(railMid)
        f_trim()
        panel   := na
        railTop := na
        railBot := na
        railMid := na
        active  := false
        outUp   := 0
        outDn   := 0
        lastEnd := bar_index
        prevHi  := bandHi
        prevLo  := bandLo
    else
        // still in balance: hold every wick, but only while nothing has closed outside
        if trackHL and outUp == 0 and outDn == 0
            bandHi := math.max(bandHi, high)
            bandLo := math.min(bandLo, low)
            line.set_y1(railTop, bandHi)
            line.set_y2(railTop, bandHi)
            line.set_y1(railBot, bandLo)
            line.set_y2(railBot, bandLo)
            box.set_top(panel, bandHi)
            box.set_bottom(panel, bandLo)
            if not na(railMid)
                mid = math.avg(bandHi, bandLo)
                line.set_y1(railMid, mid)
                line.set_y2(railMid, mid)
        box.set_right(panel, bar_index + 1)
        line.set_x2(railTop, bar_index + 1)
        line.set_x2(railBot, bar_index + 1)
        if not na(railMid)
            line.set_x2(railMid, bar_index + 1)

// a new zone must clear the cooldown and cover different prices than the last one
ovLo      = na(prevHi) ? 0.0 : math.max(winLo, prevLo)
ovHi      = na(prevHi) ? 0.0 : math.min(winHi, prevHi)
overlap   = na(prevHi) or winH <= 0 ? 0.0 : math.max(0.0, ovHi - ovLo) / winH * 100.0
roomForIt = overlap <= maxOver and (bar_index - lastEnd) >= cooldown

if not active and isBalance and roomForIt and not confirmUp and not confirmDn and bar_index > winLen
    bandHi  := winHi
    bandLo  := winLo
    active  := true
    left     = bar_index - winLen + 1
    panel   := box.new(left, bandHi, bar_index + 1, bandLo, xloc = xloc.bar_index,
         border_width = 0, border_color = color.new(#000000, 100),
         bgcolor = color.new(fillCol, fillT))
    railTop := line.new(left, bandHi, bar_index + 1, bandHi, xloc = xloc.bar_index,
         color = edgeCol, width = edgeWid, style = line.style_solid)
    railBot := line.new(left, bandLo, bar_index + 1, bandLo, xloc = xloc.bar_index,
         color = edgeCol, width = edgeWid, style = line.style_solid)
    railMid := showMid ? line.new(left, math.avg(bandHi, bandLo), bar_index + 1,
         math.avg(bandHi, bandLo), xloc = xloc.bar_index,
         color = color.new(edgeCol, 35), style = line.style_dotted) : na

// ── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(confirmUp and not confirmUp[1], "Uranium break up",   "Uranium Band: confirmed break UP on {{ticker}}")
alertcondition(confirmDn and not confirmDn[1], "Uranium break down", "Uranium Band: confirmed break DOWN on {{ticker}}")
alertcondition(isBalance and not isBalance[1], "Balance detected",   "Uranium Band: balance zone forming on {{ticker}}")
