// ═══════════════════════════════════════════════════════════════════════════════
//  Trade Daddy — URANIUM BAND
//  Hunts for balance zones: price chopping around a centre point with enough
//  movement to matter. When the conditions line up it prints the window's high
//  and low as two horizontal rails (plus an optional centre line), extends them
//  forward while price stays in balance, and stops only after a confirmed break.
//    Inside the rails = chop. Fade the edges, smaller size, quicker profits.
//    Confirmed break  = N closes outside; price tends to surge that way after.
//    ★ cyan / magenta = the bar the break is confirmed
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("Trade Daddy — Uranium Band", "Uranium Band", overlay = true,
     max_lines_count = 500)

// ── Balance detection ────────────────────────────────────────────────────────
gBal     = "Balance detection"
winLen   = input.int(10, "Balance window (bars)", minval = 3, group = gBal)
minRange = input.float(3.0,  "Min window range %", minval = 0.1, step = 0.1, group = gBal,
     tooltip = "Movement floor — the window has to actually travel to count as balance rather than a dead tape.")
maxRange = input.float(25.0, "Max window range %", minval = 0.5, step = 0.5, group = gBal,
     tooltip = "Movement ceiling — above this the window is a trend leg, not balance.")
minTaps  = input.int(3, "Min centre crossings", minval = 1, group = gBal,
     tooltip = "How many times price has to cross the window's midpoint before it counts as chopping around a centre.")
atrLen   = input.int(14, "ATR length", minval = 1, group = gBal)
minAtr   = input.float(0.10, "Min bar range vs band height", minval = 0, step = 0.01, group = gBal,
     tooltip = "Average bar range as a fraction of the window's height. Filters out flat, dead windows that are technically 'in range' but have no movement in them.")

// ── Break confirmation ───────────────────────────────────────────────────────
gBrk     = "Break confirmation"
brkBars  = input.int(2, "Closes outside required", minval = 1, group = gBrk)
brkBuf   = input.float(0.0, "Break buffer % of band", minval = 0, step = 0.1, group = gBrk)
keepOld  = input.int(6, "Historical bands kept", minval = 0, maxval = 50, group = gBrk)
extAfter = input.bool(false, "Keep projecting the rails after a break", group = gBrk,
     tooltip = "Off follows the rules — the rails stop where the break was confirmed. On leaves them running to the right as reference levels.")

// ── Style ────────────────────────────────────────────────────────────────────
gSty     = "Style"
edgeCol  = input.color(#FFFFFF, "Rails",  group = gSty, inline = "c1")
edgeWid  = input.int(2, "Width", minval = 1, maxval = 4, group = gSty, inline = "c1")
showMid  = input.bool(false, "Show centre line", group = gSty)
recolour = input.bool(false, "Recolour the rails after a confirmed break", group = gSty,
     tooltip = "Off matches the reference charts — the rails stay white whichever way price leaves them.")
upCol    = input.color(#1B7F4B, "Broken up",   group = gSty, inline = "c3")
dnCol    = input.color(#8E2A3B, "Broken down", group = gSty, inline = "c3")

// ── Break markers ────────────────────────────────────────────────────────────
gMark    = "Break markers"
showBrk  = input.bool(true, "Mark confirmed breaks", group = gMark)
useTri   = input.bool(false, "Use triangles instead of stars", group = gMark)
starSz   = input.string("Tiny", "Star size", options = ["Tiny", "Small", "Normal"], group = gMark)
starOff  = input.float(1.2, "Star offset (ATR)", minval = 0, step = 0.1, group = gMark)
bullCol  = input.color(#00E5FF, "Break up ★",   group = gMark, inline = "sc")
bearCol  = input.color(#FF00E0, "Break down ★", group = gMark, inline = "sc")

// ═════════════════════════════════════════════════════════════════════════════
//  WINDOW STATS
// ═════════════════════════════════════════════════════════════════════════════
atr       = ta.atr(atrLen)
winHi     = ta.highest(high, winLen)
winLo     = ta.lowest(low,   winLen)
winMid    = math.avg(winHi, winLo)
rangePct  = winMid != 0 ? (winHi - winLo) / winMid * 100 : 0.0
bandH     = winHi - winLo
atrOk     = bandH > 0 and atr / bandH >= minAtr

// how many times price crossed the window midpoint inside the window
crossUp   = close > winMid and close[1] <= winMid
crossDn   = close < winMid and close[1] >= winMid
taps      = math.sum(crossUp ? 1 : 0, winLen) + math.sum(crossDn ? 1 : 0, winLen)

isBalance = rangePct >= minRange and rangePct <= maxRange and taps >= minTaps and atrOk

// ═════════════════════════════════════════════════════════════════════════════
//  RAIL STATE MACHINE — two horizontal lines, never a box
// ═════════════════════════════════════════════════════════════════════════════
var line  railTop = na
var line  railBot = na
var line  railMid = na
var float bandHi  = na
var float bandLo  = na
var bool  active  = false
var int   outUp   = 0
var int   outDn   = 0
var array<line> oldRails = array.new<line>()

f_park(_l) =>
    if not na(_l)
        array.push(oldRails, _l)

f_trim() =>
    while array.size(oldRails) > keepOld * 3
        line.delete(array.shift(oldRails))

buf       = na(bandHi) ? 0.0 : (bandHi - bandLo) * brkBuf / 100.0
brokeUp   = active and close > bandHi + buf
brokeDn   = active and close < bandLo - buf
outUp    := brokeUp ? outUp + 1 : 0
outDn    := brokeDn ? outDn + 1 : 0
confirmUp = active and outUp >= brkBars
confirmDn = active and outDn >= brkBars

if active
    if confirmUp or confirmDn
        // the rails stop where the break was confirmed
        if recolour
            brkCol = confirmUp ? upCol : dnCol
            line.set_color(railTop, brkCol)
            line.set_color(railBot, brkCol)
            if not na(railMid)
                line.set_color(railMid, color.new(brkCol, 35))
        if extAfter
            line.set_extend(railTop, extend.right)
            line.set_extend(railBot, extend.right)
        f_park(railTop)
        f_park(railBot)
        f_park(railMid)
        f_trim()
        railTop := na
        railBot := na
        railMid := na
        active  := false
        outUp   := 0
        outDn   := 0
    else
        line.set_x2(railTop, bar_index + 1)
        line.set_x2(railBot, bar_index + 1)
        if not na(railMid)
            line.set_x2(railMid, bar_index + 1)

if not active and isBalance and not confirmUp and not confirmDn and bar_index > winLen
    bandHi  := winHi
    bandLo  := winLo
    active  := true
    left     = bar_index - winLen + 1
    railTop := line.new(left, bandHi, bar_index + 1, bandHi, xloc = xloc.bar_index,
         color = edgeCol, width = edgeWid, style = line.style_solid)
    railBot := line.new(left, bandLo, bar_index + 1, bandLo, xloc = xloc.bar_index,
         color = edgeCol, width = edgeWid, style = line.style_solid)
    railMid := showMid ? line.new(left, math.avg(bandHi, bandLo), bar_index + 1,
         math.avg(bandHi, bandLo), xloc = xloc.bar_index,
         color = color.new(edgeCol, 35), style = line.style_dotted) : na

// ── Break markers: stars, matching the rest of the suite ─────────────────────
brkUp    = showBrk and confirmUp and not confirmUp[1]
brkDn    = showBrk and confirmDn and not confirmDn[1]
bullY    = low  - atr * starOff
bearY    = high + atr * starOff
starOn   = not useTri
szT      = starSz == "Tiny"
szS      = starSz == "Small"
szN      = starSz == "Normal"

plotchar(starOn and szT and brkUp ? bullY : na, "Break ★ up (tiny)",     "★", location.absolute, bullCol, size = size.tiny)
plotchar(starOn and szS and brkUp ? bullY : na, "Break ★ up (small)",    "★", location.absolute, bullCol, size = size.small)
plotchar(starOn and szN and brkUp ? bullY : na, "Break ★ up (normal)",   "★", location.absolute, bullCol, size = size.normal)
plotchar(starOn and szT and brkDn ? bearY : na, "Break ★ down (tiny)",   "★", location.absolute, bearCol, size = size.tiny)
plotchar(starOn and szS and brkDn ? bearY : na, "Break ★ down (small)",  "★", location.absolute, bearCol, size = size.small)
plotchar(starOn and szN and brkDn ? bearY : na, "Break ★ down (normal)", "★", location.absolute, bearCol, size = size.normal)

plotshape(useTri and brkUp, "Break ▲", shape.triangleup,   location.belowbar, bullCol, size = size.tiny)
plotshape(useTri and brkDn, "Break ▼", shape.triangledown, location.abovebar, bearCol, size = size.tiny)

// ── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(confirmUp and not confirmUp[1], "Uranium break up",   "Uranium Band: confirmed break UP on {{ticker}}")
alertcondition(confirmDn and not confirmDn[1], "Uranium break down", "Uranium Band: confirmed break DOWN on {{ticker}}")
alertcondition(isBalance and not isBalance[1], "Balance detected",   "Uranium Band: balance zone forming on {{ticker}}")
