// ═══════════════════════════════════════════════════════════════════════════════
//  Trade Daddy — URANIUM BAND
//  Hunts for balance zones: price chopping around a centre point with enough
//  movement to matter. When the conditions line up it prints the window's high
//  and low as white rails over a dark green panel, extends the zone forward
//  while price stays in balance, and stops only after a confirmed break.
//    Inside the zone = chop. Fade the edges, smaller size, quicker profits.
//    Confirmed break = N closes outside; price tends to surge that way after.
//
//  While the zone is live the rails track the true high and low of the balance
//  region, so a wick or a single close outside widens the zone instead of
//  leaving a rail that no longer contains price. The moment a bar closes
//  outside, the rails lock and the break clock starts.
//
//  The panel is drawn BEHIND the chart (behind_chart = true) so it reads as a
//  solid background block with the candles sitting on top of it. If the zone
//  disappears on mouse-over, that flag is the suspect — set it to false below,
//  or turn off "Draw the green panel" in Style. See the README.
//
//  THE LAST LINE OF THIS FILE IS AN alertcondition(). If it is not, the paste
//  was cut short — that is what produces "an indicator must contain at least
//  one of the following" (CE10246).
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("Uranium Band", overlay = true,
     max_lines_count = 500, max_boxes_count = 200, max_bars_back = 1000,
     behind_chart = true)

// ── Balance detection ────────────────────────────────────────────────────────
gBal     = "Balance detection"
winLen   = input.int(14, "Balance window (bars)", minval = 3, group = gBal,
     tooltip = "The window that has to qualify as balance. Keep it well under the length of the consolidations you want caught — the zone itself is stretched back to the real start afterwards, so this does not set the zone's width.")
persist  = input.int(3, "Bars balance must hold first", minval = 1, group = gBal,
     tooltip = "How many bars in a row the window must qualify before a zone is drawn. The main dial for how many zones you get: raise it if the chart is busy, lower it if it misses one.")
sizeMode = input.string("ATR multiples", "Balance size measured in",
     options = ["ATR multiples", "Percent of price"], group = gBal,
     tooltip = "ATR multiples travel across timeframes and symbols, because the yardstick is the symbol's own bar range. Percent of price does not — a percentage tuned on daily charts rejects nearly every weekly consolidation. Use percent only if you want a hard price-based ceiling.")
minAtrR  = input.float(1.0, "Min window range (ATR)", minval = 0.1, step = 0.1, group = gBal, inline = "ar",
     tooltip = "Movement floor and ceiling in ATR multiples. Over a 14-bar window price walks a path of roughly 14 ATR, so a span of only 2-4 ATR means heavy overlap — balance. Approaching 7+ means price kept going one way, which is a trend leg.")
maxAtrR  = input.float(7.0, "max", minval = 0.5, step = 0.5, group = gBal, inline = "ar")
minRange = input.float(2.5,  "Min window range %", minval = 0.1, step = 0.1, group = gBal, inline = "pr",
     tooltip = "Only used by 'Percent of price' mode. The ceiling is 45: a lower one is measured on daily charts and rejects weekly consolidations.")
maxRange = input.float(45.0, "max", minval = 0.5, step = 0.5, group = gBal, inline = "pr")
minTaps  = input.int(4, "Min centre crossings", minval = 1, group = gBal,
     tooltip = "How many times price has to cross the window's midpoint before it counts as chopping around a centre.")
atrLen   = input.int(14, "ATR length", minval = 1, group = gBal)
minAtr   = input.float(0.10, "Min bar range vs zone height", minval = 0, step = 0.01, group = gBal,
     tooltip = "Average bar range as a fraction of the zone's height. Filters out flat, dead windows that are technically 'in range' but have no movement in them.")
maxBack  = input.int(30, "Max bars to stretch a zone back", minval = 5, maxval = 500, group = gBal,
     tooltip = "When a zone is born it walks backwards over the bars that still fit inside the rails, so the zone covers the consolidation from where it actually started rather than from where it was detected.")
maxGrow  = input.float(1.10, "Zone may grow to × its birth height", minval = 1.0, maxval = 3.0, step = 0.05, group = gBal,
     tooltip = "The hard cap on how far a zone may widen, both while walking backwards and while the rails track new wicks. Without a cap the rails only ever widen, which makes a break less likely, which permits more widening — a ratchet. 1.10 keeps a zone honest to the range it was born in.")
trackHL  = input.bool(true, "Rails track the zone's true high and low", group = gBal,
     tooltip = "On: while price stays in balance the rails widen to hold every wick, so they always mark the real edges of the range. Off: the rails stay frozen at the levels they were born with.")

// ── Spacing ──────────────────────────────────────────────────────────────────
gSpc     = "Spacing"
cooldown = input.int(8, "Cooldown bars after a zone ends", minval = 0, group = gSpc,
     tooltip = "Stops a fresh zone forming the moment the last one breaks. Count it in bars of your chart's timeframe: 25 is five weeks on a daily but six months on a weekly.")
maxOver  = input.float(65, "Max overlap with the last zone %", minval = 0, maxval = 100, step = 5, group = gSpc,
     tooltip = "A new zone has to cover genuinely different prices than the one before it. Lower = stricter. Too strict and a broken range that price works back into gets thrown away, though it is a legitimate new zone.")
keepOld  = input.int(25, "Historical zones kept", minval = 0, maxval = 150, group = gSpc,
     tooltip = "Older zones are deleted past this count.")

// ── Break confirmation ───────────────────────────────────────────────────────
gBrk     = "Break confirmation"
brkBars  = input.int(2, "Closes outside required", minval = 1, group = gBrk)
brkBuf   = input.float(0.0, "Break buffer % of zone", minval = 0, step = 0.1, group = gBrk)
useVol   = input.bool(false, "Break needs above-average volume", group = gBrk, inline = "v",
     tooltip = "A leaving candle should carry participation. Off by default so the zone behaviour matches what the reference charts print; on makes breaks rarer and cleaner.")
volLen   = input.int(20, "len", minval = 1, group = gBrk, inline = "v")
volMult  = input.float(1.0, "×", minval = 0.1, step = 0.1, group = gBrk, inline = "v")
extAfter = input.bool(false, "Keep projecting the rails after a break", group = gBrk,
     tooltip = "Off follows the rules — the zone stops where the break was confirmed. On leaves the rails running to the right as reference levels.")

// ── Style ────────────────────────────────────────────────────────────────────
gSty     = "Style"
edgeCol  = input.color(#FFFFFF, "Rails",  group = gSty, inline = "c1")
edgeWid  = input.int(2, "Width", minval = 1, maxval = 4, group = gSty, inline = "c1")
showPanel= input.bool(true, "Draw the green panel", group = gSty,
     tooltip = "Off leaves the white rails and centre line on their own. The fallback if the panel misbehaves on your build: rails are ordinary foreground drawings and do not use the behind-chart layer.")
fillCol  = input.color(#0E3020, "Panel",  group = gSty, inline = "c2")
fillT    = input.int(0, "Transparency", minval = 0, maxval = 100, group = gSty, inline = "c2",
     tooltip = "0 is solid, which is how it should look — the panel sits behind the candles, so it fills in as a background block rather than shading price.")
showMid  = input.bool(true, "Show centre line", group = gSty,
     tooltip = "The dashed mean-value line through the middle of the zone, as on the reference charts.")
recolour = input.bool(false, "Recolour the rails after a confirmed break", group = gSty,
     tooltip = "Off matches the reference charts — the rails stay white whichever way price leaves them.")
upCol    = input.color(#1B7F4B, "Broken up",   group = gSty, inline = "c3")
dnCol    = input.color(#8E2A3B, "Broken down", group = gSty, inline = "c3")

// ═════════════════════════════════════════════════════════════════════════════
//  WINDOW STATS
// ═════════════════════════════════════════════════════════════════════════════
atr       = ta.atr(atrLen)
winHi     = ta.highest(high, winLen)
winLo     = ta.lowest(low,   winLen)
winMid    = math.avg(winHi, winLo)
rangePct  = winMid != 0 ? (winHi - winLo) / winMid * 100 : 0.0
winH      = winHi - winLo
atrOk     = winH > 0 and atr / winH >= minAtr

// how many times price crossed the window midpoint inside the window
crossUp   = close > winMid and close[1] <= winMid
crossDn   = close < winMid and close[1] >= winMid
taps      = math.sum(crossUp ? 1 : 0, winLen) + math.sum(crossDn ? 1 : 0, winLen)

//  the size gate, in whichever unit is selected
useAtrSz  = sizeMode == "ATR multiples"
rangeAtr  = atr > 0 ? winH / atr : 0.0
sizeOk    = useAtrSz ? rangeAtr >= minAtrR and rangeAtr <= maxAtrR
     : rangePct >= minRange and rangePct <= maxRange

inBalance = sizeOk and taps >= minTaps and atrOk

// balance has to hold for a few bars before it earns a zone
var int balRun = 0
balRun   := inBalance ? balRun + 1 : 0
isBalance = balRun >= persist

// ═════════════════════════════════════════════════════════════════════════════
//  ZONE STATE MACHINE — green panel, white rails top and bottom, no side borders
// ═════════════════════════════════════════════════════════════════════════════
var box   panel   = na
var line  railTop = na
var line  railBot = na
var line  railMid = na
var float bandHi  = na
var float bandLo  = na
var float birthH  = na            // the height the zone was born with; caps all growth
var float prevHi  = na
var float prevLo  = na
var bool  active  = false
var int   outUp   = 0
var int   outDn   = 0
var int   lastEnd = -99999
var array<box>  oldPanels = array.new<box>()
var array<line> oldRails  = array.new<line>()

f_park(_l) =>
    if not na(_l)
        array.push(oldRails, _l)

//  Each finished zone parks three rails when the centre line is on and two when
//  it is off. Trimming on a fixed multiple of three would let the panels hit
//  their limit first and leave the rails of already-deleted zones stranded on
//  the chart, so the rail budget has to track what is actually parked.
railsPer = showMid ? 3 : 2

f_trim() =>
    while array.size(oldRails) > keepOld * railsPer
        line.delete(array.shift(oldRails))
    while array.size(oldPanels) > keepOld
        box.delete(array.shift(oldPanels))

//  break test runs against the rails as they stand coming into this bar
volAvg    = ta.sma(nz(volume), volLen)
volOk     = not useVol or nz(volume) > volAvg * volMult
buf       = na(bandHi) ? 0.0 : (bandHi - bandLo) * brkBuf / 100.0
brokeUp   = active and close > bandHi + buf
brokeDn   = active and close < bandLo - buf
outUp    := brokeUp ? outUp + 1 : 0
outDn    := brokeDn ? outDn + 1 : 0
confirmUp = active and outUp >= brkBars and volOk
confirmDn = active and outDn >= brkBars and volOk

if active
    if confirmUp or confirmDn
        // the zone stops where the break was confirmed
        if recolour
            brkCol = confirmUp ? upCol : dnCol
            line.set_color(railTop, brkCol)
            line.set_color(railBot, brkCol)
            if not na(railMid)
                line.set_color(railMid, color.new(brkCol, 35))
        if extAfter
            line.set_extend(railTop, extend.right)
            line.set_extend(railBot, extend.right)
        if not na(panel)
            array.push(oldPanels, panel)
        f_park(railTop)
        f_park(railBot)
        f_park(railMid)
        f_trim()
        panel   := na
        railTop := na
        railBot := na
        railMid := na
        active  := false
        outUp   := 0
        outDn   := 0
        lastEnd := bar_index
        prevHi  := bandHi
        prevLo  := bandLo
    else
        // Still in balance: hold every wick, but only while nothing has closed
        // outside AND only while the zone stays inside its growth cap. The cap
        // is what stops the ratchet — rails that only widen make a break ever
        // less likely, which licenses more widening.
        newHi = math.max(bandHi, high)
        newLo = math.min(bandLo, low)
        if trackHL and outUp == 0 and outDn == 0 and newHi - newLo <= birthH * maxGrow
            bandHi := newHi
            bandLo := newLo
            line.set_y1(railTop, bandHi)
            line.set_y2(railTop, bandHi)
            line.set_y1(railBot, bandLo)
            line.set_y2(railBot, bandLo)
            if not na(panel)
                box.set_top(panel, bandHi)
                box.set_bottom(panel, bandLo)
            if not na(railMid)
                mid = math.avg(bandHi, bandLo)
                line.set_y1(railMid, mid)
                line.set_y2(railMid, mid)
        if not na(panel)
            box.set_right(panel, bar_index + 1)
        line.set_x2(railTop, bar_index + 1)
        line.set_x2(railBot, bar_index + 1)
        if not na(railMid)
            line.set_x2(railMid, bar_index + 1)

// a new zone must clear the cooldown and cover different prices than the last one
ovLo      = na(prevHi) ? 0.0 : math.max(winLo, prevLo)
ovHi      = na(prevHi) ? 0.0 : math.min(winHi, prevHi)
overlap   = na(prevHi) or winH <= 0 ? 0.0 : math.max(0.0, ovHi - ovLo) / winH * 100.0
roomForIt = overlap <= maxOver and (bar_index - lastEnd) >= cooldown

if not active and isBalance and roomForIt and not confirmUp and not confirmDn and bar_index > winLen
    bandHi  := winHi
    bandLo  := winLo
    birthH  := winHi - winLo
    active  := true
    //  walk back over the consolidation, letting the rails grow to hold each bar
    //  for as long as the whole range still reads as balance. This is what puts
    //  the zone's left edge and its rails on the real range rather than on the
    //  window that happened to trip the filters.
    back     = winLen - 1
    for i = winLen to math.max(winLen, maxBack)
        h2  = math.max(bandHi, nz(high[i], bandHi))
        l2  = math.min(bandLo, nz(low[i],  bandLo))
        mid2 = math.avg(h2, l2)
        //  The walk stops the moment a bar would push the rails past the growth
        //  cap. It used to stop on the detection ceiling instead — but that is a
        //  test on a 14-bar window, and applying it to a 120-bar walk let one
        //  zone swallow the entire chart.
        if na(high[i]) or mid2 <= 0 or h2 - l2 > birthH * maxGrow
            break
        else
            bandHi := h2
            bandLo := l2
            back   := i
    left     = bar_index - back
    panel   := showPanel ? box.new(left, bandHi, bar_index + 1, bandLo, xloc = xloc.bar_index,
         border_width = 0, border_color = color.new(#000000, 100),
         bgcolor = color.new(fillCol, fillT)) : na
    railTop := line.new(left, bandHi, bar_index + 1, bandHi, xloc = xloc.bar_index,
         color = edgeCol, width = edgeWid, style = line.style_solid)
    railBot := line.new(left, bandLo, bar_index + 1, bandLo, xloc = xloc.bar_index,
         color = edgeCol, width = edgeWid, style = line.style_solid)
    railMid := showMid ? line.new(left, math.avg(bandHi, bandLo), bar_index + 1,
         math.avg(bandHi, bandLo), xloc = xloc.bar_index,
         color = color.new(edgeCol, 25), style = line.style_dashed) : na

// ── Readout ──────────────────────────────────────────────────────────────────
//  The zone's rails as numbers in the Data Window. display.data_window keeps
//  them off the chart and out of the price scale, so they cost nothing visually.
//  They are also a top-level plot, which means this script satisfies Pine's
//  "an indicator must produce something" rule (CE10246) on its own, without
//  depending on a drawing that only happens inside a conditional.
plot(active ? bandHi : na, "Zone high",   display = display.data_window)
plot(active ? bandLo : na, "Zone low",    display = display.data_window)
plot(active ? math.avg(bandHi, bandLo) : na, "Zone centre", display = display.data_window)

// ── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(confirmUp and not confirmUp[1], "Uranium break up",   "Uranium Band: confirmed break UP on {{ticker}}")
alertcondition(confirmDn and not confirmDn[1], "Uranium break down", "Uranium Band: confirmed break DOWN on {{ticker}}")
alertcondition(isBalance and not isBalance[1], "Balance detected",   "Uranium Band: balance zone forming on {{ticker}}")
