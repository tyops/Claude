// ═══════════════════════════════════════════════════════════════════════════════
//  ThetaDaddy — REGIME VOLUME   ·   companion pane   (4 of 4)
//  The gold / gray volume histogram from the layout. Same regime state machine as
//  Carbon Structure, so the volume bars always agree with the candles.
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("ThetaDaddy — Regime Volume", "Vol", overlay = false, format = format.volume)

vwapLen  = input.int(50, "VWAP length (Control Line)", minval = 1)
regMaLen = input.int(50, "Regime trend MA length",     minval = 1)
regSlope = input.int(5,  "Trend slope lookback",       minval = 1)
volLen   = input.int(20, "Volume average length",      minval = 1)
regVolML = input.float(1.0, "Volume participation multiple", minval = 0.1, step = 0.1)
goldCol  = input.color(#C9A227, "Bull (gold)", inline = "c")
grayCol  = input.color(#9AA0A6, "Bear (gray)", inline = "c")
showAvg  = input.bool(true, "Show volume average")

vol      = nz(volume)
volSum   = math.sum(vol, vwapLen)
control  = volSum > 0 ? math.sum(hlc3 * vol, vwapLen) / volSum : ta.ema(hlc3, vwapLen)
regMa    = ta.ema(close, regMaLen)
maRising = regMa > regMa[regSlope]
volFast  = ta.ema(vol, math.max(1, int(volLen / 2)))
volBase  = ta.sma(vol, volLen)
volSup   = volFast > volBase * regVolML
obvSlope = ta.obv - ta.obv[regSlope]

bullTrig = close > regMa and close > control and maRising and (volSup or obvSlope > 0)
bearTrig = close < regMa and close < control and not maRising and (obvSlope < 0 or not volSup)

var bool goldRegime = false
goldRegime := bullTrig ? true : bearTrig ? false : goldRegime

plot(vol, "Volume", color = color.new(goldRegime ? goldCol : grayCol, 15), style = plot.style_columns)
plot(showAvg ? volBase : na, "Average", color = color.new(#B0B3B8, 30))
