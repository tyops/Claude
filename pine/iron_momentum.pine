// ═══════════════════════════════════════════════════════════════════════════════
//  ── PANE ───────────────────────────────────────────────────────────────────
//  Sub-pane indicator. If it lands on the price pane, remove it, open a NEW
//  Pine Editor tab, paste, then Add to chart.
// ═══════════════════════════════════════════════════════════════════════════════
//  IRON MOMENTUM
//  A momentum throttle. It expands when momentum runs and tightens to a waist
//  when conditions go quiet. Gold shading means buyers have control of momentum,
//  iron-grey means sellers do.
//    ★ cyan    = momentum flips into bullish control
//    ★ magenta = momentum flips into bearish control
//  Best flips: squeezed, then releasing. Worst: already wide and fading.
//
//  Default engine is the squeeze-momentum construction — a linear regression of
//  price against its own range midpoint, with Bollinger Bands measured inside
//  Keltner Channels to detect the squeeze. Three things point at it: the
//  predecessor charts run SQZMOM_LB (20, 2, 20, 1.5) in this pane, an
//  independent teardown of the suite guessed the same BB-inside-KC construction,
//  and "expands during impulse, contracts during chop" is a description of a
//  squeeze indicator rather than a MACD.
//
//  When the squeeze is ON the market is coiled — that is the compression this
//  reads, measured directly rather than inferred from band width.
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("Iron Momentum", overlay = false)

// ── Engine ───────────────────────────────────────────────────────────────────
gMom     = "Engine"
mode     = input.string("Squeeze momentum", "Engine",
     options = ["Squeeze momentum", "MACD (chart)", "MACD (higher timeframe)", "Hull deviation"],
     group = gMom,
     tooltip = "Squeeze momentum is the best-supported construction. The MACD options follow CM_Ult_MacD_MTF, which also sits in this pane on the older charts — chart resolution is its own default. Hull deviation is the alternative reading.")
src      = input.source(close, "Source", group = gMom)
smooth   = input.int(1,  "Line smoothing", minval = 1, group = gMom,
     tooltip = "1 leaves the engine raw. Raise it only to calm a jagged pane.")
baseLen  = input.int(9,  "Baseline length", minval = 1, group = gMom,
     tooltip = "The slower line the throttle is measured against. Their gap is the band.")
bandMlt  = input.float(1.0, "Band width ×", minval = 0.1, step = 0.1, group = gMom)

// ── Squeeze momentum ─────────────────────────────────────────────────────────
gSqz     = "Squeeze momentum"
bbLen    = input.int(20, "Bollinger length", minval = 2, group = gSqz, inline = "bb")
bbMult   = input.float(2.0, "deviations", minval = 0.1, step = 0.1, group = gSqz, inline = "bb")
kcLen    = input.int(20, "Keltner length", minval = 2, group = gSqz, inline = "kc")
kcMult   = input.float(1.5, "multiple", minval = 0.1, step = 0.1, group = gSqz, inline = "kc",
     tooltip = "20 / 2 / 20 / 1.5 are the values the predecessor charts run.")
useTR    = input.bool(true, "Use true range for the Keltner width", group = gSqz)
showSqz  = input.bool(true, "Mark the squeeze on the zero line", group = gSqz,
     tooltip = "A dot for every bar the Bollinger Bands sit inside the Keltner Channels — the market coiled and waiting.")

// ── MACD modes ───────────────────────────────────────────────────────────────
gMacd    = "MACD modes"
fastLen  = input.int(12, "MACD fast",  minval = 1, group = gMacd, inline = "m")
slowLen  = input.int(26, "slow",       minval = 1, group = gMacd, inline = "m")
sigLen   = input.int(9,  "signal",     minval = 1, group = gMacd, inline = "m")
htfAuto  = input.bool(true, "Higher timeframe: one step up", group = gMacd,
     tooltip = "Only used by the higher-timeframe MACD mode. Intraday steps to daily, daily to weekly, weekly to monthly.")
htfCust  = input.timeframe("W", "Custom resolution", group = gMacd)

// ── Hull mode ────────────────────────────────────────────────────────────────
gHull    = "Hull mode"
hullLen  = input.int(55, "Hull length", minval = 1, group = gHull)
hullType = input.string("HMA", "Hull type", options = ["HMA", "EHMA", "THMA"], group = gHull)

// ── Floor ────────────────────────────────────────────────────────────────────
gFloor   = "Floor"
atrLen   = input.int(14, "ATR length", minval = 1, group = gFloor)
bandMin  = input.float(0.05, "Min half-width (% of ATR)", minval = 0, step = 0.05, group = gFloor)
pinchPct = input.int(25, "Compression percentile", minval = 1, maxval = 99, group = gFloor,
     tooltip = "Used by the non-squeeze engines, which have no squeeze state of their own to read.")
sqzLook  = input.int(100, "Compression lookback", minval = 10, group = gFloor)

// ── Style ────────────────────────────────────────────────────────────────────
gSty     = "Style"
goldCol  = input.color(#C9A227, "Buyers in control",  group = gSty, inline = "c")
ironCol  = input.color(#7C8794, "Sellers in control", group = gSty, inline = "c")
bandT    = input.int(30, "Band transparency", minval = 0, maxval = 100, group = gSty)
showBase = input.bool(true, "Show baseline", group = gSty)

// ── Stars ────────────────────────────────────────────────────────────────────
gStar    = "Stars"
showStar = input.bool(true, "Show stars", group = gStar)
starSz   = input.string("Tiny", "Star size", options = ["Tiny", "Small", "Normal"], group = gStar)
starGap  = input.float(0.6, "Star gap below the band (× half-width)", minval = 0, step = 0.1, group = gStar)
bullCol  = input.color(#00E5FF, "Bull ★", group = gStar, inline = "sc")
bearCol  = input.color(#FF00E0, "Bear ★", group = gStar, inline = "sc")

// ── Helper ───────────────────────────────────────────────────────────────────
f_hull(_src, _len, _type) =>
    half  = math.max(1, int(_len / 2))
    third = math.max(1, int(_len / 3))
    root  = math.max(1, int(math.round(math.sqrt(_len))))
    hma   = ta.wma(2 * ta.wma(_src, half) - ta.wma(_src, _len), root)
    ehma  = ta.ema(2 * ta.ema(_src, half) - ta.ema(_src, _len), root)
    thma  = ta.wma(ta.wma(_src, third) * 3 - ta.wma(_src, half) - ta.wma(_src, _len), _len)
    _type == "EHMA" ? ehma : _type == "THMA" ? thma : hma

// ═════════════════════════════════════════════════════════════════════════════
//  SQUEEZE MOMENTUM — Bollinger Bands measured inside Keltner Channels
// ═════════════════════════════════════════════════════════════════════════════
atr      = ta.atr(atrLen)
bbBasis  = ta.sma(src, bbLen)
bbDev    = bbMult * ta.stdev(src, bbLen)
upBB     = bbBasis + bbDev
loBB     = bbBasis - bbDev

kcBasis  = ta.sma(src, kcLen)
kcRange  = useTR ? ta.tr : high - low
kcWidth  = ta.sma(kcRange, kcLen)
upKC     = kcBasis + kcWidth * kcMult
loKC     = kcBasis - kcWidth * kcMult

sqzOn    = loBB > loKC and upBB < upKC     // coiled
sqzOff   = loBB < loKC and upBB > upKC     // released

//  price against the midpoint of its own range, straightened by a regression
midRange = math.avg(math.avg(ta.highest(high, kcLen), ta.lowest(low, kcLen)), ta.sma(close, kcLen))
sqzVal   = ta.linreg(src - midRange, kcLen, 0)
sqzOsc   = ta.ema(sqzVal, smooth)
sqzBase  = ta.ema(sqzOsc, baseLen)

// ═════════════════════════════════════════════════════════════════════════════
//  OTHER ENGINES — all run every bar, the mode picks between finished values
// ═════════════════════════════════════════════════════════════════════════════
[macdLine, macdSig, macdHist] = ta.macd(src, fastLen, slowLen, sigLen)
macdOsc  = ta.ema(macdLine, smooth)
macdBase = ta.ema(macdSig,  smooth)

htfStep  = timeframe.isintraday ? "D" : timeframe.isdaily ? "W" : timeframe.isweekly ? "M" : "12M"
htfRes   = htfAuto ? htfStep : htfCust
[mtfLine, mtfSig, mtfHist] = request.security(syminfo.tickerid, htfRes,
     ta.macd(src, fastLen, slowLen, sigLen), lookahead = barmerge.lookahead_off)
mtfOsc   = ta.ema(mtfLine, smooth)
mtfBase  = ta.ema(mtfSig,  smooth)

hull     = f_hull(src, hullLen, hullType)
hullOsc  = ta.ema(src - hull, smooth)
hullBase = ta.ema(hullOsc, baseLen)

useSqz   = mode == "Squeeze momentum"
useMtf   = mode == "MACD (higher timeframe)"
useHull  = mode == "Hull deviation"
throttle = useSqz ? sqzOsc  : useHull ? hullOsc  : useMtf ? mtfOsc  : macdOsc
baseline = useSqz ? sqzBase : useHull ? hullBase : useMtf ? mtfBase : macdBase

// ═════════════════════════════════════════════════════════════════════════════
spread   = math.abs(throttle - baseline)
half     = math.max(spread * bandMlt, atr * bandMin)
upper    = baseline + half
lower    = baseline - half

hiW      = ta.highest(half, sqzLook)
loW      = ta.lowest(half,  sqzLook)
widthRnk = hiW - loW > 0 ? (half - loW) / (hiW - loW) * 100 : 50.0
//  the squeeze engine knows it is compressed; the others have to infer it
pinched  = useSqz ? sqzOn : widthRnk < pinchPct

bullMom  = throttle > baseline
bandCol  = bullMom ? goldCol : ironCol

pUp = plot(upper, "Band upper", color = color.new(bandCol, math.min(99, bandT + 30)), linewidth = 1)
pDn = plot(lower, "Band lower", color = color.new(bandCol, math.min(99, bandT + 30)), linewidth = 1)
fill(pUp, pDn, color = color.new(bandCol, pinched ? math.min(99, bandT + 15) : bandT), title = "Iron band")
plot(showBase ? baseline : na, "Baseline", color = color.new(#C4C9D0, 25), linewidth = 1)
plot(0, "Zero", color = color.new(color.gray, 55))
plotchar(showSqz and useSqz and sqzOn ? 0 : na, "Squeeze on", "•", location.absolute,
     color.new(#C4C9D0, 20), size = size.tiny, display = display.pane)

// ── Stars: the bar control flips ─────────────────────────────────────────────
bullStar = bullMom and not bullMom[1]
bearStar = not bullMom and bullMom[1]
starY    = lower - half * starGap
szT      = starSz == "Tiny"
szS      = starSz == "Small"
szN      = starSz == "Normal"

plotchar(showStar and szT and bullStar ? starY : na, "Bull ★ (tiny)",   "★", location.absolute, bullCol, size = size.tiny, display = display.pane)
plotchar(showStar and szS and bullStar ? starY : na, "Bull ★ (small)",  "★", location.absolute, bullCol, size = size.small, display = display.pane)
plotchar(showStar and szN and bullStar ? starY : na, "Bull ★ (normal)", "★", location.absolute, bullCol, size = size.normal, display = display.pane)
plotchar(showStar and szT and bearStar ? starY : na, "Bear ★ (tiny)",   "★", location.absolute, bearCol, size = size.tiny, display = display.pane)
plotchar(showStar and szS and bearStar ? starY : na, "Bear ★ (small)",  "★", location.absolute, bearCol, size = size.small, display = display.pane)
plotchar(showStar and szN and bearStar ? starY : na, "Bear ★ (normal)", "★", location.absolute, bearCol, size = size.normal, display = display.pane)

// ── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(bullStar, "Iron — bullish control", "Iron Momentum: buyers took control on {{ticker}}")
alertcondition(bearStar, "Iron — bearish control", "Iron Momentum: sellers took control on {{ticker}}")
alertcondition(sqzOn and not sqzOn[1],   "Squeeze on",  "Iron Momentum: squeeze fired on {{ticker}} — coiled")
alertcondition(sqzOff and not sqzOff[1], "Squeeze off", "Iron Momentum: squeeze released on {{ticker}}")
alertcondition(ta.crossover(throttle, 0),  "Throttle above zero", "Iron Momentum: throttle crossed above zero on {{ticker}}")
alertcondition(ta.crossunder(throttle, 0), "Throttle below zero", "Iron Momentum: throttle crossed below zero on {{ticker}}")
