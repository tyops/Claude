// ═══════════════════════════════════════════════════════════════════════════════
//  ── PANE ───────────────────────────────────────────────────────────────────
//  Sub-pane indicator. If it lands on the price pane, remove it, open a NEW
//  Pine Editor tab, paste, then Add to chart.
// ═══════════════════════════════════════════════════════════════════════════════
//  MCDX TD
//  A participation lens. It splits the tape into three tiers of money and shows
//  how strong each one is right now:
//    Banker / smart money (red)   — large, slow, patient
//    Hot money (yellow)           — fast speculative capital
//    Retail (green)               — small lots, the crowd
//  Rising red is the reading that matters. A tall green bar with no red under
//  it is the crowd carrying the move, which is thin support.
//
//  Each tier is an RSI on its own period, offset by a base level and scaled by a
//  sensitivity — the published Multi-Color Dragon construction. Each is then
//  clamped to the tier ceiling and read as a percentage of THAT ceiling, on its
//  own. The three are independent readings, not shares of one pie: the reference
//  charts print 62 / 18 / 0 and 74 / 46 / 19, which sum to 80 and 139.
//
//  What this is not: order-flow data. No chart script can see who is buying.
//  These are smoothed price-derived proxies, and "banker" is a label on an
//  oscillator rather than a fact about anyone's book.
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("MCDX TD", overlay = false)

// ── Banker / smart money ─────────────────────────────────────────────────────
gBank    = "Banker (smart money)"
bankLen  = input.int(50,  "RSI period",  minval = 1, group = gBank, inline = "b")
bankBase = input.float(50, "base",       minval = 0, group = gBank, inline = "b")
bankSens = input.float(1.5, "sensitivity", minval = 0.1, step = 0.1, group = gBank, inline = "b")

// ── Hot money ────────────────────────────────────────────────────────────────
gHot     = "Hot money"
hotLen   = input.int(40,  "RSI period",  minval = 1, group = gHot, inline = "h")
hotBase  = input.float(30, "base",       minval = 0, group = gHot, inline = "h")
hotSens  = input.float(0.7, "sensitivity", minval = 0.1, step = 0.1, group = gHot, inline = "h")

// ── Retail ───────────────────────────────────────────────────────────────────
gRet     = "Retail"
retLen   = input.int(30,  "RSI period",  minval = 1, group = gRet, inline = "r")
retBase  = input.float(20, "base",       minval = 0, group = gRet, inline = "r")
retSens  = input.float(0.4, "sensitivity", minval = 0.1, step = 0.1, group = gRet, inline = "r")

// ── Scale ────────────────────────────────────────────────────────────────────
gScale   = "Scale"
src      = input.source(close, "Source", group = gScale)
capVal   = input.float(20, "Tier ceiling", minval = 1, group = gScale,
     tooltip = "Each raw tier clamps here before the shares are worked out. 20 is the published value.")
smoothLen= input.int(1, "Smoothing", minval = 1, group = gScale,
     tooltip = "1 leaves the bars raw. Raise it to calm a noisy pane.")
heavyLvl = input.float(50, "Heavy accumulation share %", minval = 0, maxval = 100, group = gScale,
     tooltip = "A banker share above this is the accumulation reading the suite looks for before an entry.")

// ── Style ────────────────────────────────────────────────────────────────────
gSty     = "Style"
bankCol  = input.color(#E03C3C, "Banker",    group = gSty, inline = "c")
hotCol   = input.color(#E5C04D, "Hot money", group = gSty, inline = "c")
retCol   = input.color(#2FBF71, "Retail",    group = gSty, inline = "c")
bodyT    = input.int(10, "Bar transparency", minval = 0, maxval = 100, group = gSty)
showRead = input.bool(true, "Show the percentage boxes", group = gSty)
readPos  = input.string(position.middle_right, "Boxes",
     options = [position.middle_right, position.top_right, position.bottom_right,
     position.middle_left, position.top_left], group = gSty)
readSize = input.string(size.small, "Text size", options = [size.tiny, size.small, size.normal], group = gSty)

// ═════════════════════════════════════════════════════════════════════════════
//  TIERS — RSI, offset by its base, scaled, clamped, then taken as a share
// ═════════════════════════════════════════════════════════════════════════════
f_tier(_src, _len, _base, _sens, _cap, _sm) =>
    raw = _sens * (ta.rsi(_src, _len) - _base)
    ta.sma(math.min(math.max(raw, 0.0), _cap), _sm)

bankRaw  = f_tier(src, bankLen, bankBase, bankSens, capVal, smoothLen)
hotRaw   = f_tier(src, hotLen,  hotBase,  hotSens,  capVal, smoothLen)
retRaw   = f_tier(src, retLen,  retBase,  retSens,  capVal, smoothLen)

//  Each tier is read against its own ceiling, not against the other two. The
//  readouts on the reference charts prove this: 62 / 18 / 0 sums to 80 and
//  74 / 46 / 19 sums to 139, so they cannot be shares of one total.
bankPct  = bankRaw / capVal * 100
hotPct   = hotRaw  / capVal * 100
retPct   = retRaw  / capVal * 100

//  Draw order is fixed, not sorted by height: retail first, then hot money, then
//  banker. Later plots render in front, so banker — the tier that matters — is
//  always the one you can see.
plot(retPct,  "Retail %",    color = color.new(retCol,  bodyT), style = plot.style_columns, histbase = 0)
plot(hotPct,  "Hot money %", color = color.new(hotCol,  bodyT), style = plot.style_columns, histbase = 0)
plot(bankPct, "Banker %",    color = color.new(bankCol, bodyT), style = plot.style_columns, histbase = 0)
hline(heavyLvl, "Heavy accumulation", color = color.new(color.gray, 60), linestyle = hline.style_dotted)

// ── Percentage boxes ─────────────────────────────────────────────────────────
var table read = table.new(readPos, 1, 3, frame_width = 0)
if showRead and barstate.islast
    dark = color.new(#101216, 0)
    table.cell(read, 0, 0, str.tostring(math.round(retPct))  + "%", text_color = dark,
         text_size = readSize, bgcolor = retCol)
    table.cell(read, 0, 1, str.tostring(math.round(hotPct))  + "%", text_color = dark,
         text_size = readSize, bgcolor = hotCol)
    table.cell(read, 0, 2, str.tostring(math.round(bankPct)) + "%", text_color = dark,
         text_size = readSize, bgcolor = bankCol)

// ── State ────────────────────────────────────────────────────────────────────
bankHeavy   = bankPct >= heavyLvl
bankLeads   = bankPct > hotPct and bankPct > retPct
retailLeads = retPct > bankPct and retPct > hotPct

// ── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(bankHeavy and not bankHeavy[1], "Banker accumulation",
     "MCDX TD: banker share pushed into heavy accumulation on {{ticker}}")
alertcondition(bankLeads and not bankLeads[1], "Banker takes the lead",
     "MCDX TD: banker share overtook hot money and retail on {{ticker}}")
alertcondition(retailLeads and not retailLeads[1], "Retail leading",
     "MCDX TD: retail is carrying this move on {{ticker}} — thin support under price")
