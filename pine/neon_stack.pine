// ═══════════════════════════════════════════════════════════════════════════════
//  Trade Daddy — NEON STACK
//  Momentum alignment meter. Three speed layers of the same oscillator become a
//  "stack": fast over mid over slow = clean bullish momentum, reversed = clean
//  bearish. The midline is wrapped in a band that expands as separation grows
//  (strong push) and contracts as it shrinks (chop). Band colour = stack state.
//    ★ cyan    = stack flips into bullish alignment
//    ★ magenta = stack flips into bearish alignment
//  ── PANE ───────────────────────────────────────────────────────────────────
//  This is a SUB-PANE indicator (overlay = false) — it belongs in its own box
//  under the chart, like Silver Flow. If it lands on the price pane, TradingView
//  is reusing the pane of whatever script was previously added from that Pine
//  Editor tab; changing a script's overlay flag never relocates an instance that
//  is already on the chart. Fix: remove it from the chart, open a NEW editor tab,
//  paste, then Add to chart. Or right-click the indicator title on the chart and
//  pick "Move to → New pane below".
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("Trade Daddy — Neon Stack", "Neon Stack", overlay = false)

// ── Stack ────────────────────────────────────────────────────────────────────
gStk     = "Stack"
src      = input.source(close, "Source",                    group = gStk)
oscLen   = input.int(14, "Oscillator length", minval = 1,   group = gStk)
fastLen  = input.int(3,  "Fast layer", minval = 1,          group = gStk, inline = "l")
midLen   = input.int(7,  "Mid layer",  minval = 1,          group = gStk, inline = "l")
slowLen  = input.int(14, "Slow layer", minval = 1,          group = gStk, inline = "l")
bandMlt  = input.float(1.6, "Band width ×", minval = 0.1, step = 0.1, group = gStk)
bandMin  = input.float(1.0, "Min band half-width", minval = 0, step = 0.5, group = gStk,
     tooltip = "Keeps the ribbon visible through compression instead of collapsing to a line.")
pinchLvl = input.float(2.0, "Compression threshold", minval = 0.1, step = 0.1, group = gStk)

// ── Style ────────────────────────────────────────────────────────────────────
gSty     = "Style"
neonCol  = input.color(#39FF14, "Neon (fast line)",  group = gSty, inline = "c1")
stackCol = input.color(#C4C9D0, "Stack (mid line)",  group = gSty, inline = "c1")
bandBear = input.color(#B9BEC6, "Bearish band",      group = gSty, inline = "c2")
coreT    = input.int(30, "Core transparency", minval = 0, maxval = 100, group = gSty)
bandT    = input.int(68, "Halo transparency", minval = 0, maxval = 100, group = gSty)
coreFrac = input.float(0.45, "Core share of the band", minval = 0.1, maxval = 1.0, step = 0.05, group = gSty)
showLvls = input.bool(true, "Show 30 / 50 / 70 levels", group = gSty)

// ── Stars ────────────────────────────────────────────────────────────────────
gStar    = "Stars"
showStar = input.bool(true, "Show stars",             group = gStar)
starSz   = input.string("Tiny", "Star size", options = ["Tiny", "Small", "Normal"], group = gStar)
starGap  = input.float(8.0, "Star gap below the band", minval = 0, step = 0.5, group = gStar)
bullCol  = input.color(#00E5FF, "Bull ★", group = gStar, inline = "sc")
bearCol  = input.color(#FF00E0, "Bear ★", group = gStar, inline = "sc")

// ═════════════════════════════════════════════════════════════════════════════
osc      = ta.rsi(src, oscLen)
fast     = ta.ema(osc, fastLen)
mid      = ta.ema(osc, midLen)
slow     = ta.ema(osc, slowLen)

stackUp  = fast > mid and mid > slow
stackDn  = fast < mid and mid < slow
sep      = math.abs(fast - slow)
half     = math.max(sep * 0.5 * bandMlt, bandMin)
upper    = mid + half
lower    = mid - half
pinched  = sep < pinchLvl

var bool bullState = false
bullState := stackUp ? true : stackDn ? false : bullState
bandCol   = bullState ? neonCol : bandBear

coreUp = mid + half * coreFrac
coreDn = mid - half * coreFrac
dim    = pinched ? 12 : 0

pUp   = plot(upper,  "Halo upper", color = color.new(bandCol, math.min(99, bandT + 20 + dim)), linewidth = 1)
pDn   = plot(lower,  "Halo lower", color = color.new(bandCol, math.min(99, bandT + 20 + dim)), linewidth = 1)
pCUp  = plot(coreUp, "Core upper", color = color.new(#000000, 100), editable = false)
pCDn  = plot(coreDn, "Core lower", color = color.new(#000000, 100), editable = false)
fill(pUp,  pCUp, color = color.new(bandCol, math.min(99, bandT + dim)), title = "Halo top")
fill(pCDn, pDn,  color = color.new(bandCol, math.min(99, bandT + dim)), title = "Halo bottom")
fill(pCUp, pCDn, color = color.new(bandCol, math.min(99, coreT + dim)), title = "Core band")

plot(mid,  "Stack line", color = color.new(stackCol, 0), linewidth = 2)
plot(fast, "Neon line",  color = neonCol, linewidth = 2)

plot(showLvls ? 50 : na, "50", color = color.new(color.gray, 60))
plot(showLvls ? 70 : na, "70", color = color.new(color.gray, 85))
plot(showLvls ? 30 : na, "30", color = color.new(color.gray, 85))

// ── Stars: the bar the stack flips ───────────────────────────────────────────
bullStar = stackUp and not stackUp[1]
bearStar = stackDn and not stackDn[1]
starY    = math.max(1.0, lower - starGap)
szT      = starSz == "Tiny"
szS      = starSz == "Small"
szN      = starSz == "Normal"

plotchar(showStar and szT and bullStar ? starY : na, "Bull ★ (tiny)",   "★", location.absolute, bullCol, size = size.tiny, display = display.pane)
plotchar(showStar and szS and bullStar ? starY : na, "Bull ★ (small)",  "★", location.absolute, bullCol, size = size.small, display = display.pane)
plotchar(showStar and szN and bullStar ? starY : na, "Bull ★ (normal)", "★", location.absolute, bullCol, size = size.normal, display = display.pane)
plotchar(showStar and szT and bearStar ? starY : na, "Bear ★ (tiny)",   "★", location.absolute, bearCol, size = size.tiny, display = display.pane)
plotchar(showStar and szS and bearStar ? starY : na, "Bear ★ (small)",  "★", location.absolute, bearCol, size = size.small, display = display.pane)
plotchar(showStar and szN and bearStar ? starY : na, "Bear ★ (normal)", "★", location.absolute, bearCol, size = size.normal, display = display.pane)

// ── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(bullStar, "Neon Stack — bullish alignment", "Neon Stack: stack flipped BULLISH on {{ticker}}")
alertcondition(bearStar, "Neon Stack — bearish alignment", "Neon Stack: stack flipped BEARISH on {{ticker}}")
alertcondition(pinched and not pinched[1], "Neon Stack — compression", "Neon Stack: ribbon compressing on {{ticker}}")
alertcondition(not pinched and pinched[1], "Neon Stack — expansion",   "Neon Stack: ribbon expanding on {{ticker}}")
