// ═══════════════════════════════════════════════════════════════════════════════
//  ── PANE ───────────────────────────────────────────────────────────────────
//  This is a SUB-PANE indicator (overlay = false) — it belongs in its own box
//  under the chart. If it lands on the price pane, TradingView is reusing the
//  pane of whatever script was previously added from that Pine Editor tab;
//  changing a script's overlay flag never relocates an instance already on the
//  chart. Fix: remove it, open a NEW editor tab, paste, then Add to chart.
// ═══════════════════════════════════════════════════════════════════════════════
//  NEON STACK
//  Momentum alignment across three speeds. Three RSI lengths — fast, mid and
//  slow — plotted together with the space between them filled.
//    Fast over mid over slow = clean bullish momentum
//    Fast under mid under slow = clean bearish momentum
//    Anything else = no alignment, which is chop
//  A wide band is impulse. A tight band is compression. Trade with the stack,
//  not against it.
//    ★ cyan    = all three flip into bullish order
//    ★ magenta = all three flip into bearish order
//
//  Its author describes this as very similar to a triple RSI, and says to use a
//  triple RSI if you don't want his — so three lengths it is. 7/14/28 and
//  9/14/21 are the common triples; both are one input change apart.
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("Neon Stack", overlay = false)

// ── Stack ────────────────────────────────────────────────────────────────────
gStk     = "Stack"
src      = input.source(close, "Source",                    group = gStk)
fastLen  = input.int(7,  "Fast RSI", minval = 1,            group = gStk, inline = "l")
midLen   = input.int(14, "Mid RSI",  minval = 1,            group = gStk, inline = "l")
slowLen  = input.int(28, "Slow RSI", minval = 1,            group = gStk, inline = "l")
smooth   = input.int(3, "Line smoothing", minval = 1,       group = gStk,
     tooltip = "A raw RSI(7) prints jagged. 3 gives the smooth ribbon the reference panes show. Drop to 1 for the unsmoothed triple-RSI reading.")
bandMin  = input.float(1.0, "Min band half-width", minval = 0, step = 0.5, group = gStk,
     tooltip = "Keeps the ribbon visible through compression instead of collapsing to a line.")
pinchLvl = input.float(2.0, "Compression threshold", minval = 0.1, step = 0.1, group = gStk,
     tooltip = "Fast-to-slow spread below this reads as compression.")

// ── Style ────────────────────────────────────────────────────────────────────
gSty     = "Style"
neonCol  = input.color(#39FF14, "Neon (fast line)",  group = gSty, inline = "c1")
stackCol = input.color(#C4C9D0, "Stack (mid line)",  group = gSty, inline = "c1")
bandBear = input.color(#B9BEC6, "Bearish band",      group = gSty, inline = "c2")
coreT    = input.int(22, "Core transparency", minval = 0, maxval = 100, group = gSty)
bandT    = input.int(60, "Halo transparency", minval = 0, maxval = 100, group = gSty)
coreFrac = input.float(0.45, "Core share of the band", minval = 0.1, maxval = 1.0, step = 0.05, group = gSty)
showSlow = input.bool(false, "Show the slow line", group = gSty,
     tooltip = "The slow RSI is the band's far edge. Drawing it as a line too makes the three speeds explicit.")
showLvls = input.bool(false, "Show 30 / 50 / 70 levels", group = gSty)

// ── Stars ────────────────────────────────────────────────────────────────────
gStar    = "Stars"
showStar = input.bool(true, "Show stars",             group = gStar)
starSz   = input.string("Tiny", "Star size", options = ["Auto", "Tiny", "Small", "Normal"], group = gStar,
     tooltip = "Tiny is the smallest fixed size Pine offers and is the default. Auto is the only thing smaller — it scales the star to the bar width, so it shrinks when you zoom out. If stars still look oversized after updating this script, the chart is holding your old saved value: open Settings, then Defaults, then Reset settings.")
starGap  = input.float(8.0, "Star gap below the band", minval = 0, step = 0.5, group = gStar)
bullCol  = input.color(#00E5FF, "Bull ★", group = gStar, inline = "sc")
bearCol  = input.color(#FF00E0, "Bear ★", group = gStar, inline = "sc")

// ═════════════════════════════════════════════════════════════════════════════
//  three speeds of the same oscillator
fast     = ta.sma(ta.rsi(src, fastLen), smooth)
mid      = ta.sma(ta.rsi(src, midLen),  smooth)
slow     = ta.sma(ta.rsi(src, slowLen), smooth)

//  alignment is the whole point: all three in order, not one crossing another
stackUp  = fast > mid and mid > slow
stackDn  = fast < mid and mid < slow
sep      = math.abs(fast - slow)
pinched  = sep < pinchLvl

var bool bullState = false
bullState := stackUp ? true : stackDn ? false : bullState
bandCol   = bullState ? neonCol : bandBear

//  the band spans fast to slow, padded so it never disappears
centre   = math.avg(fast, slow)
half     = math.max(sep * 0.5, bandMin)
upper    = centre + half
lower    = centre - half
coreUp   = centre + half * coreFrac
coreDn   = centre - half * coreFrac
dim      = pinched ? 12 : 0

pUp   = plot(upper,  "Halo upper", color = color.new(bandCol, math.min(99, bandT + 20 + dim)), linewidth = 1)
pDn   = plot(lower,  "Halo lower", color = color.new(bandCol, math.min(99, bandT + 20 + dim)), linewidth = 1)
pCUp  = plot(coreUp, "Core upper", color = color.new(#000000, 100), editable = false)
pCDn  = plot(coreDn, "Core lower", color = color.new(#000000, 100), editable = false)
fill(pUp,  pCUp, color = color.new(bandCol, math.min(99, bandT + dim)), title = "Halo top")
fill(pCDn, pDn,  color = color.new(bandCol, math.min(99, bandT + dim)), title = "Halo bottom")
fill(pCUp, pCDn, color = color.new(bandCol, math.min(99, coreT + dim)), title = "Core band")

plot(mid,  "Stack line", color = color.new(stackCol, 0), linewidth = 2)
plot(fast, "Neon line",  color = neonCol, linewidth = 2)
plot(showSlow ? slow : na, "Slow line", color = color.new(stackCol, 45), linewidth = 1)

plot(showLvls ? 50 : na, "50", color = color.new(color.gray, 60))
plot(showLvls ? 70 : na, "70", color = color.new(color.gray, 85))
plot(showLvls ? 30 : na, "30", color = color.new(color.gray, 85))

// ── Stars: the bar all three fall into order ─────────────────────────────────
bullStar = stackUp and not stackUp[1]
bearStar = stackDn and not stackDn[1]
starY    = math.max(1.0, lower - starGap)
szA      = starSz == "Auto"
szT      = starSz == "Tiny"
szS      = starSz == "Small"
szN      = starSz == "Normal"

plotchar(showStar and szA and bullStar ? starY : na, "Bull ★ (auto)",   "★", location.absolute, bullCol, size = size.auto,   display = display.pane)
plotchar(showStar and szT and bullStar ? starY : na, "Bull ★ (tiny)",   "★", location.absolute, bullCol, size = size.tiny,   display = display.pane)
plotchar(showStar and szS and bullStar ? starY : na, "Bull ★ (small)",  "★", location.absolute, bullCol, size = size.small,  display = display.pane)
plotchar(showStar and szN and bullStar ? starY : na, "Bull ★ (normal)", "★", location.absolute, bullCol, size = size.normal, display = display.pane)
plotchar(showStar and szA and bearStar ? starY : na, "Bear ★ (auto)",   "★", location.absolute, bearCol, size = size.auto,   display = display.pane)
plotchar(showStar and szT and bearStar ? starY : na, "Bear ★ (tiny)",   "★", location.absolute, bearCol, size = size.tiny,   display = display.pane)
plotchar(showStar and szS and bearStar ? starY : na, "Bear ★ (small)",  "★", location.absolute, bearCol, size = size.small,  display = display.pane)
plotchar(showStar and szN and bearStar ? starY : na, "Bear ★ (normal)", "★", location.absolute, bearCol, size = size.normal, display = display.pane)

// ── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(bullStar, "Neon Stack — bullish alignment", "Neon Stack: all three RSIs flipped into bullish order on {{ticker}}")
alertcondition(bearStar, "Neon Stack — bearish alignment", "Neon Stack: all three RSIs flipped into bearish order on {{ticker}}")
alertcondition(pinched and not pinched[1], "Neon Stack — compression", "Neon Stack: ribbon compressing on {{ticker}}")
alertcondition(not pinched and pinched[1], "Neon Stack — expansion",   "Neon Stack: ribbon expanding on {{ticker}}")
