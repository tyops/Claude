// ═══════════════════════════════════════════════════════════════════════════════
//  ThetaDaddy — NEON STACK & IRON MOMENTUM   ·   Oscillator 1   (2 of 4)
//
//  Neon Stack   = RSI ribbon. Reacts first. Pinched ribbon = compression / chop,
//                 fanned ribbon = momentum with real trend behind it.
//  Iron Momentum= MACD ribbon. Confirms later. Gold body above the baseline,
//                 gray body below.
//
//  Display modes:  add the script twice (once "Neon Stack", once "Iron Momentum")
//  to reproduce the two-pane layout, or use "Both" to stack them in one pane on a
//  shared 0-100 scale.
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("ThetaDaddy — Neon Stack & Iron Momentum", "Neon / Iron", overlay = false,
     max_bars_back = 5000)

// ─────────────────────────────────────────────────────────────────────────────
//  ①  LAYOUT
// ─────────────────────────────────────────────────────────────────────────────
gView    = "①  Display"
mode     = input.string("Both (normalised 0-100)", "What to draw",
     options = ["Neon Stack", "Iron Momentum", "Both (normalised 0-100)"], group = gView)
normLen  = input.int(200, "Normalisation lookback (Iron)", minval = 20, group = gView)

showNeon = mode != "Iron Momentum"
showIron = mode != "Neon Stack"
normIron = mode == "Both (normalised 0-100)"

// ─────────────────────────────────────────────────────────────────────────────
//  ②  CORE ENGINE — same lookbacks as Carbon Structure
// ─────────────────────────────────────────────────────────────────────────────
gCore    = "②  Core engine — lookbacks"
rsiLen   = input.int(14, "RSI length",            minval = 1, group = gCore, inline = "rsi")
rsiUpLvl = input.int(50, "cross ↑",               minval = 1, maxval = 99, group = gCore, inline = "rsi")
rsiDnLvl = input.int(50, "cross ↓",               minval = 1, maxval = 99, group = gCore, inline = "rsi")
macdFast = input.int(12, "MACD fast",             minval = 1, group = gCore, inline = "macd")
macdSlow = input.int(26, "slow",                  minval = 1, group = gCore, inline = "macd")
macdSig  = input.int(9,  "signal",                minval = 1, group = gCore, inline = "macd")
vwapLen  = input.int(50, "VWAP length (Control Line)", minval = 1, group = gCore)
srcCore  = input.source(close, "Signal source",   group = gCore)

// ─────────────────────────────────────────────────────────────────────────────
//  ③  NEON STACK — the RSI ribbon
// ─────────────────────────────────────────────────────────────────────────────
gNeon    = "③  Neon Stack"
n1Len    = input.int(2,  "Ribbon 1 (fastest)", minval = 1, group = gNeon, inline = "n1")
n2Len    = input.int(4,  "2",                  minval = 1, group = gNeon, inline = "n1")
n3Len    = input.int(7,  "3",                  minval = 1, group = gNeon, inline = "n2")
n4Len    = input.int(12, "4 (slowest)",        minval = 1, group = gNeon, inline = "n2")
neonUpC  = input.color(#39FF14, "Neon",  group = gNeon, inline = "nc")
neonSlwC = input.color(#B0B3B8, "Stack", group = gNeon, inline = "nc")
neonFillT= input.int(70, "Ribbon transparency", minval = 0, maxval = 100, group = gNeon)
pinchPct = input.float(1.5, "Pinch threshold (RSI points)", minval = 0.1, step = 0.1, group = gNeon,
     tooltip = "Ribbon spread below this = compression / chop.")

// ─────────────────────────────────────────────────────────────────────────────
//  ④  IRON MOMENTUM — the MACD ribbon
// ─────────────────────────────────────────────────────────────────────────────
gIron    = "④  Iron Momentum"
ironSm   = input.int(3, "Iron smoothing", minval = 1, group = gIron)
ironUpC  = input.color(#C9A227, "Bull (gold)", group = gIron, inline = "ic")
ironDnC  = input.color(#8E97A3, "Bear (iron)", group = gIron, inline = "ic")
ironFillT= input.int(72, "Body transparency", minval = 0, maxval = 100, group = gIron)

// ─────────────────────────────────────────────────────────────────────────────
//  ⑤  MARKET INTERNALS (star filter — mirror of the main script)
// ─────────────────────────────────────────────────────────────────────────────
gInt     = "⑤  Market internals"
useInt   = input.bool(true, "Use internals as a signal filter",     group = gInt)
intVotes = input.int(2, "Minimum votes required (of 3)", minval = 0, maxval = 3, group = gInt)
intTf    = input.timeframe("", "Internals timeframe (blank = chart)", group = gInt)
pcrSym   = input.symbol("USI:PCC",     "Put/Call ratio",   group = gInt)
vixSym   = input.symbol("CBOE:VIX",    "Volatility index", group = gInt)
advSym   = input.symbol("USI:ADVN.NY", "Advancing issues", group = gInt)
decSym   = input.symbol("USI:DECL.NY", "Declining issues", group = gInt)
intSmooth= input.int(20, "Internals smoothing", minval = 1, group = gInt)
mcFastL  = input.int(19, "McClellan fast EMA", minval = 1, group = gInt, inline = "mc")
mcSlowL  = input.int(39, "slow EMA",           minval = 1, group = gInt, inline = "mc")
divLook  = input.int(20, "McClellan divergence lookback", minval = 5, group = gInt)

// ─────────────────────────────────────────────────────────────────────────────
//  ⑥  STARS
// ─────────────────────────────────────────────────────────────────────────────
gStar    = "⑥  Stars"
showStar = input.bool(true, "Show stars", group = gStar)
starAnch = input.string("Signal line", "Star placement", options = ["Signal line", "Pane edges"], group = gStar)
cooldown = input.int(5, "Cooldown bars between same-side stars", minval = 0, group = gStar)
bullCol  = input.color(#00E5FF, "Blue ★ (bullish)",   group = gStar, inline = "sc")
bearCol  = input.color(#FF00E0, "Purple ★ (bearish)", group = gStar, inline = "sc")

// ─────────────────────────────────────────────────────────────────────────────
//  HELPERS
// ─────────────────────────────────────────────────────────────────────────────
f_req(_sym, _tf) =>
    request.security(_sym, _tf == "" ? timeframe.period : _tf, close,
         ignore_invalid_symbol = true)

// ═════════════════════════════════════════════════════════════════════════════
//  CALCULATIONS
// ═════════════════════════════════════════════════════════════════════════════
vol      = nz(volume)
rsi      = ta.rsi(srcCore, rsiLen)
[macdLine, sigLine, macdHist] = ta.macd(srcCore, macdFast, macdSlow, macdSig)

// Control Line (rolling VWAP) — needed by the star engine
volSum   = math.sum(vol, vwapLen)
control  = volSum > 0 ? math.sum(hlc3 * vol, vwapLen) / volSum : ta.ema(hlc3, vwapLen)

// ── Neon Stack ───────────────────────────────────────────────────────────────
neon1    = ta.ema(rsi, n1Len)
neon2    = ta.ema(rsi, n2Len)
neon3    = ta.ema(rsi, n3Len)
neon4    = ta.ema(rsi, n4Len)
neonUp   = neon1 > neon4
spread   = math.abs(neon1 - neon4)
pinched  = spread < pinchPct
neonBase = color.new(neonUpC, neonFillT)
neonDead = color.new(neonSlwC, neonFillT)

pN1 = plot(showNeon ? neon1 : na, "Neon 1", color = neonUpC, linewidth = 2)
pN2 = plot(showNeon ? neon2 : na, "Neon 2", color = color.new(neonSlwC, 20), linewidth = 1)
pN3 = plot(showNeon ? neon3 : na, "Neon 3", color = color.new(neonSlwC, 45), linewidth = 1)
pN4 = plot(showNeon ? neon4 : na, "Stack",  color = color.new(neonSlwC, 10), linewidth = 2)
fill(pN1, pN2, color = pinched ? neonDead : neonUp ? neonBase : neonDead, title = "Ribbon 1-2")
fill(pN2, pN3, color = pinched ? neonDead : neonUp ? color.new(neonUpC, math.min(99, neonFillT + 8)) : neonDead, title = "Ribbon 2-3")
fill(pN3, pN4, color = pinched ? neonDead : neonUp ? color.new(neonUpC, math.min(99, neonFillT + 16)) : neonDead, title = "Ribbon 3-4")

plot(showNeon ? 50 : na, "RSI mid",  color = color.new(color.gray, 55), display = display.pane)
plot(showNeon ? 70 : na, "RSI 70",   color = color.new(color.gray, 80), display = display.pane)
plot(showNeon ? 30 : na, "RSI 30",   color = color.new(color.gray, 80), display = display.pane)

// ── Iron Momentum ────────────────────────────────────────────────────────────
ironRaw  = ta.ema(macdLine, ironSm)
ironSigR = ta.ema(sigLine,  ironSm)
ironHi   = ta.highest(math.max(ironRaw, ironSigR), normLen)
ironLo   = ta.lowest(math.min(ironRaw, ironSigR),  normLen)
ironRng  = ironHi - ironLo
ironA    = normIron ? (ironRng > 0 ? (ironRaw  - ironLo) / ironRng * 100 : 50.0) : ironRaw
ironB    = normIron ? (ironRng > 0 ? (ironSigR - ironLo) / ironRng * 100 : 50.0) : ironSigR
ironBase = normIron ? (ironRng > 0 ? (0        - ironLo) / ironRng * 100 : 50.0) : 0.0
ironBull = ironRaw > ironSigR

pI1 = plot(showIron ? ironA : na, "Iron",          color = color.new(ironBull ? ironUpC : ironDnC, 10), linewidth = 2)
pI2 = plot(showIron ? ironB : na, "Iron baseline", color = color.new(ironDnC, 35), linewidth = 1)
fill(pI1, pI2, color = color.new(ironBull ? ironUpC : ironDnC, ironFillT), title = "Iron body")
plot(showIron ? ironBase : na, "Zero", color = color.new(color.gray, 55))

// ═════════════════════════════════════════════════════════════════════════════
//  MARKET INTERNALS
// ═════════════════════════════════════════════════════════════════════════════
pcr        = f_req(pcrSym, intTf)
vix        = f_req(vixSym, intTf)
advn       = f_req(advSym, intTf)
decl       = f_req(decSym, intTf)

netAdv     = nz(advn) - nz(decl)
mcOsc      = ta.ema(netAdv, mcFastL) - ta.ema(netAdv, mcSlowL)
pcrAvg     = ta.ema(nz(pcr, 1.0),  intSmooth)
vixAvg     = ta.ema(nz(vix, 20.0), intSmooth)
pcrBull    = na(pcr) ? false : pcr < pcrAvg
vixBull    = na(vix) ? false : vix < vixAvg
mcBullBase = mcOsc > 0

priceHH    = close > ta.highest(close, divLook)[1]
priceLL    = close < ta.lowest(close,  divLook)[1]
mcLowerHi  = mcOsc < ta.highest(mcOsc, divLook)[1]
mcHigherLo = mcOsc > ta.lowest(mcOsc,  divLook)[1]
mcBearDiv  = priceHH and mcLowerHi
mcBullDiv  = priceLL and mcHigherLo

haveInt    = not na(pcr) or not na(vix) or netAdv != 0
bullVotes  = (pcrBull ? 1 : 0) + (vixBull ? 1 : 0) + (mcBullBase or mcBullDiv ? 1 : 0)
bearVotes  = (not pcrBull and not na(pcr) ? 1 : 0) + (not vixBull and not na(vix) ? 1 : 0) +
             (not mcBullBase or mcBearDiv ? 1 : 0)
intBull    = not useInt or not haveInt or bullVotes >= intVotes
intBear    = not useInt or not haveInt or bearVotes >= intVotes

// ═════════════════════════════════════════════════════════════════════════════
//  STAR ENGINE  (identical block in every script of this system)
// ═════════════════════════════════════════════════════════════════════════════
macdBull   = macdLine > sigLine
macdBear   = macdLine < sigLine
aboveCtrl  = close > control
belowCtrl  = close < control
rsiCrossUp = ta.crossover(rsi,  rsiUpLvl)
rsiCrossDn = ta.crossunder(rsi, rsiDnLvl)

bullRaw    = rsiCrossUp and macdBull and aboveCtrl and intBull
bearRaw    = rsiCrossDn and macdBear and belowCtrl and intBear

var int lastBull = -99999
var int lastBear = -99999
bullStar   = bullRaw and (bar_index - lastBull) >= cooldown
bearStar   = bearRaw and (bar_index - lastBear) >= cooldown
if bullStar
    lastBull := bar_index
if bearStar
    lastBear := bar_index

// star anchors: hang them off the slow line (or the pane edges)
ironStd    = ta.stdev(ironRaw, 100)          // computed unconditionally on purpose
anchLine   = showNeon ? neon4 : ironB
starOff    = showNeon or normIron ? 6.0 : ironStd * 0.9
bullY      = anchLine - starOff
bearY      = anchLine + starOff
atLine     = starAnch == "Signal line"

plotchar(showStar and atLine and bullStar ? bullY : na, "Blue ★",   "★", location.absolute, bullCol, size = size.small)
plotchar(showStar and atLine and bearStar ? bearY : na, "Purple ★", "★", location.absolute, bearCol, size = size.small)
plotchar(showStar and not atLine and bullStar, "Blue ★ (edge)",   "★", location.bottom, bullCol, size = size.small)
plotchar(showStar and not atLine and bearStar, "Purple ★ (edge)", "★", location.top,    bearCol, size = size.small)

// ═════════════════════════════════════════════════════════════════════════════
//  ALERTS
// ═════════════════════════════════════════════════════════════════════════════
alertcondition(bullStar, "Blue ★ (bullish shift)",   "Neon/Iron: BLUE star on {{ticker}} @ {{close}}")
alertcondition(bearStar, "Purple ★ (bearish shift)", "Neon/Iron: PURPLE star on {{ticker}} @ {{close}}")
alertcondition(pinched and not pinched[1],   "Neon compression", "Neon/Iron: ribbon pinched on {{ticker}}")
alertcondition(not pinched and pinched[1],   "Neon expansion",   "Neon/Iron: ribbon expanding on {{ticker}}")
alertcondition(ta.cross(ironRaw, ironSigR),  "Iron cross",       "Neon/Iron: Iron Momentum crossed on {{ticker}}")
