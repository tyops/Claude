// ═══════════════════════════════════════════════════════════════════════════════
//  Trade Daddy — VOLUME PLANES
//  A horizontal volume profile over the lookback window: every bar's volume is
//  spread across the price bins its range covers, and each bin is drawn as a
//  plane whose length is its share of the traded volume. High volume nodes are
//  where price has already agreed on value — support and resistance on retests.
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("Trade Daddy — Volume Planes", "Volume Planes", overlay = true,
     max_boxes_count = 500, max_lines_count = 100, max_bars_back = 5000)

// ── Profile ──────────────────────────────────────────────────────────────────
gPrf     = "Profile"
lookback = input.int(300, "Lookback bars", minval = 20, maxval = 5000, group = gPrf)
bins     = input.int(60,  "Price bins",    minval = 10, maxval = 300,  group = gPrf)
planeLen = input.int(140, "Longest plane (bars)", minval = 5, maxval = 1000, group = gPrf)
anchor   = input.string("Window start", "Anchor planes to", options = ["Window start", "Chart right"], group = gPrf)
minShare = input.float(2.0, "Hide planes under % of the peak", minval = 0, maxval = 100, step = 0.5, group = gPrf)

// ── Value area / POC ─────────────────────────────────────────────────────────
gVA      = "Value area"
showVA   = input.bool(false, "Highlight value area", group = gVA)
vaPct    = input.float(70, "Value area %", minval = 10, maxval = 100, step = 5, group = gVA)
showPoc  = input.bool(true, "Extend POC across the chart", group = gVA)

// ── Style ────────────────────────────────────────────────────────────────────
gSty     = "Style"
planeCol = input.color(#FFFFFF, "Plane",      group = gSty, inline = "c")
vaCol    = input.color(#FFFFFF, "Value area", group = gSty, inline = "c")
pocCol   = input.color(#FFFFFF, "POC",        group = gSty, inline = "c")
planeT   = input.int(70, "Smallest plane transparency", minval = 0, maxval = 100, group = gSty)
planeTHi = input.int(25, "Largest plane transparency",  minval = 0, maxval = 100, group = gSty)
vaT      = input.int(35, "Value area transparency", minval = 0, maxval = 100, group = gSty)
binGap   = input.float(20, "Gap between planes %", minval = 0, maxval = 60, step = 5, group = gSty)

// ═════════════════════════════════════════════════════════════════════════════
var array<box> planes = array.new<box>()
var line pocLine = na

vpHi = ta.highest(high, lookback)
vpLo = ta.lowest(low,   lookback)

if barstate.islast and bar_index > lookback
    for b in planes
        box.delete(b)
    array.clear(planes)
    if not na(pocLine)
        line.delete(pocLine)
        pocLine := na

    binSize = (vpHi - vpLo) / bins
    if binSize > 0
        vols = array.new_float(bins, 0.0)
        for i = 0 to lookback - 1
            h = nz(high[i])
            l = nz(low[i])
            v = nz(volume[i])
            if v > 0 and h >= l
                b1 = math.max(0, math.min(bins - 1, int(math.floor((l - vpLo) / binSize))))
                b2 = math.max(0, math.min(bins - 1, int(math.floor((h - vpLo) / binSize))))
                share = v / (b2 - b1 + 1)
                for b = b1 to b2
                    array.set(vols, b, array.get(vols, b) + share)

        maxV  = array.max(vols)
        total = array.sum(vols)
        pocId = array.indexof(vols, maxV)

        // value area: grow out from the POC until vaPct of the volume is covered
        vaLo = pocId
        vaHi = pocId
        if showVA and total > 0
            covered = maxV
            target  = total * vaPct / 100.0
            while covered < target and (vaLo > 0 or vaHi < bins - 1)
                below = vaLo > 0        ? array.get(vols, vaLo - 1) : -1.0
                above = vaHi < bins - 1 ? array.get(vols, vaHi + 1) : -1.0
                if above >= below
                    vaHi    := vaHi + 1
                    covered := covered + above
                else
                    vaLo    := vaLo - 1
                    covered := covered + below

        left = anchor == "Window start" ? bar_index - lookback + 1 : bar_index - planeLen
        for b = 0 to bins - 1
            v = array.get(vols, b)
            if maxV > 0 and v / maxV * 100 >= minShare
                len   = math.max(1, int(v / maxV * planeLen))
                inVA  = showVA and b >= vaLo and b <= vaHi
                bot   = vpLo + b * binSize
                top   = bot + binSize
                pad   = binSize * binGap / 200.0
                //  bigger node, brighter plane
                rel   = v / maxV
                trans = math.max(0, math.min(100, int(planeT - (planeT - planeTHi) * rel)))
                array.push(planes, box.new(left, top - pad, left + len, bot + pad,
                     border_width = 0,
                     bgcolor = color.new(inVA ? vaCol : planeCol, inVA ? vaT : trans)))

        if showPoc
            pocPrice = vpLo + (pocId + 0.5) * binSize
            pocLine := line.new(bar_index - lookback + 1, pocPrice, bar_index + 10, pocPrice,
                 color = color.new(pocCol, 25), style = line.style_solid, width = 1)
