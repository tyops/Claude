// ═══════════════════════════════════════════════════════════════════════════════
//  ThetaDaddy — SILVER FLOW   ·   Oscillator 2   (3 of 4)
//
//  Gold line  = WHALE flow    · slow, size-filtered volume + market internals
//                               (Put/Call ratio, VIX, McClellan breadth)
//  White line = REACTIVE flow · fast money — MFI / RSI money flow
//  Fill       = the delta. Gold body = whales in control, silver body = the tape
//               is being pushed around by reactive flow.
//
//  Gold over white and rising  -> institutional accumulation
//  White over gold             -> reactive / crowd-driven move, treat rallies as
//                                 lower quality until the gold line catches up
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("ThetaDaddy — Silver Flow", "Silver Flow", overlay = false, max_bars_back = 5000)

// ─────────────────────────────────────────────────────────────────────────────
//  ①  FLOW ENGINE
// ─────────────────────────────────────────────────────────────────────────────
gFlow    = "①  Flow engine"
whaleLen = input.int(21, "Whale flow smoothing",  minval = 1, group = gFlow)
whaleVL  = input.int(50, "Whale volume baseline", minval = 1, group = gFlow)
whaleMlt = input.float(1.5, "Whale volume multiple", minval = 1.0, step = 0.1, group = gFlow,
     tooltip = "A bar only counts as whale flow when its volume exceeds the baseline average × this multiple.")
reactLen = input.int(14, "Reactive flow length",  minval = 1, group = gFlow)
reactSm  = input.int(3,  "Reactive smoothing",    minval = 1, group = gFlow)
normLen  = input.int(200, "Normalisation lookback", minval = 20, group = gFlow)
rsiLen   = input.int(14, "RSI length",            minval = 1, group = gFlow)

gWt      = "②  Flow weights (whale line)"
wWhale   = input.float(0.50, "Volume / whale bars", minval = 0, maxval = 1, step = 0.05, group = gWt)
wPcr     = input.float(0.20, "Put/Call ratio",     minval = 0, maxval = 1, step = 0.05, group = gWt)
wVix     = input.float(0.15, "VIX",                minval = 0, maxval = 1, step = 0.05, group = gWt)
wMc      = input.float(0.15, "McClellan breadth",  minval = 0, maxval = 1, step = 0.05, group = gWt,
     tooltip = "Weights are re-normalised automatically, and any feed that is unavailable on the current symbol drops out.")

// ─────────────────────────────────────────────────────────────────────────────
//  ③  MARKET INTERNALS
// ─────────────────────────────────────────────────────────────────────────────
gInt     = "③  Market internals"
intTf    = input.timeframe("", "Internals timeframe (blank = chart)", group = gInt)
pcrSym   = input.symbol("USI:PCC",     "Put/Call ratio",   group = gInt)
vixSym   = input.symbol("CBOE:VIX",    "Volatility index", group = gInt)
advSym   = input.symbol("USI:ADVN.NY", "Advancing issues", group = gInt)
decSym   = input.symbol("USI:DECL.NY", "Declining issues", group = gInt)
intSmooth= input.int(20, "Internals smoothing", minval = 1, group = gInt)
mcFastL  = input.int(19, "McClellan fast EMA", minval = 1, group = gInt, inline = "mc")
mcSlowL  = input.int(39, "slow EMA",           minval = 1, group = gInt, inline = "mc")
divLook  = input.int(20, "McClellan divergence lookback", minval = 5, group = gInt)
useInt   = input.bool(true, "Use internals as a star filter", group = gInt)
intVotes = input.int(2, "Minimum votes required (of 3)", minval = 0, maxval = 3, group = gInt)

// ─────────────────────────────────────────────────────────────────────────────
//  ④  STAR ENGINE INPUTS
// ─────────────────────────────────────────────────────────────────────────────
gCore    = "④  Star engine — lookbacks"
macdFast = input.int(12, "MACD fast",   minval = 1, group = gCore, inline = "macd")
macdSlow = input.int(26, "slow",        minval = 1, group = gCore, inline = "macd")
macdSig  = input.int(9,  "signal",      minval = 1, group = gCore, inline = "macd")
rsiUpLvl = input.int(50, "RSI cross ↑", minval = 1, maxval = 99, group = gCore, inline = "rsi")
rsiDnLvl = input.int(50, "cross ↓",     minval = 1, maxval = 99, group = gCore, inline = "rsi")
vwapLen  = input.int(50, "VWAP length (Control Line)", minval = 1, group = gCore)
srcCore  = input.source(close, "Signal source", group = gCore)

// ─────────────────────────────────────────────────────────────────────────────
//  ⑤  STYLE
// ─────────────────────────────────────────────────────────────────────────────
gSty     = "⑤  Style"
goldCol  = input.color(#C9A227, "Whale (gold)",   group = gSty, inline = "c1")
whiteCol = input.color(#FFFFFF, "Reactive (white)", group = gSty, inline = "c1")
fillT    = input.int(78, "Delta transparency", minval = 0, maxval = 100, group = gSty)
showDlt  = input.bool(false, "Show delta histogram", group = gSty)
showStar = input.bool(true,  "Show stars", group = gSty)
cooldown = input.int(5, "Cooldown bars between same-side stars", minval = 0, group = gSty)
bullCol  = input.color(#00E5FF, "Blue ★ (bullish)",   group = gSty, inline = "c2")
bearCol  = input.color(#FF00E0, "Purple ★ (bearish)", group = gSty, inline = "c2")

// ─────────────────────────────────────────────────────────────────────────────
//  HELPERS
// ─────────────────────────────────────────────────────────────────────────────
f_norm(_src, _len) =>
    hi  = ta.highest(_src, _len)
    lo  = ta.lowest(_src, _len)
    rng = hi - lo
    na(rng) or rng <= 0 ? 50.0 : (_src - lo) / rng * 100.0

f_req(_sym, _tf) =>
    request.security(_sym, _tf == "" ? timeframe.period : _tf, close,
         ignore_invalid_symbol = true)

// ═════════════════════════════════════════════════════════════════════════════
//  INTERNALS
// ═════════════════════════════════════════════════════════════════════════════
pcr        = f_req(pcrSym, intTf)
vix        = f_req(vixSym, intTf)
advn       = f_req(advSym, intTf)
decl       = f_req(decSym, intTf)

netAdv     = nz(advn) - nz(decl)
mcOsc      = ta.ema(netAdv, mcFastL) - ta.ema(netAdv, mcSlowL)
pcrAvg     = ta.ema(nz(pcr, 1.0),  intSmooth)
vixAvg     = ta.ema(nz(vix, 20.0), intSmooth)

// 0-100 scores, all oriented so that HIGH = risk-on / bullish flow
pcrScore   = 100.0 - f_norm(nz(pcr, 1.0),  normLen)   // low put/call  = bullish
vixScore   = 100.0 - f_norm(nz(vix, 20.0), normLen)   // low vol       = bullish
mcScore    = f_norm(mcOsc, normLen)                   // strong breadth= bullish

// ═════════════════════════════════════════════════════════════════════════════
//  WHALE FLOW  (gold)  —  size-filtered volume + internals
// ═════════════════════════════════════════════════════════════════════════════
vol        = nz(volume)
rng        = high - low
body       = rng > 0 ? (close - open) / rng : 0.0
volBase    = ta.sma(vol, whaleVL)
isWhale    = vol > volBase * whaleMlt
whaleRaw   = ta.ema(isWhale ? vol * body : 0.0, whaleLen)
whaleScore = f_norm(whaleRaw, normLen)

float acc  = whaleScore * wWhale     // explicit float => series qualifier, so the
float wSum = wWhale                  // conditional re-weighting below is legal
if not na(pcr) and wPcr > 0
    acc  := acc + pcrScore * wPcr
    wSum := wSum + wPcr
if not na(vix) and wVix > 0
    acc  := acc + vixScore * wVix
    wSum := wSum + wVix
if netAdv != 0 and wMc > 0
    acc  := acc + mcScore * wMc
    wSum := wSum + wMc

whaleLine  = ta.ema(wSum > 0 ? acc / wSum : 50.0, math.max(1, int(whaleLen / 3)))

// ═════════════════════════════════════════════════════════════════════════════
//  REACTIVE FLOW  (white)  —  fast money
// ═════════════════════════════════════════════════════════════════════════════
mfi        = ta.mfi(hlc3, reactLen)
rsi        = ta.rsi(srcCore, rsiLen)
reactLine  = ta.ema(math.avg(mfi, rsi), reactSm)

whaleCtrl  = whaleLine > reactLine

pWhale = plot(whaleLine, "Whale flow (gold)",    color = goldCol,  linewidth = 2)
pReact = plot(reactLine, "Reactive flow (white)", color = whiteCol, linewidth = 2)
fill(pWhale, pReact, color = color.new(whaleCtrl ? goldCol : whiteCol, fillT), title = "Flow delta")

plot(50, "Mid", color = color.new(color.gray, 60))
plot(80, "Upper", color = color.new(color.gray, 82))
plot(20, "Lower", color = color.new(color.gray, 82))
plot(showDlt ? whaleLine - reactLine : na, "Delta", color = color.new(whaleCtrl ? goldCol : whiteCol, 40),
     style = plot.style_columns)

// ═════════════════════════════════════════════════════════════════════════════
//  STAR ENGINE  (identical block in every script of this system)
// ═════════════════════════════════════════════════════════════════════════════
[macdLine, sigLine, macdHist] = ta.macd(srcCore, macdFast, macdSlow, macdSig)
volSum     = math.sum(vol, vwapLen)
control    = volSum > 0 ? math.sum(hlc3 * vol, vwapLen) / volSum : ta.ema(hlc3, vwapLen)

priceHH    = close > ta.highest(close, divLook)[1]
priceLL    = close < ta.lowest(close,  divLook)[1]
mcLowerHi  = mcOsc < ta.highest(mcOsc, divLook)[1]
mcHigherLo = mcOsc > ta.lowest(mcOsc,  divLook)[1]
mcBearDiv  = priceHH and mcLowerHi
mcBullDiv  = priceLL and mcHigherLo

pcrBull    = na(pcr) ? false : pcr < pcrAvg
vixBull    = na(vix) ? false : vix < vixAvg
mcBullBase = mcOsc > 0
haveInt    = not na(pcr) or not na(vix) or netAdv != 0
bullVotes  = (pcrBull ? 1 : 0) + (vixBull ? 1 : 0) + (mcBullBase or mcBullDiv ? 1 : 0)
bearVotes  = (not pcrBull and not na(pcr) ? 1 : 0) + (not vixBull and not na(vix) ? 1 : 0) +
             (not mcBullBase or mcBearDiv ? 1 : 0)
intBull    = not useInt or not haveInt or bullVotes >= intVotes
intBear    = not useInt or not haveInt or bearVotes >= intVotes

bullRaw    = ta.crossover(rsi, rsiUpLvl)  and macdLine > sigLine and close > control and intBull
bearRaw    = ta.crossunder(rsi, rsiDnLvl) and macdLine < sigLine and close < control and intBear

var int lastBull = -99999
var int lastBear = -99999
bullStar   = bullRaw and (bar_index - lastBull) >= cooldown
bearStar   = bearRaw and (bar_index - lastBear) >= cooldown
if bullStar
    lastBull := bar_index
if bearStar
    lastBear := bar_index

plotchar(showStar and bullStar ? math.max(2.0,  math.min(whaleLine, reactLine) - 6) : na,
     "Blue ★",   "★", location.absolute, bullCol, size = size.small)
plotchar(showStar and bearStar ? math.min(98.0, math.max(whaleLine, reactLine) + 6) : na,
     "Purple ★", "★", location.absolute, bearCol, size = size.small)

// ═════════════════════════════════════════════════════════════════════════════
//  ALERTS
// ═════════════════════════════════════════════════════════════════════════════
alertcondition(ta.crossover(whaleLine, reactLine),  "Whales take control",
     "Silver Flow: gold crossed above white on {{ticker}}")
alertcondition(ta.crossunder(whaleLine, reactLine), "Reactive flow takes over",
     "Silver Flow: white crossed above gold on {{ticker}}")
alertcondition(bullStar, "Blue ★ (bullish shift)",   "Silver Flow: BLUE star on {{ticker}} @ {{close}}")
alertcondition(bearStar, "Purple ★ (bearish shift)", "Silver Flow: PURPLE star on {{ticker}} @ {{close}}")
