// ═══════════════════════════════════════════════════════════════════════════════
//  ── PANE ───────────────────────────────────────────────────────────────────
//  Sub-pane indicator. If it lands on the price pane, remove it, open a NEW
//  Pine Editor tab, paste, then Add to chart.
// ═══════════════════════════════════════════════════════════════════════════════
//  SILVER FLOW
//  A "who's in control" oscillator. Two bands, plotted as a share of control
//  from 0 to 100, with the space between them shaded.
//    Gold line  = the banker band, slow and heavy
//    White line = hot money, fast and reactive
//
//  Gold rising and above 50 is stable control and cleaner trend conditions.
//  White surging while gold is weak means violent swings and higher failure
//  risk. Crossings are regime hints, NOT entries — its author is explicit
//  about that, and it is the most misused thing in the suite.
//
//  Construction: MCDX bands. Each is an RSI on its own period, offset by a base
//  level, scaled by a sensitivity, clamped into a 0-20 band, then read as a
//  percentage of that ceiling — which is why a reading of 17.8 shows as 89%.
//
//  A caution worth keeping in mind: this cannot see institutional order flow.
//  Nothing available to a chart script can. It is a smoothed money-flow proxy
//  computed from price, and "banker" is a label on an oscillator, not a fact
//  about who is buying.
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("Silver Flow", overlay = false, max_bars_back = 5000)

// ── Construction ─────────────────────────────────────────────────────────────
gEng     = "Engine"
mode     = input.string("MCDX bands", "Construction",
     options = ["MCDX bands", "Volume flow"], group = gEng,
     tooltip = "MCDX bands is the documented construction and reproduces the percentage readouts. Volume flow is the earlier size-filtered volume model, kept for comparison.")
src      = input.source(close, "Source", group = gEng)

// ── Banker band (gold) ───────────────────────────────────────────────────────
gBank    = "Banker band — gold"
bankLen  = input.int(21,  "RSI period",  minval = 1, group = gBank, inline = "b")
bankBase = input.float(50, "base",       minval = 0, group = gBank, inline = "b")
bankSens = input.float(1.5, "sensitivity", minval = 0.1, step = 0.1, group = gBank, inline = "b")
bankSm   = input.int(3, "Smoothing", minval = 1, group = gBank)

// ── Hot money band (white) ───────────────────────────────────────────────────
gHot     = "Hot money band — white"
hotLen   = input.int(40,  "RSI period",  minval = 1, group = gHot, inline = "h")
hotBase  = input.float(30, "base",       minval = 0, group = gHot, inline = "h")
hotSens  = input.float(0.7, "sensitivity", minval = 0.1, step = 0.1, group = gHot, inline = "h")
hotSm    = input.int(2, "Smoothing", minval = 1, group = gHot)
capVal   = input.float(20, "Band ceiling", minval = 1, group = gHot,
     tooltip = "Both bands clamp here, and the plotted percentage is the band as a share of it. 20 is the MCDX value.")

// ── Volume-flow mode ─────────────────────────────────────────────────────────
gFlow    = "Volume-flow mode"
whaleLen = input.int(21, "Whale flow smoothing",  minval = 1, group = gFlow)
whaleVL  = input.int(50, "Whale volume baseline", minval = 1, group = gFlow)
whaleMlt = input.float(1.5, "Whale volume ×", minval = 1.0, step = 0.1, group = gFlow)
reactLen = input.int(14, "Reactive flow length",  minval = 1, group = gFlow)
reactSm  = input.int(3,  "Reactive smoothing",    minval = 1, group = gFlow)
normLen  = input.int(200, "Normalisation lookback", minval = 20, group = gFlow)

// ── Style ────────────────────────────────────────────────────────────────────
gSty     = "Style"
goldCol  = input.color(#C9A227, "Whale (gold)",     group = gSty, inline = "c")
whiteCol = input.color(#FFFFFF, "Reactive (white)", group = gSty, inline = "c")
zoneGold = input.color(#C9A227, "Zone — whales in control", group = gSty, inline = "z1")
zoneGT   = input.int(62, "T", minval = 0, maxval = 100, group = gSty, inline = "z1")
zoneDark = input.color(#161A20, "Zone — hot money in control", group = gSty, inline = "z2")
zoneDT   = input.int(45, "T", minval = 0, maxval = 100, group = gSty, inline = "z2")
toneStep = input.int(12, "Fade when control is slipping", minval = 0, maxval = 40, group = gSty)
showLvls = input.bool(false, "Show 50 level", group = gSty)
showRead = input.bool(true, "Show the percentage readout", group = gSty,
     tooltip = "The two current band values, as percentages, in the corner of the pane.")

// ── Stars ────────────────────────────────────────────────────────────────────
gStar    = "Stars"
showStar = input.bool(true, "Show stars", group = gStar)
starSz   = input.string("Tiny", "Star size", options = ["Auto", "Tiny", "Small", "Normal"], group = gStar,
     tooltip = "Tiny is the smallest fixed size Pine offers and is the default. Auto is the only thing smaller — it scales the star to the bar width, so it shrinks when you zoom out. If stars still look oversized after updating this script, the chart is holding your old saved value: open Settings, then Defaults, then Reset settings.")
bullCol  = input.color(#00E5FF, "Bull ★", group = gStar, inline = "sc")
bearCol  = input.color(#FF00E0, "Bear ★", group = gStar, inline = "sc")

// ── Helpers ──────────────────────────────────────────────────────────────────
f_norm(_src, _len) =>
    hi  = ta.highest(_src, _len)
    lo  = ta.lowest(_src, _len)
    rng = hi - lo
    na(rng) or rng <= 0 ? 50.0 : (_src - lo) / rng * 100.0

//  an MCDX tier: RSI, offset by its base, scaled, clamped, read as a percentage
f_band(_src, _len, _base, _sens, _cap, _sm) =>
    raw = _sens * (ta.rsi(_src, _len) - _base)
    clamped = math.min(math.max(raw, 0.0), _cap)
    ta.sma(clamped / _cap * 100.0, _sm)

// ═════════════════════════════════════════════════════════════════════════════
//  MCDX BANDS
// ═════════════════════════════════════════════════════════════════════════════
bankerPct = f_band(src, bankLen, bankBase, bankSens, capVal, bankSm)
hotPct    = f_band(src, hotLen,  hotBase,  hotSens,  capVal, hotSm)

// ═════════════════════════════════════════════════════════════════════════════
//  VOLUME FLOW — the earlier model
// ═════════════════════════════════════════════════════════════════════════════
vol       = nz(volume)
barRng    = high - low
bodyRatio = barRng > 0 ? (close - open) / barRng : 0.0
volBase   = ta.sma(vol, whaleVL)
isWhale   = vol > volBase * whaleMlt
whaleRaw  = ta.ema(isWhale ? vol * bodyRatio : 0.0, whaleLen)
whalePct  = ta.ema(f_norm(whaleRaw, normLen), math.max(1, int(whaleLen / 3)))
mfi       = ta.mfi(hlc3, reactLen)
reactPct  = ta.ema(mfi, reactSm)

// ═════════════════════════════════════════════════════════════════════════════
useMcdx   = mode == "MCDX bands"
whaleLine = useMcdx ? bankerPct : whalePct
reactLine = useMcdx ? hotPct    : reactPct

whaleCtrl = whaleLine > reactLine
gaining   = whaleLine > whaleLine[1]
slipping  = whaleCtrl != gaining
fade      = slipping ? toneStep : 0
zoneCol   = whaleCtrl ? color.new(zoneGold, math.min(99, zoneGT + fade)) : color.new(zoneDark, math.min(99, zoneDT + fade))

pWhale = plot(whaleLine, "Whale flow",    color = goldCol,  linewidth = 2)
pReact = plot(reactLine, "Reactive flow", color = whiteCol, linewidth = 2)
fill(pWhale, pReact, color = zoneCol, title = "Control zone")
plot(showLvls ? 50 : na, "50", color = color.new(color.gray, 60))

// ── Readout ──────────────────────────────────────────────────────────────────
var table read = table.new(position.top_right, 1, 2, frame_width = 0)
if showRead and barstate.islast
    //  math.round rather than the "#" format: "#" drops a digit that rounds to
    //  zero, so a band resting near 0 printed a bare "%" with no number. This
    //  also matches how MCDX TD formats the same kind of readout.
    table.cell(read, 0, 0, str.tostring(math.round(nz(whaleLine))) + "%", text_color = goldCol,
         text_size = size.small, bgcolor = color.new(#0B0D11, 20))
    table.cell(read, 0, 1, str.tostring(math.round(nz(reactLine))) + "%", text_color = whiteCol,
         text_size = size.small, bgcolor = color.new(#0B0D11, 20))

// ── Stars: the bar control changes hands ─────────────────────────────────────
bullStar = ta.crossover(whaleLine,  reactLine)
bearStar = ta.crossunder(whaleLine, reactLine)
starY    = math.avg(whaleLine, reactLine)
szA      = starSz == "Auto"
szT      = starSz == "Tiny"
szS      = starSz == "Small"
szN      = starSz == "Normal"

plotchar(showStar and szA and bullStar ? starY : na, "Bull ★ (auto)",   "★", location.absolute, bullCol, size = size.auto,   display = display.pane)
plotchar(showStar and szT and bullStar ? starY : na, "Bull ★ (tiny)",   "★", location.absolute, bullCol, size = size.tiny,   display = display.pane)
plotchar(showStar and szS and bullStar ? starY : na, "Bull ★ (small)",  "★", location.absolute, bullCol, size = size.small,  display = display.pane)
plotchar(showStar and szN and bullStar ? starY : na, "Bull ★ (normal)", "★", location.absolute, bullCol, size = size.normal, display = display.pane)
plotchar(showStar and szA and bearStar ? starY : na, "Bear ★ (auto)",   "★", location.absolute, bearCol, size = size.auto,   display = display.pane)
plotchar(showStar and szT and bearStar ? starY : na, "Bear ★ (tiny)",   "★", location.absolute, bearCol, size = size.tiny,   display = display.pane)
plotchar(showStar and szS and bearStar ? starY : na, "Bear ★ (small)",  "★", location.absolute, bearCol, size = size.small,  display = display.pane)
plotchar(showStar and szN and bearStar ? starY : na, "Bear ★ (normal)", "★", location.absolute, bearCol, size = size.normal, display = display.pane)

// ── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(bullStar, "Whales take control",  "Silver Flow: gold crossed above white on {{ticker}} — a regime hint, not an entry")
alertcondition(bearStar, "Hot money takes over", "Silver Flow: white crossed above gold on {{ticker}} — a regime hint, not an entry")
alertcondition(ta.crossover(whaleLine, 50),  "Whale control above 50", "Silver Flow: whale control crossed above 50 on {{ticker}}")
alertcondition(ta.crossunder(whaleLine, 50), "Whale control below 50", "Silver Flow: whale control crossed below 50 on {{ticker}}")
