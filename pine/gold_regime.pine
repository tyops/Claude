// ═══════════════════════════════════════════════════════════════════════════════
//  Trade Daddy — GOLD REGIME
//  Regime filter + trigger system. Momentum shift blended with trend confirmation
//  defines the bullish / bearish state; candles are recoloured to match.
//  Triggers only fire when short-term pressure and broader direction agree.
//    ★ cyan    = bull trigger
//    ★ magenta = bear trigger
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("Gold Regime", overlay = true)

// ── Engine ───────────────────────────────────────────────────────────────────
gEng     = "Engine"
src      = input.source(close, "Source",                      group = gEng)
fastLen  = input.int(12, "MACD fast",   minval = 1,           group = gEng, inline = "m")
slowLen  = input.int(26, "slow",        minval = 1,           group = gEng, inline = "m")
sigLen   = input.int(9,  "signal",      minval = 1,           group = gEng, inline = "m")
trendLen = input.int(50, "Regime trend length", minval = 1,   group = gEng)
confLen  = input.int(10, "Trigger confirmation length", minval = 1, group = gEng,
     tooltip = "Short baseline price must close beyond for a trigger to count. This is what lets a bear star print at a high, while the slower trend length still drives candle colour.")
maType   = input.string("EMA", "Baseline type", options = ["EMA", "SMA", "WMA", "HMA", "ALMA"], group = gEng)
atrLen   = input.int(14, "ATR length (star offset)", minval = 1, group = gEng)

// ── Higher-timeframe sync ────────────────────────────────────────────────────
gHtf     = "Higher-timeframe sync"
useHtf   = input.bool(false, "Trigger must agree with a higher timeframe", group = gHtf,
     tooltip = "Short-term pressure has to line up with the trend one step up before a bias flip counts: bull triggers only while the higher timeframe is above its trend baseline, bear triggers only while it is below.")
htfAuto  = input.bool(true, "Pick the timeframe automatically", group = gHtf,
     tooltip = "Intraday steps up to daily, daily to weekly, weekly to monthly, monthly to yearly.")
htfCust  = input.timeframe("W", "Custom timeframe", group = gHtf)

// ── Sensitivity ──────────────────────────────────────────────────────────────
gSens    = "Sensitivity"
sens     = input.int(5, "Signal sensitivity", minval = 1, maxval = 10, group = gSens,
     tooltip = "One dial over the three gates below: how far price must push past the baseline, how long the cooldown runs, and how close to a swing extreme a trigger has to sit. 5 leaves them exactly as set. Below 5 tightens all three for fewer, cleaner stars; above 5 loosens them for more. The individual inputs stay the baseline this scales.")

// ── Filters ──────────────────────────────────────────────────────────────────
gFlt     = "Trigger filters"
useRsi   = input.bool(false, "Require RSI side",             group = gFlt, inline = "r")
rsiLen   = input.int(14, "len", minval = 1,                  group = gFlt, inline = "r")
rsiMid   = input.int(50, "mid", minval = 1, maxval = 99,     group = gFlt, inline = "r")
useVol   = input.bool(false, "Require volume participation", group = gFlt, inline = "v")
volLen   = input.int(20, "len", minval = 1,                  group = gFlt, inline = "v")
volMult  = input.float(1.0, "×", minval = 0.1, step = 0.1,   group = gFlt, inline = "v")
needReg  = input.bool(false, "Trigger must agree with regime", group = gFlt)
useVwap  = input.bool(false, "Require the VWAP side",        group = gFlt, inline = "vw")
vwapLen  = input.int(50, "len", minval = 1,                  group = gFlt, inline = "vw",
     tooltip = "Bull triggers only above VWAP, bear triggers only below it. Rolling VWAP over this many bars.")

// ── Market internals ─────────────────────────────────────────────────────────
gInt     = "Market internals (PCR / VIX / McClellan)"
useInt   = input.bool(false, "Require internals confirmation", group = gInt,
     tooltip = "Broad-market confluence from the original spec. Off by default because it is market-wide and pulls every symbol toward the same read — turn it on to demand that the tape agrees before a star prints.")
intVotes = input.int(2, "Votes required (of 3)", minval = 1, maxval = 3, group = gInt)
intTf    = input.timeframe("", "Internals timeframe (blank = chart)", group = gInt)
pcrSym   = input.symbol("USI:PCC",     "Put/Call ratio",   group = gInt)
vixSym   = input.symbol("CBOE:VIX",    "Volatility index", group = gInt)
advSym   = input.symbol("USI:ADVN.NY", "Advancing issues", group = gInt)
decSym   = input.symbol("USI:DECL.NY", "Declining issues", group = gInt)
intSm    = input.int(20, "Internals smoothing", minval = 1, group = gInt)
mcFastL  = input.int(19, "McClellan fast EMA", minval = 1, group = gInt, inline = "mc")
mcSlowL  = input.int(39, "slow EMA",           minval = 1, group = gInt, inline = "mc")
divLook  = input.int(20, "McClellan divergence lookback", minval = 5, group = gInt)
useSwing = input.bool(true, "Only fire at swing turns", group = gFlt,
     tooltip = "A bear trigger has to come just after a swing high, a bull trigger just after a swing low. This is what keeps stars on the turns that matter instead of on every momentum flip. The single biggest control over how many you get.")
swingLen = input.int(20, "Swing lookback", minval = 2, group = gFlt, inline = "sw")
swingAge = input.int(5,  "bars since the extreme", minval = 0, group = gFlt, inline = "sw",
     tooltip = "How recent the swing high or low has to be. Larger accepts later flips and prints more stars.")
cooldown = input.int(8, "Cooldown bars between same-side triggers", minval = 0, group = gFlt,
     tooltip = "Kills the clusters where the same signal repeats within a couple of bars. Lower it for more triggers, raise it for fewer.")
minPush  = input.float(0.25, "Min push past the baseline (ATR)", minval = 0, step = 0.05, group = gFlt,
     tooltip = "Price has to clear the confirmation baseline by this much for the flip to count, so a cross that only grazes it is ignored. The other dial for trigger frequency.")

// ── Regime confirmation ──────────────────────────────────────────────────────
gSeq     = "Regime confirmation"
useSeq   = input.bool(true, "Require sequential confirmation", group = gSeq,
     tooltip = "Either leg may fire first, but the other has to confirm within the window below for the regime to flip. Off means both legs simply have to be true at the same time, however long apart they turned.")
seqWin   = input.int(4, "Confirmation window (bars)", minval = 1, maxval = 30, group = gSeq,
     tooltip = "How long the first leg waits for the second. Short enough to mean something, long enough to catch a lagging trend leg.")
paintNone= input.bool(false, "Paint candles before the first confirmation", group = gSeq,
     tooltip = "Until momentum and trend have agreed once, the regime is None rather than a guess. Off leaves those candles in the chart's own colours.")

// ── Streak counter ───────────────────────────────────────────────────────────
gStrk    = "Streak counter"
showStrk = input.bool(false, "Show the streak table", group = gStrk,
     tooltip = "Off by default because BB Trend Avg owns this table on the reference charts — that is where Trend, Real length, Probable and the two averages come from. Turn it on if you would rather read the streak off the regime engine than off the Bollinger one.")
strkPos  = input.string(position.bottom_right, "Position",
     options = [position.bottom_right, position.bottom_left, position.top_right,
     position.top_left, position.middle_right], group = gStrk)
strkSize = input.string(size.small, "Text size", options = [size.tiny, size.small, size.normal], group = gStrk)

// ── Style ────────────────────────────────────────────────────────────────────
gSty     = "Style"
paintBar = input.bool(true,  "Recolour candles",             group = gSty)
solidBod = input.bool(true,  "Solid bodies",                 group = gSty,
     tooltip = "Paints body, border and wick in the regime colour, so every candle reads gold or gray whatever the chart's own candle styling is. Turn it off to fall back to barcolor only.")
goldCol  = input.color(#C9A227, "Gold regime", group = gSty, inline = "rc")
grayCol  = input.color(#9AA0A6, "Gray regime", group = gSty, inline = "rc")
noneCol  = input.color(#4A5058, "No regime yet", group = gSty)
showStar = input.bool(true, "Show stars",                    group = gSty)
starSz   = input.string("Tiny", "Star size", options = ["Auto", "Tiny", "Small", "Normal"], group = gSty,
     tooltip = "Tiny is the smallest fixed size Pine offers and is the default. Auto is the only thing smaller — it scales the star to the bar width, so it shrinks when you zoom out. If stars still look oversized after updating this script, the chart is holding your old saved value: open Settings, then Defaults, then Reset settings.")
starOff  = input.float(1.5, "Star offset (ATR)", minval = 0, step = 0.1, group = gSty)
bullCol  = input.color(#00E5FF, "Bull ★", group = gSty, inline = "sc")
bearCol  = input.color(#FF00E0, "Bear ★", group = gSty, inline = "sc")
showTri  = input.bool(false, "Triangle markers instead of stars", group = gSty)

// ── Helper ───────────────────────────────────────────────────────────────────
//  all five run every bar and the type picks between the finished values, so no
//  moving average is ever calculated inside a conditional branch
f_ma(_src, _len, _type) =>
    s = ta.sma(_src, _len)
    e = ta.ema(_src, _len)
    w = ta.wma(_src, _len)
    h = ta.hma(_src, _len)
    a = ta.alma(_src, _len, 0.85, 6)
    _type == "SMA" ? s : _type == "WMA" ? w : _type == "HMA" ? h : _type == "ALMA" ? a : e

f_req(_sym, _tf) =>
    request.security(_sym, _tf == "" ? timeframe.period : _tf, close, ignore_invalid_symbol = true)

// ═════════════════════════════════════════════════════════════════════════════
//  REGIME
// ═════════════════════════════════════════════════════════════════════════════
[macdLine, sigLine, macdHist] = ta.macd(src, fastLen, slowLen, sigLen)
trendMa   = f_ma(src, trendLen, maType)
confMa    = f_ma(src, confLen,  maType)
atr       = ta.atr(atrLen)

momBull   = macdLine > sigLine
momBear   = macdLine < sigLine
trendBull = close > trendMa
trendBear = close < trendMa

//  Sequential confirmation. Either leg may fire first; the other has to confirm
//  within the window for the regime to flip. Once set, the state persists until
//  the opposite pair confirms — which is what produces long unbroken runs.
var int momUpBar = -99999
var int momDnBar = -99999
var int trUpBar  = -99999
var int trDnBar  = -99999
if momBull and not momBull[1]
    momUpBar := bar_index
if momBear and not momBear[1]
    momDnBar := bar_index
if trendBull and not trendBull[1]
    trUpBar := bar_index
if trendBear and not trendBear[1]
    trDnBar := bar_index

bullSeq   = momBull and trendBull and (not useSeq or math.abs(momUpBar - trUpBar) <= seqWin)
bearSeq   = momBear and trendBear and (not useSeq or math.abs(momDnBar - trDnBar) <= seqWin)

//  three states: 1 bull, -1 bear, 0 none. None means nothing has confirmed yet
//  rather than a default guess at the direction.
var int reg = 0
reg      := bullSeq ? 1 : bearSeq ? -1 : reg
gold      = reg == 1
regCol    = reg == 1 ? goldCol : reg == -1 ? grayCol : noneCol
painted   = reg != 0 or paintNone

barcolor(paintBar and painted ? regCol : na, title = "Regime candles")
plotcandle(solidBod and painted ? open : na, solidBod and painted ? high : na,
     solidBod and painted ? low : na, solidBod and painted ? close : na,
     "Solid bodies", color = regCol, wickcolor = regCol, bordercolor = regCol)

// ═════════════════════════════════════════════════════════════════════════════
//  STREAK COUNTER — how long this regime has run, against how long they usually do
// ═════════════════════════════════════════════════════════════════════════════
var int   curLen  = 0
var float bullSum = 0.0
var int   bullN   = 0
var float bearSum = 0.0
var int   bearN   = 0

flipped   = reg != nz(reg[1], reg)
if flipped
    //  bank the streak that just ended
    if reg[1] == 1
        bullSum := bullSum + curLen
        bullN   := bullN + 1
    else if reg[1] == -1
        bearSum := bearSum + curLen
        bearN   := bearN + 1
    curLen := 0
else
    curLen := reg == 0 ? 0 : curLen + 1

bullAvg   = bullN > 0 ? bullSum / bullN : na
bearAvg   = bearN > 0 ? bearSum / bearN : na
probable  = reg == 1 ? bullAvg : reg == -1 ? bearAvg : na

f_num(_v) =>
    na(_v) ? "n/a" : str.tostring(math.round(_v))

var table streak = table.new(strkPos, 2, 5, border_width = 1,
     border_color = color.new(#0B0D11, 0), frame_color = color.new(#0B0D11, 0), frame_width = 1)
if showStrk and barstate.islast
    lblCol = color.new(#9AA0A6, 0)
    bg     = color.new(#1B1F26, 0)
    table.cell(streak, 0, 0, "Trend",       text_color = lblCol, text_size = strkSize, bgcolor = bg)
    table.cell(streak, 1, 0, reg == 1 ? "BULL" : reg == -1 ? "BEAR" : "None",
         text_color = reg == 0 ? lblCol : color.new(#101216, 0), text_size = strkSize,
         bgcolor = reg == 0 ? bg : color.new(regCol, 10))
    table.cell(streak, 0, 1, "Real length", text_color = lblCol, text_size = strkSize, bgcolor = bg)
    table.cell(streak, 1, 1, str.tostring(curLen), text_color = lblCol, text_size = strkSize, bgcolor = bg)
    table.cell(streak, 0, 2, "Bull avg",    text_color = lblCol, text_size = strkSize, bgcolor = bg)
    table.cell(streak, 1, 2, f_num(bullAvg), text_color = lblCol, text_size = strkSize, bgcolor = bg)
    table.cell(streak, 0, 3, "Bear avg",    text_color = lblCol, text_size = strkSize, bgcolor = bg)
    table.cell(streak, 1, 3, f_num(bearAvg), text_color = lblCol, text_size = strkSize, bgcolor = bg)
    table.cell(streak, 0, 4, "Probable",    text_color = lblCol, text_size = strkSize, bgcolor = bg)
    table.cell(streak, 1, 4, f_num(probable), text_color = lblCol, text_size = strkSize, bgcolor = bg)

// ═════════════════════════════════════════════════════════════════════════════
//  TRIGGERS
// ═════════════════════════════════════════════════════════════════════════════
rsi       = ta.rsi(src, rsiLen)
volAvg    = ta.sma(nz(volume), volLen)
volOk     = not useVol or nz(volume) > volAvg * volMult
rsiBullOk = not useRsi or rsi > rsiMid
rsiBearOk = not useRsi or rsi < rsiMid

// momentum flip + price confirms against the short baseline
// ── VWAP side ────────────────────────────────────────────────────────────────
vol_      = nz(volume)
volSum    = math.sum(vol_, vwapLen)
//  both the fallback average and the rolling sum are computed every bar. Left
//  inside the ternary the sum would skip zero-volume bars, and its window would
//  come back stale once volume returned.
vwapFall  = ta.ema(hlc3, vwapLen)
pvSum     = math.sum(hlc3 * vol_, vwapLen)
vwap      = volSum > 0 ? pvSum / volSum : vwapFall
vwapBull  = not useVwap or close > vwap
vwapBear  = not useVwap or close < vwap

// ── Market internals: PCR, VIX, McClellan level and divergence ───────────────
pcr       = f_req(pcrSym, intTf)
vix       = f_req(vixSym, intTf)
advn      = f_req(advSym, intTf)
decl      = f_req(decSym, intTf)
netAdv    = nz(advn) - nz(decl)
mcOsc     = ta.ema(netAdv, mcFastL) - ta.ema(netAdv, mcSlowL)
pcrAvg    = ta.ema(nz(pcr, 1.0),  intSm)
vixAvg    = ta.ema(nz(vix, 20.0), intSm)
pcrBull   = na(pcr) ? false : pcr < pcrAvg          // put/call easing = calls in control
vixBull   = na(vix) ? false : vix < vixAvg          // volatility easing = risk-on
priceHH   = close > ta.highest(close, divLook)[1]
priceLL   = close < ta.lowest(close,  divLook)[1]
mcLowerHi = mcOsc < ta.highest(mcOsc, divLook)[1]
mcHigherLo= mcOsc > ta.lowest(mcOsc,  divLook)[1]
mcBearDiv = priceHH and mcLowerHi                   // price up, breadth not following
mcBullDiv = priceLL and mcHigherLo                  // price down, breadth improving
mcBull    = mcOsc > 0 or mcBullDiv
haveInt   = not na(pcr) or not na(vix) or netAdv != 0
bullVotes = (pcrBull ? 1 : 0) + (vixBull ? 1 : 0) + (mcBull ? 1 : 0)
bearVotes = (not pcrBull and not na(pcr) ? 1 : 0) + (not vixBull and not na(vix) ? 1 : 0) + (not mcBull or mcBearDiv ? 1 : 0)
intBull   = not useInt or not haveInt or bullVotes >= intVotes
intBear   = not useInt or not haveInt or bearVotes >= intVotes

// ── Higher-timeframe trend ───────────────────────────────────────────────────
//  one step up from the chart, unless a timeframe is named
htfStep   = timeframe.isintraday ? "D" : timeframe.isdaily ? "W" : timeframe.isweekly ? "M" : "12M"
htfTf     = htfAuto ? htfStep : htfCust
htfUp     = request.security(syminfo.tickerid, htfTf, close > ta.ema(close, trendLen),
     lookahead = barmerge.lookahead_off)
htfBull   = not useHtf or htfUp
htfBear   = not useHtf or not htfUp

//  sensitivity scales the three gates together; 5 leaves them as set
k         = 5.0 / sens
effPush   = minPush  * k
effCool   = cooldown * k
effAge    = swingAge / k

//  how many bars back the swing extreme of the window sits
hiAge     = math.abs(ta.highestbars(high, swingLen))
loAge     = math.abs(ta.lowestbars(low,  swingLen))
atHigh    = not useSwing or hiAge <= effAge
atLow     = not useSwing or loAge <= effAge
push      = atr * effPush
bullRaw   = ta.crossover(macdLine, sigLine)  and close > confMa + push and atLow  and rsiBullOk and volOk and vwapBull and intBull and htfBull and (not needReg or gold)
bearRaw   = ta.crossunder(macdLine, sigLine) and close < confMa - push and atHigh and rsiBearOk and volOk and vwapBear and intBear and htfBear and (not needReg or not gold)

var int lastBull = -99999
var int lastBear = -99999
bullTrig  = bullRaw and (bar_index - lastBull) >= effCool
bearTrig  = bearRaw and (bar_index - lastBear) >= effCool
if bullTrig
    lastBull := bar_index
if bearTrig
    lastBear := bar_index

bullY     = low  - atr * starOff
bearY     = high + atr * starOff
szA       = starSz == "Auto"
szT       = starSz == "Tiny"
szS       = starSz == "Small"
szN       = starSz == "Normal"
starOn    = showStar and not showTri

plotchar(starOn and szA and bullTrig ? bullY : na, "Bull ★ (auto)",   "★", location.absolute, bullCol, size = size.auto,   display = display.pane)
plotchar(starOn and szT and bullTrig ? bullY : na, "Bull ★ (tiny)",   "★", location.absolute, bullCol, size = size.tiny,   display = display.pane)
plotchar(starOn and szS and bullTrig ? bullY : na, "Bull ★ (small)",  "★", location.absolute, bullCol, size = size.small,  display = display.pane)
plotchar(starOn and szN and bullTrig ? bullY : na, "Bull ★ (normal)", "★", location.absolute, bullCol, size = size.normal, display = display.pane)
plotchar(starOn and szA and bearTrig ? bearY : na, "Bear ★ (auto)",   "★", location.absolute, bearCol, size = size.auto,   display = display.pane)
plotchar(starOn and szT and bearTrig ? bearY : na, "Bear ★ (tiny)",   "★", location.absolute, bearCol, size = size.tiny,   display = display.pane)
plotchar(starOn and szS and bearTrig ? bearY : na, "Bear ★ (small)",  "★", location.absolute, bearCol, size = size.small,  display = display.pane)
plotchar(starOn and szN and bearTrig ? bearY : na, "Bear ★ (normal)", "★", location.absolute, bearCol, size = size.normal, display = display.pane)

plotshape(showStar and showTri and bullTrig, "Bull ▲", shape.triangleup,   location.belowbar, bullCol, size = size.tiny, display = display.pane)
plotshape(showStar and showTri and bearTrig, "Bear ▼", shape.triangledown, location.abovebar, bearCol, size = size.tiny, display = display.pane)

// ── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(bullTrig, "Gold Regime — bull trigger", "Gold Regime: BULL trigger on {{ticker}} @ {{close}}")
alertcondition(bearTrig, "Gold Regime — bear trigger", "Gold Regime: BEAR trigger on {{ticker}} @ {{close}}")
alertcondition(gold and not gold[1],  "Regime → GOLD", "Gold Regime: regime flipped GOLD on {{ticker}}")
alertcondition(not gold and gold[1],  "Regime → GRAY", "Gold Regime: regime flipped GRAY on {{ticker}}")
